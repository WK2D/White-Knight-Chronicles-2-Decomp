--- /dev/null
+++ b/libs/video/rsx_d3d12_surface_readback.h
@@ -0,0 +1,98 @@
+#ifndef RSX_D3D12_SURFACE_READBACK_H
+#define RSX_D3D12_SURFACE_READBACK_H
+#include <d3d12.h>
+#include <stdint.h>
+#include <string.h>
+
+typedef struct rsx_d3d12_surface_readback {
+    ID3D12Resource* buffer;
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint;
+    UINT64 bytes;
+} rsx_d3d12_surface_readback;
+
+/* CELL_GCM_SURFACE_A8R8G8B8 is 8; 5 is an X8 format. Reject swizzle and
+ * narrow/unsupported formats instead of guessing their guest byte layout. */
+static int rsx_d3d12_surface_readback_layout(unsigned format,unsigned raster,
+    unsigned pitch,unsigned width,unsigned height,uint32_t bytes)
+{
+    return format==8u && raster==1u && width && height && bytes &&
+        (uint64_t)pitch>=(uint64_t)width*4u &&
+        (uint64_t)bytes<=(uint64_t)pitch*height;
+}
+
+static void rsx_d3d12_surface_readback_release(rsx_d3d12_surface_readback* readback)
+{
+    if(readback->buffer) readback->buffer->lpVtbl->Release(readback->buffer);
+    memset(readback,0,sizeof(*readback));
+}
+
+/* Record only. Caller submits and waits for GPU completion before store/release.
+ * The resource returns to its original render-target state. */
+static HRESULT rsx_d3d12_surface_readback_record(rsx_d3d12_surface_readback* readback,
+    ID3D12Device* device,ID3D12GraphicsCommandList* list,ID3D12Resource* source)
+{
+    if(readback->buffer) return E_INVALIDARG;
+    D3D12_RESOURCE_DESC desc;source->lpVtbl->GetDesc(source,&desc);
+    if(desc.Dimension!=D3D12_RESOURCE_DIMENSION_TEXTURE2D || desc.Format!=DXGI_FORMAT_R8G8B8A8_UNORM ||
+       desc.MipLevels!=1 || desc.DepthOrArraySize!=1 || desc.SampleDesc.Count!=1) return E_INVALIDARG;
+    device->lpVtbl->GetCopyableFootprints(device,&desc,0,1,0,&readback->footprint,NULL,NULL,&readback->bytes);
+    D3D12_HEAP_PROPERTIES hp={0};hp.Type=D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd={0};bd.Dimension=D3D12_RESOURCE_DIMENSION_BUFFER;bd.Width=readback->bytes;
+    bd.Height=1;bd.DepthOrArraySize=1;bd.MipLevels=1;bd.SampleDesc.Count=1;bd.Layout=D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    HRESULT hr=device->lpVtbl->CreateCommittedResource(device,&hp,D3D12_HEAP_FLAG_NONE,&bd,
+        D3D12_RESOURCE_STATE_COPY_DEST,NULL,&IID_ID3D12Resource,(void**)&readback->buffer);
+    if(FAILED(hr)) return hr;
+    D3D12_RESOURCE_BARRIER b={0};b.Type=D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource=source;b.Transition.Subresource=D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore=D3D12_RESOURCE_STATE_RENDER_TARGET;b.Transition.StateAfter=D3D12_RESOURCE_STATE_COPY_SOURCE;
+    list->lpVtbl->ResourceBarrier(list,1,&b);
+    D3D12_TEXTURE_COPY_LOCATION src={0},dst={0};src.pResource=source;src.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.pResource=readback->buffer;dst.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;dst.PlacedFootprint=readback->footprint;
+    list->lpVtbl->CopyTextureRegion(list,&dst,0,0,0,&src,NULL);
+    b.Transition.StateBefore=D3D12_RESOURCE_STATE_COPY_SOURCE;b.Transition.StateAfter=D3D12_RESOURCE_STATE_RENDER_TARGET;
+    list->lpVtbl->ResourceBarrier(list,1,&b);
+    return S_OK;
+}
+
+/* Copy just the requested guest bytes, leaving pitch padding/other bytes alone.
+ * Source is GPU RGBA8; default guest memory is A,R,G,B. Partial pixels and
+ * partial final rows are intentional. All validation happens before writes. */
+static int rsx_rgba8_guest_range(uint8_t* destination,uint32_t bytes,
+    const uint8_t* rgba,uint64_t source_bytes,uint32_t source_pitch,
+    uint32_t width,uint32_t height,uint32_t guest_pitch,int guest_rgba)
+{
+    if(!destination || !rgba || !width || !height || !bytes ||
+       (uint64_t)width*4>guest_pitch || (uint64_t)width*4>source_pitch ||
+       (uint64_t)bytes>(uint64_t)guest_pitch*height ||
+       (uint64_t)(height-1)*source_pitch+(uint64_t)width*4>source_bytes) return 0;
+    static const unsigned argb[4]={3,0,1,2};
+    for(uint32_t row=0;row<height;++row){
+        const uint64_t base=(uint64_t)row*guest_pitch;
+        if(base>=bytes) break;
+        const uint64_t remaining=(uint64_t)bytes-base;
+        const uint32_t count=remaining<(uint64_t)width*4 ? (uint32_t)remaining : width*4;
+        const uint8_t* source=rgba+(uint64_t)row*source_pitch;
+        uint8_t* target=destination+base;
+        if(guest_rgba) memcpy(target,source,count);
+        else for(uint32_t i=0;i<count;++i) target[i]=source[(i&~3u)+argb[i&3u]];
+    }
+    return 1;
+}
+
+/* GPU fence must have completed. No copy is reported successful after Map
+ * failure or an unsupported guest layout. No title-ready flag is touched here. */
+static HRESULT rsx_d3d12_surface_readback_store(rsx_d3d12_surface_readback* readback,
+    uint8_t* destination,uint32_t bytes,uint32_t guest_pitch,int guest_rgba)
+{
+    if(!readback->buffer) return E_INVALIDARG;
+    uint8_t* mapped=NULL;D3D12_RANGE range={0,(SIZE_T)readback->bytes};
+    HRESULT hr=readback->buffer->lpVtbl->Map(readback->buffer,0,&range,(void**)&mapped);
+    if(FAILED(hr)) return hr;
+    const D3D12_SUBRESOURCE_FOOTPRINT* fp=&readback->footprint.Footprint;
+    int copied=readback->footprint.Offset<=readback->bytes &&
+        rsx_rgba8_guest_range(destination,bytes,mapped+readback->footprint.Offset,
+            readback->bytes-readback->footprint.Offset,fp->RowPitch,fp->Width,fp->Height,guest_pitch,guest_rgba);
+    D3D12_RANGE no_writes={0,0};readback->buffer->lpVtbl->Unmap(readback->buffer,0,&no_writes);
+    return copied ? S_OK : E_INVALIDARG;
+}
+#endif
