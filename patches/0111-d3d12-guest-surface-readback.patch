+/* Renderer-owner service for a CPU consumer of an exact surface base.
+ * Do not report success from an inactive renderer, unknown/aliased surface,
+ * swizzled/unsupported format or failed GPU copy. Normal frame rendering does
+ * not use this path. The portrait hook blocks its CPU copy until this returns. */
+int rsx_live_draw_guest_buffer_read(u32 location, u32 offset, u32 bytes)
+{
+    if (!g.ready || g_ld_movie_mode || !bytes || (u64)offset + bytes > 0x100000000ull)
+        return 0;
+    surface_t* selected = NULL;
+    for (u32 i=0; i<g.n_surfaces; ++i) {
+        surface_t* surface = &g.surfaces[i];
+        if (surface->location != location || surface->offset != offset || !surface->tex) continue;
+        if (selected) {
+            fprintf(stderr,"[live-readback] ambiguous surface %u:0x%08X\n",location,offset);
+            return 0;
+        }
+        selected = surface;
+    }
+    if (!selected || selected->fmt != DXGI_FORMAT_R8G8B8A8_UNORM ||
+        !rsx_d3d12_surface_readback_layout(selected->guest_color_format,
+            selected->guest_raster_type,selected->guest_pitch,selected->w,selected->h,bytes)) {
+        fprintf(stderr,"[live-readback] unsupported surface %u:0x%08X bytes=%u pitch=%u size=%ux%u format=%u raster=%u\n",
+            location,offset,bytes,selected?selected->guest_pitch:0,
+            selected?selected->w:0,selected?selected->h:0,
+            selected?selected->guest_color_format:0,selected?selected->guest_raster_type:0);
+        return 0;
+    }
+    /* The injected resolver maps writable guest RAM; its const-qualified
+     * return is shared with texture upload consumers. */
+    u8* destination = (u8*)guest_ptr(location,offset,bytes);
+    if (!destination) return 0;
+    rsx_d3d12_surface_readback readback = {0};
+    HRESULT hr = rsx_d3d12_surface_readback_record(&readback,g.dev,g.list,selected->tex);
+    if (SUCCEEDED(hr)) {
+        ld_flush(LD_FLUSH_READBACK);
+        if (g.ready) hr = rsx_d3d12_surface_readback_store(&readback,destination,
+            bytes,selected->guest_pitch,rsx_texture_argb_is_rgba());
+        else hr = E_FAIL;
+    }
+    rsx_d3d12_surface_readback_release(&readback);
+    fprintf(stderr,"[live-readback] %s %u:0x%08X bytes=%u pitch=%u size=%ux%u hr=0x%08lX\n",
+        SUCCEEDED(hr)?"copied":"failed",location,offset,bytes,selected->guest_pitch,
+        selected->w,selected->h,(unsigned long)hr);
+    return SUCCEEDED(hr);
 }
 
