diff --git a/libs/video/rsx_fragment_inputs.h b/libs/video/rsx_fragment_inputs.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_fragment_inputs.h
@@ -0,0 +1,12 @@
+/* Shared NV4097 TC0..7 two-dimensional input request decoding. */
+#ifndef RSX_FRAGMENT_INPUTS_H
+#define RSX_FRAGMENT_INPUTS_H
+#include "rsx_dispatch.h"
+static inline u32 rsx_fragment_tc2d_mask(const rsx_dispatch* state)
+{
+    u32 mask = 0;
+    for (u32 input = 0; input < 8; ++input)
+        mask |= (rsx_dsp_reg(state, 0x0B40u + input * 4u) & 1u) << input;
+    return mask;
+}
+#endif
