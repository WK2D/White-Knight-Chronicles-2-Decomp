 int rsx_hlsl_to_spirv_available(void);
 
+/* Bounded, process-local translation cache. RSX_SPIRV_CACHE=0 disables reuse.
+ * Timings include the synchronous compiler call and cache admission. */
+typedef struct rsx_spirv_cache_statistics {
+    u64 requests, hits, compilations, compile_ns;
+    u64 payload_bytes, entries, evictions, admission_failures;
+} rsx_spirv_cache_statistics;
+void rsx_hlsl_to_spirv_cache_statistics(rsx_spirv_cache_statistics* out);
+
 /* Translate one HLSL shader whose entry point is `main` into SPIR-V 1.0 for a
  * Vulkan 1.0 client.
  *   hlsl      : NUL-terminated HLSL, as the decompilers emit it.
diff --git a/libs/video/rsx_spirv_cache.h b/libs/video/rsx_spirv_cache.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_spirv_cache.h
@@ -0,0 +1,100 @@
+#ifndef RSX_SPIRV_CACHE_H
+#define RSX_SPIRV_CACHE_H
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+
+/* Exact HLSL/stage -> SPIR-V cache. The caller serializes access. Storage is
+ * process-local: no guest source or compiler output is written to disk.
+ * Returned views remain valid until the next insertion or destruction. */
+class RsxSpirvCache {
+public:
+    struct Words {
+        const uint32_t* pointer = nullptr;
+        size_t count = 0;
+        const uint32_t* data() const { return pointer; }
+        size_t size() const { return count; }
+    };
+    using Allocate = void* (*)(size_t);
+    using Release = void (*)(void*);
+    static constexpr size_t capacity = 1024;
+private:
+    struct Entry {
+        void* block = nullptr;
+        Words words;
+        size_t source_size = 0, bytes = 0;
+        uint64_t hash = 0, touched = 0;
+        int stage = 0;
+    } entries_[capacity];
+    size_t budget_, limit_, bytes_ = 0, count_ = 0;
+    uint64_t clock_ = 0, evictions_ = 0;
+    Allocate allocate_;
+    Release release_;
+    uint64_t touch() {
+        if (++clock_ == 0) {
+            // Only recency is lost on wrap; source identity remains exact.
+            for (auto& entry : entries_) entry.touched = 0;
+            clock_ = 1;
+        }
+        return clock_;
+    }
+    void evict_oldest() {
+        Entry* oldest = nullptr;
+        for (auto& entry : entries_)
+            if (entry.block && (!oldest || entry.touched < oldest->touched)) oldest = &entry;
+        if (!oldest) return;
+        bytes_ -= oldest->bytes; --count_; ++evictions_;
+        release_(oldest->block); *oldest = Entry{};
+    }
+public:
+    RsxSpirvCache(size_t budget, size_t limit,
+                  Allocate allocate = std::malloc, Release release = std::free)
+        : budget_(budget), limit_(limit < capacity ? limit : capacity),
+          allocate_(allocate), release_(release) {}
+    RsxSpirvCache(const RsxSpirvCache&) = delete;
+    RsxSpirvCache& operator=(const RsxSpirvCache&) = delete;
+    ~RsxSpirvCache() { for (auto& entry : entries_) if (entry.block) release_(entry.block); }
+    static uint64_t hash(const char* text, size_t size) {
+        uint64_t value = 14695981039346656037ull;
+        for (size_t i = 0; i < size; ++i) { value ^= (unsigned char)text[i]; value *= 1099511628211ull; }
+        return value;
+    }
+    const Words* find(int stage, const char* text, size_t size, uint64_t hash) {
+        for (auto& entry : entries_) {
+            if (!entry.block || entry.stage != stage || entry.hash != hash ||
+                entry.source_size != size || std::memcmp(entry.block, text, size)) continue;
+            entry.touched = touch();
+            return &entry.words;
+        }
+        return nullptr;
+    }
+    bool insert(int stage, const char* text, size_t size, uint64_t hash,
+                const uint32_t* words, size_t count) {
+        if (!limit_ || !text || !words || !count || size >= budget_ ||
+            size > std::numeric_limits<size_t>::max() - 4u) return false;
+        const size_t offset = (size + 4u) & ~size_t(3u);
+        if (offset > budget_ || count > (budget_ - offset) / sizeof(uint32_t)) return false;
+        const size_t cost = offset + count * sizeof(uint32_t);
+        void* block = allocate_(cost);
+        if (!block) return false; // Admission failure must not evict useful data.
+        std::memcpy(block, text, size);
+        static_cast<char*>(block)[size] = '\0';
+        uint32_t* copy = reinterpret_cast<uint32_t*>(static_cast<char*>(block) + offset);
+        std::memcpy(copy, words, count * sizeof(uint32_t));
+        while (bytes_ > budget_ - cost || count_ >= limit_) evict_oldest();
+        for (auto& entry : entries_) if (!entry.block) {
+            entry.block = block; entry.words = {copy, count}; entry.source_size = size;
+            entry.bytes = cost; entry.hash = hash; entry.stage = stage; entry.touched = touch();
+            bytes_ += cost; ++count_; return true;
+        }
+        release_(block); return false;
+    }
+    size_t bytes() const { return bytes_; }
+    size_t count() const { return count_; }
+    uint64_t evictions() const { return evictions_; }
+};
+
+#endif
