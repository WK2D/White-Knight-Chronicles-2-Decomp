diff --git a/runtime/memory/vm_mapping_epoch.h b/runtime/memory/vm_mapping_epoch.h
new file mode 100644
--- /dev/null
+++ b/runtime/memory/vm_mapping_epoch.h
@@ -0,0 +1,30 @@
+/* Shared identity for cached positive guest-mapping permissions. */
+#ifndef PS3RECOMP_VM_MAPPING_EPOCH_H
+#define PS3RECOMP_VM_MAPPING_EPOCH_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* This process-wide epoch is shared by C and C++ translation units. Compare it
+ * together with vm_base before reusing cached positive mapping permissions.
+ * Zero is permanent exhaustion: callers must disable caching in that case.
+ *
+ * An epoch does not pin a mapping. The producer must still keep the mapping and
+ * its permissions stable while a consumer uses it, including during a cache
+ * fill. Hosts that replace/release guest mappings or change their permissions
+ * outside vm_init/vm_shutdown/vm_protect must call invalidate as part of that
+ * same externally serialized operation (before release, after protection).
+ * Mere writes and demand commits of previously inaccessible memory need no
+ * invalidation: this API supports positive permission caches only.
+ */
+uint64_t vm_mapping_epoch_read(void);
+void vm_mapping_epoch_invalidate(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/runtime/memory/vm_mapping_epoch.c b/runtime/memory/vm_mapping_epoch.c
new file mode 100644
--- /dev/null
+++ b/runtime/memory/vm_mapping_epoch.c
@@ -0,0 +1,43 @@
+#include "vm_mapping_epoch.h"
+
+/* Keep the atomic object private so C and C++ consumers share one ABI without
+ * exposing either language's atomic types. Never reuse an epoch after wrap. */
+#if defined(_MSC_VER)
+#include <intrin.h>
+static __declspec(align(8)) volatile __int64 s_vm_mapping_epoch = 1;
+
+uint64_t vm_mapping_epoch_read(void)
+{
+    return (uint64_t)_InterlockedCompareExchange64(&s_vm_mapping_epoch, 0, 0);
+}
+
+void vm_mapping_epoch_invalidate(void)
+{
+    uint64_t current = vm_mapping_epoch_read();
+    while (current != 0) {
+        uint64_t next = current == UINT64_MAX ? 0 : current + 1;
+        uint64_t observed = (uint64_t)_InterlockedCompareExchange64(
+            &s_vm_mapping_epoch, (__int64)next, (__int64)current);
+        if (observed == current) return;
+        current = observed;
+    }
+}
+#else
+#include <stdatomic.h>
+static _Atomic uint64_t s_vm_mapping_epoch = 1;
+
+uint64_t vm_mapping_epoch_read(void)
+{
+    return atomic_load_explicit(&s_vm_mapping_epoch, memory_order_acquire);
+}
+
+void vm_mapping_epoch_invalidate(void)
+{
+    uint64_t current = vm_mapping_epoch_read();
+    while (current != 0) {
+        uint64_t next = current == UINT64_MAX ? 0 : current + 1;
+        if (atomic_compare_exchange_weak_explicit(&s_vm_mapping_epoch, &current,
+                next, memory_order_acq_rel, memory_order_acquire)) return;
+    }
+}
+#endif
