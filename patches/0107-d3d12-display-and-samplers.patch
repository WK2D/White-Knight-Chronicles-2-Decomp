diff --git a/libs/video/rsx_d3d12_sampler.h b/libs/video/rsx_d3d12_sampler.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_d3d12_sampler.h
@@ -0,0 +1,62 @@
+/* RSX sampler decoding for the live D3D12 renderer. */
+#ifndef RSX_D3D12_SAMPLER_H
+#define RSX_D3D12_SAMPLER_H
+#include <d3d12.h>
+#include "rsx_dispatch.h"
+
+static inline D3D12_TEXTURE_ADDRESS_MODE rsx_d3d12_sampler_wrap(u32 wrap)
+{
+    switch (wrap & 15u) {
+    case 1: return D3D12_TEXTURE_ADDRESS_MODE_WRAP;
+    case 2: return D3D12_TEXTURE_ADDRESS_MODE_MIRROR;
+    case 3: case 5: return D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    case 4: return D3D12_TEXTURE_ADDRESS_MODE_BORDER;
+    case 6: case 7: case 8: return D3D12_TEXTURE_ADDRESS_MODE_MIRROR_ONCE;
+    default: return D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    }
+}
+static inline D3D12_SAMPLER_DESC rsx_d3d12_sampler_decode(
+    const rsx_dsp_texture* texture, u32 anisotropy)
+{
+    D3D12_SAMPLER_DESC desc = {0};
+    const u32 min = (texture->filter >> 16) & 7u;
+    const u32 mag = (texture->filter >> 24) & 7u;
+    const int min_linear = min == 2 || min == 4 || min == 6;
+    const int mag_linear = mag == 2;
+    const int mip_present = min >= 3;
+    desc.Filter = D3D12_ENCODE_BASIC_FILTER(
+        min_linear ? D3D12_FILTER_TYPE_LINEAR : D3D12_FILTER_TYPE_POINT,
+        mag_linear ? D3D12_FILTER_TYPE_LINEAR : D3D12_FILTER_TYPE_POINT,
+        min == 5 || min == 6 ? D3D12_FILTER_TYPE_LINEAR : D3D12_FILTER_TYPE_POINT,
+        D3D12_FILTER_REDUCTION_TYPE_STANDARD);
+    desc.AddressU = rsx_d3d12_sampler_wrap(texture->wrap);
+    desc.AddressV = rsx_d3d12_sampler_wrap(texture->wrap >> 8);
+    desc.AddressW = rsx_d3d12_sampler_wrap(texture->wrap >> 16);
+    int bias = (int)(texture->filter & 0x1fffu);
+    if (bias & 0x1000) bias -= 0x2000;
+    desc.MipLODBias = (float)bias / 256.0f;
+    if (desc.MipLODBias > D3D12_MIP_LOD_BIAS_MAX) desc.MipLODBias = D3D12_MIP_LOD_BIAS_MAX;
+    if (desc.MipLODBias < D3D12_MIP_LOD_BIAS_MIN) desc.MipLODBias = D3D12_MIP_LOD_BIAS_MIN;
+    desc.MinLOD = (float)((texture->control0 >> 19) & 0xfffu) / 256.0f;
+    desc.MaxLOD = mip_present ? (float)((texture->control0 >> 7) & 0xfffu) / 256.0f : 0.0f;
+    if (desc.MaxLOD < desc.MinLOD) desc.MaxLOD = desc.MinLOD;
+    desc.MaxAnisotropy = 1;
+    desc.ComparisonFunc = D3D12_COMPARISON_FUNC_NEVER;
+    if (anisotropy > 1 && mip_present && min_linear && mag_linear) {
+        desc.Filter = D3D12_FILTER_ANISOTROPIC;
+        desc.MaxAnisotropy = anisotropy > 16 ? 16 : anisotropy;
+    }
+    return desc;
+}
+static inline int rsx_d3d12_sampler_equal(const D3D12_SAMPLER_DESC* a,
+                                         const D3D12_SAMPLER_DESC* b)
+{
+    if (a->Filter != b->Filter || a->AddressU != b->AddressU ||
+        a->AddressV != b->AddressV || a->AddressW != b->AddressW ||
+        a->MipLODBias != b->MipLODBias || a->MaxAnisotropy != b->MaxAnisotropy ||
+        a->ComparisonFunc != b->ComparisonFunc || a->MinLOD != b->MinLOD ||
+        a->MaxLOD != b->MaxLOD) return 0;
+    for (unsigned i = 0; i < 4; ++i) if (a->BorderColor[i] != b->BorderColor[i]) return 0;
+    return 1;
+}
+#endif
diff --git a/libs/video/rsx_d3d12_window.h b/libs/video/rsx_d3d12_window.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_d3d12_window.h
@@ -0,0 +1,64 @@
+/* Renderer-thread DXGI/Win32 display changes. No guest timing is altered. */
+#ifndef RSX_D3D12_WINDOW_H
+#define RSX_D3D12_WINDOW_H
+#include <windows.h>
+#include <dxgi1_5.h>
+#include "rsx_graphics_settings.h"
+typedef struct rsx_d3d12_window_state {
+    LONG_PTR windowed_style;
+    RECT windowed_rect;
+    unsigned mode;
+    int captured, fullscreen;
+} rsx_d3d12_window_state;
+
+/* Returns 1 after a mode/size operation; -1 means DXGI rejected it. The caller
+ * must drain GPU references first and ResizeBuffers before the next Present. */
+static inline int rsx_d3d12_window_apply(IDXGISwapChain3* swap, HWND window,
+    const rsx_graphics_config* config, rsx_d3d12_window_state* state)
+{
+    if (!state->captured) {
+        state->windowed_style = GetWindowLongPtrA(window, GWL_STYLE);
+        GetWindowRect(window, &state->windowed_rect);
+        state->captured = 1;
+    }
+    if (state->mode == 0) GetWindowRect(window, &state->windowed_rect);
+    if (state->fullscreen) {
+        if (FAILED(swap->lpVtbl->SetFullscreenState(swap, FALSE, NULL))) return -1;
+        state->fullscreen = 0;
+    }
+    if (config->window_mode == 2) {
+        DXGI_MODE_DESC target = {0};
+        target.Width = config->width; target.Height = config->height;
+        target.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        if (FAILED(swap->lpVtbl->ResizeTarget(swap, &target)) ||
+            FAILED(swap->lpVtbl->SetFullscreenState(swap, TRUE, NULL))) return -1;
+        state->fullscreen = 1;
+        /* Let DXGI select a compatible refresh rate. */
+        swap->lpVtbl->ResizeTarget(swap, &target);
+    } else if (config->window_mode == 1) {
+        MONITORINFO monitor = {sizeof(monitor)};
+        if (!GetMonitorInfoA(MonitorFromWindow(window, MONITOR_DEFAULTTONEAREST), &monitor)) return -1;
+        const LONG_PTR visible = GetWindowLongPtrA(window, GWL_STYLE) & WS_VISIBLE;
+        SetWindowLongPtrA(window, GWL_STYLE, WS_POPUP | visible);
+        SetWindowPos(window, NULL, monitor.rcMonitor.left, monitor.rcMonitor.top,
+            monitor.rcMonitor.right - monitor.rcMonitor.left,
+            monitor.rcMonitor.bottom - monitor.rcMonitor.top,
+            SWP_NOACTIVATE | SWP_NOZORDER | SWP_FRAMECHANGED);
+    } else {
+        RECT rect = {0, 0, (LONG)config->width, (LONG)config->height};
+        SetWindowLongPtrA(window, GWL_STYLE, state->windowed_style);
+        AdjustWindowRectEx(&rect, (DWORD)state->windowed_style, FALSE,
+            (DWORD)GetWindowLongPtrA(window, GWL_EXSTYLE));
+        SetWindowPos(window, NULL, state->windowed_rect.left, state->windowed_rect.top,
+            config->width ? rect.right - rect.left : state->windowed_rect.right - state->windowed_rect.left,
+            config->height ? rect.bottom - rect.top : state->windowed_rect.bottom - state->windowed_rect.top,
+            SWP_NOACTIVATE | SWP_NOZORDER | SWP_FRAMECHANGED);
+    }
+    state->mode = config->window_mode;
+    return 1;
+}
+static inline UINT rsx_d3d12_present_flags(int vsync, int tearing, int fullscreen)
+{
+    return !vsync && tearing && !fullscreen ? DXGI_PRESENT_ALLOW_TEARING : 0;
+}
+#endif
