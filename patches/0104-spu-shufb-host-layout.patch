+/* Host-layout SHUFB adapted from JonathanDC64/ps3recomp (MIT),
+ * commit 6a019d53d4ce195d1f469c75ad1c9564513b7f85. SPU byte P lives
+ * at host byte P^3; selecting (selector & 15)^3 avoids four byte swaps.
+ * Bit 4 selects a/b, and the top nibble selects 0x00/0xFF/0x80. */
 static inline u128 spu_shufb(u128 a, u128 b, u128 c) {
-    const __m128i sw = _mm_setr_epi8(3,2,1,0, 7,6,5,4, 11,10,9,8, 15,14,13,12);
