+/* A backend with GPU copies must preserve the pixels before the consuming
+ * draw, rather than read stale guest bytes or bind an attachment as a texture. */
+static void test_surface_feedback(void)
+{
+    printf("-- colour target feedback\n");
+    rsx_draw_backend backend = g_stub_backend;
+    backend.color_target_copy = stub_color_copy;
+    engine_up();
+    rsx_draw_engine_set_backend(&backend);
+    m(M_COLOR_MASK, 0x01010101u);
+    m(M_COLOR_A_PITCH, 256u * 4u);
+    draw_triangle();
+    const u32 surface = stub.bound_surface;
+    stub.color_stamp[surface] = 42u;
+    bind_texture_unit(RSX_LOCATION_LOCAL, 0x40000u);
+    /* A second unit reads the same target: one copy for the whole draw. */
+    for (u32 off = 0; off <= 0x18u; off += 4u) {
+        const u32 values[] = { 0x40000u, 1u | (2u << 4) | (0xA5u << 8) | (1u << 16),
+                               0u, 0x80000000u, 0xA9E4u, 0u, (4u << 16) | 4u };
+        m(M_TEX_UNIT + 0x20u + off, values[off / 4u]);
+    }
+    m(M_TEX_UNIT + 0x10, 0xA9E4u);
+    const int uploads = stub.n_texture_create;
+    draw_triangle();
+    const u32 snapshot = stub.bound_tex[0];
+    CHECK(snapshot && snapshot != surface && stub.bound_tex[1] == snapshot,
+          "both units sample a separate pre-draw image");
+    CHECK(stub.n_color_copy == 1 && stub.copied_src == surface &&
+          stub.copied_dst == snapshot && stub.copied_w == 256 && stub.copied_h == 256,
+          "one full-target GPU copy precedes the draw");
+    CHECK(stub.sampled_stamp == 42u && stub.color_stamp[surface] == 43u,
+          "the sampled pixels precede this draw's colour write");
+    CHECK(stub.n_texture_create == uploads && stub.last_view_surface == snapshot,
+          "feedback uses a surface view without a guest upload");
+    /* Unit 1 is bound last. Its non-identity crossbar must be retained too. */
+    CHECK(stub.last_view_remap == 0xA9E4u, "the copy uses the texture unit's remap");
+    draw_triangle();
+    CHECK(stub.n_color_copy == 2 && stub.bound_tex[0] == snapshot &&
+          stub.sampled_stamp == 43u,
+          "the next draw refreshes the existing copy after a colour write");
+    m(M_COLOR_MASK, 0u);
+    draw_triangle();
+    const int copies = stub.n_color_copy;
+    draw_triangle();
+    CHECK(stub.n_color_copy == copies,
+          "draws without colour writes reuse an unchanged snapshot");
+    stub.color_stamp[surface] = 99u;
+    rsx_draw_engine_guest_wrote(RSX_LOCATION_LOCAL, 0x40000u, 256u * 4u, 1u, 1u);
+    draw_triangle();
+    CHECK(stub.n_color_copy == copies + 1 && stub.sampled_stamp == 99u,
+          "a guest transfer invalidates the cached snapshot");
+
+    /* The snapshot allocation and its views cannot survive a target resize. */
+    m(M_SURFACE_CLIP_H, 128u << 16);
+    m(M_SURFACE_CLIP_V, 64u << 16);
+    draw_triangle();
+    const u32 resized_snapshot = stub.bound_tex[0];
+    CHECK(!stub.alive[surface] && !stub.alive[snapshot] &&
+          resized_snapshot != snapshot && stub.copied_w == 128 && stub.copied_h == 64,
+          "resizing retires both old images and copies the new dimensions");
+    engine_down();
+    CHECK(!stub.alive[resized_snapshot], "shutdown releases the feedback image");
+
+    /* A missing or failed GPU copy falls back to the rendered guest bytes. */
+    for (int failed_copy = 0; failed_copy < 2; failed_copy++) {
+        engine_up();
+        if (failed_copy) {
+            rsx_draw_engine_set_backend(&backend);
+            stub.copy_failure = 1;
+        }
+        m(M_COLOR_MASK, 0x01010101u);
+        m(M_COLOR_A_PITCH, 256u * 4u);
+        memset(vm_base + GUEST_LOCAL_EA + 0x40000u, 0, 256u * 256u * 4u);
+        m(M_CLEAR_BUFFERS, 0xF0u);
+        bind_texture_unit(RSX_LOCATION_LOCAL, 0x40000u);
+        draw_triangle();
+        const u8* pixel = vm_base + GUEST_LOCAL_EA + 0x40000u;
+        CHECK(stub.n_color_readback == 1 &&
+              pixel[0] == 0x44 && pixel[1] == 0x11 && pixel[2] == 0x22 && pixel[3] == 0x33 &&
+              stub.bound_tex[0] == stub.last_created_texture,
+              "feedback without a working GPU copy uploads current A,R,G,B bytes (%d)",
+              failed_copy);
+        engine_down();
+    }
+}
