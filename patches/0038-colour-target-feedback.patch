+
+/* A draw can read the pixels that preceded it at its own colour address.
+ * The host APIs cannot bind one image for both uses, and guest memory can be
+ * several passes behind. Keep a separate GPU image, copied immediately before
+ * the consuming draw. Multiple units in that draw share the copy; the next
+ * colour write makes it stale. DemonsSoulsRecomp's off_rt_snapshot demonstrates
+ * this requirement for its exposure pass; WKC uses it in colour correction. */
+static u32 eng_surface_snapshot(u32 slot)
+{
+    eng_surface* s = &g.surfaces[slot];
+    if (!g.be->color_target_copy) return 0;
+    if (!s->snapshot) {
+        s->snapshot = g.be->color_target_create(g.be->user, s->fmt, s->w, s->h,
+                                                NULL, 0);
+        s->snapshot_valid = 0;
+        if (!s->snapshot) return 0;
+    }
+    if (!s->snapshot_valid || s->snapshot_serial != s->color_serial) {
+        if (g.be->color_target_copy(g.be->user, s->snapshot, 0, 0, s->handle,
+                                     0, 0, s->w, s->h) != 0)
+            return 0;
+        s->snapshot_serial = s->color_serial;
+        s->snapshot_valid = 1;
+    }
+    return s->snapshot;
 }
 
