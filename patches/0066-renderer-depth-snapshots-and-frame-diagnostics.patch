+/* RSX_ENGINE_BURST_DIR=<dir>: once <dir>/arm exists, write the next 40
+ * presented surfaces as burst_NNN.ppm and their present times (ms) to
+ * burst.txt, then delete arm. Telling a game that renders often from one that
+ * changes its picture often needs consecutive frames; the readback slows the
+ * frames it captures, so compare pictures, not the times. */
+static void pd_burst(u32 presented)
+{
+    static const char* dir = (const char*)-1;
+    static int left;
+    static u32 polls;
+    static FILE* log;
+    static int burst_n = 90;
+    if (dir == (const char*)-1) dir = getenv("RSX_ENGINE_BURST_DIR");
+    if (!dir || !*dir || presented == ENG_INVALID) return;
+    char path[1024];
+    if (!left) {
+        if (++polls % 15) return;
+        snprintf(path, sizeof path, "%s/arm", dir);
+        FILE* f = fopen(path, "rb");
+        if (!f) return;
+        fclose(f);
+        remove(path);
+        { const char* e = getenv("RSX_ENGINE_BURST_N"); burst_n = (e && atoi(e) > 0) ? atoi(e) : 90; }
+        left = burst_n;
+        snprintf(path, sizeof path, "%s/burst.txt", dir);
+        log = fopen(path, "w");
+    }
+    const int i = burst_n - left--;
+    struct timespec ts;
+    timespec_get(&ts, TIME_UTC);
+    if (log) {
+        fprintf(log, "%03d %.1f\n", i, ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6);
+        if (!left) { fclose(log); log = NULL; }
+    }
+    snprintf(path, sizeof path, "%s/burst_%03d.ppm", dir, i);
+    pd_write_surface(presented, path);
+}
