+         * through the remapped one, as a texture_create view would. */
+        s_zc.e[i].store_view = o->im.view;
+        o->im.view = VK_NULL_HANDLE;
+        if (vk_eng_make_view(o->im.img, VK_FORMAT_R8G8B8A8_UNORM, 1, vk_remap(remap, rsx_fmt), 0, &o->im.view)) {
+            pvkDestroyImageView(s_vk.device, s_zc.e[i].store_view, NULL);
+            s_zc.e[i].store_view = VK_NULL_HANDLE;
+            vk_destroy_image(&o->im); memset(o, 0, sizeof *o); return 0;
+        }
+        o->kind = VK_ENG_TEXTURE; o->fmt = VK_FORMAT_R8G8B8A8_UNORM; o->bpp = 4; o->w = w; o->h = h;
+        s_zc.e[i].tex = t;
+        s_zc.e[i].src_view = VK_NULL_HANDLE;
+        if (vk_rec_begin()) return 0;
+        vk_barrier_image(o->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+        src = vk_eng_get(snapshot, VK_ENG_TEXTURE);
+        if (!src) return 0;
+    }
+    vk_eng_obj* dst = vk_eng_get(s_zc.e[i].tex, VK_ENG_TEXTURE);
+    if (!dst) return 0;
+    if (s_zc.e[i].src_view != src->im.view) {
+        VkDescriptorImageInfo ii[2] = {
+            { VK_NULL_HANDLE, src->im.view, VK_IMAGE_LAYOUT_GENERAL },
+            { VK_NULL_HANDLE, s_zc.e[i].store_view, VK_IMAGE_LAYOUT_GENERAL },
+        };
