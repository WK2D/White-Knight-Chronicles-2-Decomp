+        if (pvkAllocateDescriptorSets(s_vk.device, &ai, &set) != VK_SUCCESS) return 0;
+        s_zc.e[i].snap = snapshot; s_zc.e[i].set = set; s_zc.e[i].tex = 0; s_zc.e[i].src_view = VK_NULL_HANDLE;
+        s_zc.e[i].remap = remap; s_zc.e[i].rsx_fmt = rsx_fmt; s_zc.e[i].store_view = VK_NULL_HANDLE;
