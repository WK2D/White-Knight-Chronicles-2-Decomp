+/* depth_to_argb8: one compute pass from a depth snapshot (R32_SFLOAT) to the
+ * RGBA8 texels an A8R8G8B8 fetch of the Z24S8 bytes gives -- the same rounding
+ * the engine's CPU conversion uses. Each snapshot keeps its own output image
+ * and descriptor set; neither changes while the snapshot lives. */
+static const char s_zconv_hlsl[] =
+    "[[vk::binding(0, 0)]] Texture2D<float> zsrc;\n"
+    "[[vk::binding(1, 0)]] [[vk::image_format(\"rgba8\")]] RWTexture2D<float4> zdst;\n"
+    "[numthreads(8, 8, 1)]\n"
+    "void main(uint3 id : SV_DispatchThreadID) {\n"
+    "    uint w, h; zdst.GetDimensions(w, h);\n"
+    "    if (id.x >= w || id.y >= h) return;\n"
+    "    float d = zsrc.Load(int3(id.xy, 0));\n"
+    "    d = (d > 0.0) ? min(d, 1.0) : 0.0;\n"
+    "    uint v = (uint)(d * 16777215.0 + 0.5);\n"
+    "    float a = float(v >> 16), r = float((v >> 8) & 255u), g = float(v & 255u), b = 0.0;\n"
+    "    zdst[id.xy] = ZCONV_STORE / 255.0;\n"
+    "}\n";
+#define VK_ZCONV_MAX 8
+static struct {
+    int failed, ready;
+    VkDescriptorSetLayout dsl;
+    VkPipelineLayout pl;
+    VkPipeline pipe;
+    VkDescriptorPool pool;
+    struct { u32 snap, remap, rsx_fmt; VkImageView src_view, store_view; u32 tex; VkDescriptorSet set; } e[VK_ZCONV_MAX];
+    u32 n;
