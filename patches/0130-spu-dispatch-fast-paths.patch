 /* Drain a translated call up to its explicit architectural return PC. */
 void spu_drain_call(spu_context* ctx, uint32_t return_pc);
+/* Host-recursion limit spu_depth_guard enforces (SPU_HOST_DEPTH_MAX, default
+ * 2000); 0 until the first guard reads the environment. A merged definition,
+ * like the other diagnostic gates, so a target that compiles the guard alone
+ * still links. */
+SPU_GATE uint32_t g_spu_host_depth_max = 0;
+/* Every lifted brsl/bisl ends `callee(ctx); spu_drain_call(ctx, link)`, and a
+ * callee that came back through SPU_RET leaves nothing to drain: no pending
+ * transfer and pc already at the link. The out-of-line drain then did only its
+ * depth check and cleared drain_ret_pc -- a call, a thread-local ring write and
+ * an interrupt-frame setup per SPU call, about a seventh of a render-command
+ * job. Do that inline; everything else (a pending transfer, a return elsewhere,
+ * an untripped limit not yet read) takes the full drain. The depth guard's
+ * diagnostic ring then names drain sites that ran transfers, not plain returns. */
+static inline void spu_drain_call_inline(spu_context* ctx, uint32_t return_pc)
+{
+    if (!g_spu_trampoline_fn &&
+        ((ctx->pc ^ return_pc) & SPU_LS_MASK) == 0 &&
+        ctx->host_depth < g_spu_host_depth_max) {
+        ctx->drain_ret_pc = 0;
+        return;
+    }
+    spu_drain_call(ctx, return_pc);
+}
+#define spu_drain_call(ctx, return_pc) spu_drain_call_inline((ctx), (return_pc))
+/* The lockstep gate (spu_lockstep.c) is -1 until read, then 0 or 1; checking
+ * it before the call keeps the disabled case to one load per transfer. */
+extern volatile int g_yz_lockstep_on;
+#define SPU_LOCKSTEP_TICK(ctx) do { if (g_yz_lockstep_on) yz_lockstep_tick(ctx); } while (0)
 /* SPU_PCHIST=1: bucket SPU execution by the GPU module's own symbols.
  *
  * SPU_VRAMPC showed 3.7M VRAM writes from Host2Local_Body and ZERO from
@@ -869,11 +897,12 @@
  *
  * Extents from the .symtab embedded in ps1_netemu (firmware file offset
  * 0x171100), so they are exact rather than guessed. */
