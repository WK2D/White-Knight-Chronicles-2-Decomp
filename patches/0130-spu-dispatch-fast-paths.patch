@@ -956,6 +985,49 @@
  * host-frame return as SPU_RET, publishing the register actually branched. */
 #define SPU_RET_REG(ctx, n) do {                                       (ctx)->pc = (ctx)->gpr[n]._u32[0];                             if ((ctx)->host_depth == 0)                                        g_spu_trampoline_fn = spu_indirect_branch;                 return;                                                    } while (0)
 
+/* Direct transfer between lifted functions.
+ *
+ * A cross-function branch is lowered as `ctx->pc = X; g_spu_trampoline_fn =
+ * F; return;`, so every hop unwinds to the drain loop, which runs the per-
+ * transfer hooks and calls F. When none of those hooks has anything to do --
+ * the same conditions the loop tests before skipping them -- the hop can call
+ * F directly as a guaranteed tail call: same order of effects, same bounded
+ * host stack, no unwind. The loop's bookkeeping for a skipped launch check
+ * (`steps`) and its pc history ring are kept. A branch to LS 0 (a job's exit),
+ * an armed lockstep, launch check, PM flow trace, pc histogram, SPU_TAILRET or
+ * a pending interrupt all take the trampoline as before. Lifted code opts in
+ * by spelling those branches SPU_JUMP; without musttail it is the trampoline. */
+extern int g_spu_tailret;   /* SPU_TAILRET: -1 until read, then 0/1 */
+static inline int spu_direct_jump_ok(const spu_context* ctx)
+{
+    return !g_spu_launch_check_all && !ctx->policy_mode &&
+           !(g_spu_stack_reset_count && ctx->host_depth) &&
+           g_pm_flow_ctx != (void*)ctx && !g_yz_lockstep_on &&
+           !g_spu_pchist && !g_spu_tailret &&
+           !(ctx->int_enable && (ctx->event_status & ctx->event_mask));
+}
+#if defined(__clang__) && defined(__has_attribute)
+#  if __has_attribute(musttail)
+#    define SPU_MUSTTAIL __attribute__((musttail))
+#  endif
+#endif
+#ifdef SPU_MUSTTAIL
+#define SPU_JUMP(ctx, target_pc, fn) do {                                  \
+        (ctx)->pc = (target_pc);                                           \
+        if (((target_pc) & SPU_LS_MASK) != 0 && spu_direct_jump_ok(ctx)) { \
+            (ctx)->steps++;                                                \
+            g_spu_pch[g_spu_pch_n++ & 7u] = (uint32_t)((target_pc) & SPU_LS_MASK); \
+            SPU_MUSTTAIL return fn(ctx);                                   \
+        }                                                                  \
+        g_spu_trampoline_fn = (fn);                                        \
+        return;                                                            \
+    } while (0)
+#else
+#define SPU_JUMP(ctx, target_pc, fn) do {                                  \
+        (ctx)->pc = (target_pc); g_spu_trampoline_fn = (fn); return;       \
+    } while (0)
+#endif
+
 #ifdef __cplusplus
 } /* extern "C" */
 #endif
