 static inline void spu_pchist_tick(const spu_context* ctx)
 {
-    static int en = -1;
-    if (en < 0) en = getenv("SPU_PCHIST") ? 1 : 0;
-    if (!en) return;
+    if (__builtin_expect(g_spu_pchist == 0, 1)) return;
