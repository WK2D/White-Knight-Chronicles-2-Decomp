@@ -0,0 +1,29 @@
+/* RSX window-depth clip interval. Keep viewport mapping and vertex
+ * normalization paired: changing only the viewport would rescale stored depth. */
+#ifndef PS3RECOMP_RSX_DEPTH_RANGE_H
+#define PS3RECOMP_RSX_DEPTH_RANGE_H
+#include <float.h>
+static inline int rsx_depth_range_finite(float x) {
+    return x <= FLT_MAX && x >= -FLT_MAX;
+}
+static inline int rsx_depth_range_valid(float n, float f) {
+    return rsx_depth_range_finite(n) && rsx_depth_range_finite(f) && n < f;
+}
+/* Return zero for an unsupported interval and reset to the ordinary viewport.
+ * Equal/reversed/nonfinite ranges need separate hardware validation. */
+static inline int rsx_depth_range_select(float n, float f, int unrestricted,
+                                         float range[2]) {
+    range[0]=0.0f;range[1]=1.0f;
+    if (!rsx_depth_range_valid(n,f) || (!unrestricted && (n<0.0f || f>1.0f)))return 0;
+    range[0]=n;range[1]=f;return 1;
+}
+static inline int rsx_depth_range_coefficients(float scale, float offset,
+    float n, float f, float out[2]) {
+    if (!rsx_depth_range_valid(n,f))return 0;
+    const double inv=1.0/((double)f-(double)n);
+    const float s=(float)((double)scale*inv);
+    const float t=(float)(((double)offset-(double)n)*inv);
+    if (!rsx_depth_range_finite(s) || !rsx_depth_range_finite(t))return 0;
+    out[0]=s;out[1]=t;return 1;
+}
+#endif
