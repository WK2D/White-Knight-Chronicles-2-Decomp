diff --git a/libs/video/rsx_d3d12_depth_bias.h b/libs/video/rsx_d3d12_depth_bias.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_d3d12_depth_bias.h
@@ -0,0 +1,27 @@
+/* Live DirectX currently uses D32_FLOAT_S8X24 depth. D3D's float-depth
+ * rasterizer applies constant bias in exponent-relative ULPs, like the Vulkan
+ * D32 path. Its baseline PSO field is integer: fractional RSX constants round
+ * to nearest, with ties away from zero. Other guest/host precision is unverified.
+ * https://learn.microsoft.com/en-us/windows/win32/direct3d11/d3d10-graphics-programming-guide-output-merger-stage-depth-bias */
+#ifndef RSX_D3D12_DEPTH_BIAS_H
+#define RSX_D3D12_DEPTH_BIAS_H
+#include <stdint.h>
+#include <limits.h>
+#include <float.h>
+#include <math.h>
+#include <string.h>
+typedef struct rsx_d3d12_depth_bias { int32_t constant; float slope; } rsx_d3d12_depth_bias;
+static inline rsx_d3d12_depth_bias rsx_d3d12_depth_bias_decode(
+    uint32_t primitive, uint32_t enabled, uint32_t scale_bits, uint32_t bias_bits)
+{
+    rsx_d3d12_depth_bias out={0,0};
+    /* RSX primitive numbers: points=1, lines=2/3/4, triangles through polygon=5..10. */
+    if (!(enabled&1u) || primitive<5u || primitive>10u) return out;
+    float scale,bias;memcpy(&scale,&scale_bits,4);memcpy(&bias,&bias_bits,4);
+    if (!(scale>=-FLT_MAX && scale<=FLT_MAX) || !(bias>=-FLT_MAX && bias<=FLT_MAX)) return out;
+    const double rounded=round((double)bias);
+    out.constant=rounded>INT_MAX?INT_MAX:rounded<INT_MIN?INT_MIN:(int32_t)rounded;
+    out.slope=scale==0?0:scale;
+    return out;
+}
+#endif
