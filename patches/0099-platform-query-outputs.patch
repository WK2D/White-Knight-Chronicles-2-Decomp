 #include "sys_memory.h"
 #include "sys_vm.h"
 #include "sys_fs.h"
@@ -2454,6 +2453,7 @@
     /* Timer and time (registered before events so event handlers
      * override the conflicting syscall numbers 141, 142, 145) */
     sys_timer_init(tbl);
