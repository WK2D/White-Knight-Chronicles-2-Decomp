diff --git a/runtime/ppu/ppu_syscall_coverage.h b/runtime/ppu/ppu_syscall_coverage.h
new file mode 100644
--- /dev/null
+++ b/runtime/ppu/ppu_syscall_coverage.h
@@ -0,0 +1,21 @@
+/* Warn once per valid LV2 syscall number, independent of earlier calls.
+ * The loader's old shared 30-message budget hid newly encountered requests.
+ * Invalid numbers outside the dispatch table share one overflow warning. */
+#ifndef PS3RECOMP_PPU_SYSCALL_COVERAGE_H
+#define PS3RECOMP_PPU_SYSCALL_COVERAGE_H
+#include <stdint.h>
+#ifdef _MSC_VER
+#include <intrin.h>
+#endif
+typedef struct ppu_syscall_coverage { uint64_t words[17]; } ppu_syscall_coverage;
+static inline int ppu_syscall_first_unhandled(ppu_syscall_coverage* state,uint64_t num) {
+    unsigned index=num<1024?(unsigned)(num>>6):16u;
+    uint64_t mask=UINT64_C(1)<<(num<1024?(num&63):0);
+#ifdef _MSC_VER
+    uint64_t old=(uint64_t)_InterlockedOr64((volatile __int64*)&state->words[index],(__int64)mask);
+#else
+    uint64_t old=__atomic_fetch_or(&state->words[index],mask,__ATOMIC_RELAXED);
+#endif
+    return !(old&mask);
+}
+#endif
