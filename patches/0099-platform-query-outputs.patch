diff --git a/runtime/syscalls/sys_platform_queries.h b/runtime/syscalls/sys_platform_queries.h
new file mode 100644
--- /dev/null
+++ b/runtime/syscalls/sys_platform_queries.h
@@ -0,0 +1,71 @@
+/* Retail platform queries used by WKC. No console device is exposed to
+ * the host: GPIO reports a retail console's absent LEDs/DIP switches. */
+#ifndef PS3RECOMP_SYS_PLATFORM_QUERIES_H
+#define PS3RECOMP_SYS_PLATFORM_QUERIES_H
+#include "lv2_syscall_table.h"
+#include <string.h>
+#include <time.h>
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+extern uint8_t* vm_base;
+extern uint32_t ppu_vm_size;
+static inline int lv2_platform_output(uint32_t ea,uint32_t bytes) {
+    uint64_t limit=ppu_vm_size?ppu_vm_size:(UINT64_C(1)<<32);
+    return vm_base && ea && (uint64_t)ea+bytes<=limit;
+}
+static inline void lv2_platform_store32(uint32_t ea,int32_t value) {
+    uint32_t v=(uint32_t)value;uint8_t* p=vm_base+ea;
+    p[0]=(uint8_t)(v>>24);p[1]=(uint8_t)(v>>16);p[2]=(uint8_t)(v>>8);p[3]=(uint8_t)v;
+}
+/* Both fields are minutes east of UTC; summertime is separate from the
+ * standard-zone offset. Do not log host timezone configuration. */
+static inline int lv2_platform_timezone_host(int32_t* base,int32_t* summer) {
+#ifdef _WIN32
+    TIME_ZONE_INFORMATION zone;DWORD state=GetTimeZoneInformation(&zone);
+    if(state==TIME_ZONE_ID_INVALID)return 0;
+    *base=-zone.Bias;
+    *summer=state==TIME_ZONE_ID_DAYLIGHT?-zone.DaylightBias:
+            state==TIME_ZONE_ID_STANDARD?-zone.StandardBias:0;
+#else
+    time_t now=time(NULL);struct tm local,utc;
+    if(!localtime_r(&now,&local) || !gmtime_r(&now,&utc))return 0;
+    int days=local.tm_yday-utc.tm_yday;
+    if(days>1)days=-1;else if(days< -1)days=1; /* year boundary */
+    int32_t actual=days*1440+(local.tm_hour-utc.tm_hour)*60+local.tm_min-utc.tm_min;
+    *summer=0;
+    if(local.tm_isdst>0) {
+        struct tm standard=local;standard.tm_isdst=0;
+        time_t as_standard=mktime(&standard);if(as_standard==(time_t)-1)return 0;
+        *summer=(int32_t)(difftime(as_standard,now)/60.0);
+    }
+    *base=actual-*summer;
+#endif
+    return 1;
+}
+static int64_t lv2_platform_get_timezone(ppu_context* ctx) {
+    uint32_t a=LV2_ARG_PTR(ctx,0),b=LV2_ARG_PTR(ctx,1);int32_t zone,summer;
+    if(!lv2_platform_output(a,4) || !lv2_platform_output(b,4))
+        return (int64_t)(int32_t)CELL_EFAULT;
+    if(!lv2_platform_timezone_host(&zone,&summer))return (int64_t)(int32_t)CELL_EIO;
+    lv2_platform_store32(a,zone);lv2_platform_store32(b,summer);return CELL_OK;
+}
+static int64_t lv2_platform_gpio_get(ppu_context* ctx) {
+    uint64_t device=LV2_ARG_U64(ctx,0);uint32_t out=LV2_ARG_PTR(ctx,1);
+    if(device!=1 && device!=2)return (int64_t)(int32_t)CELL_ESRCH;
+    if(!lv2_platform_output(out,8))return (int64_t)(int32_t)CELL_EFAULT;
+    memset(vm_base+out,0,8);return CELL_OK;
+}
+static int64_t lv2_platform_gpio_set(ppu_context* ctx) {
+    uint64_t device=LV2_ARG_U64(ctx,0);
+    return device==1?CELL_OK:(int64_t)(int32_t)(device==2?CELL_EINVAL:CELL_ESRCH);
+}
+static inline void lv2_platform_queries_register(lv2_syscall_table* table) {
+    lv2_syscall_register(table,SYS_TIME_GET_TIMEZONE,lv2_platform_get_timezone);
+    lv2_syscall_register(table,SYS_GPIO_GET,lv2_platform_gpio_get);
+    lv2_syscall_register(table,SYS_GPIO_SET,lv2_platform_gpio_set);
+}
+#endif
