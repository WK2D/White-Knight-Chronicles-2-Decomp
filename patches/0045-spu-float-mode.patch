+static inline u128 spu_fma_host(u128 a, u128 b, u128 c)  { u128 r; for(int i=0;i<4;i++) r._f32[i]=fmaf(a._f32[i], b._f32[i], c._f32[i]); return r; }
+static inline u128 spu_fms_host(u128 a, u128 b, u128 c)  { u128 r; for(int i=0;i<4;i++) r._f32[i]=fmaf(a._f32[i], b._f32[i], -c._f32[i]); return r; }
+static inline u128 spu_cflts(u128 a, int i8) { return g_spu_float_mode ? spu_cflts_mode(&a,i8) : spu_cflts_host(a,i8); }
