+/* ---- single-precision float (4 lanes) ----
+ * The host bodies (spu_*_host) are IEEE: round to nearest, denormals kept,
+ * exponent 255 read as Inf/NaN, overflow to Inf. SPU single precision
+ * truncates, reads denormals as zero, treats exponent 255 as finite and
+ * saturates. SPU_FLOAT_MODE=exact applies the SPU rules to FA, FS, FM, FMA,
+ * FMS, the four conversions and the four compares; audit keeps the host
+ * results and reports lanes where the two differ (spu_float_mode.c). Unset
+ * runs the host bodies after one flag test. FNMS always uses the SPU rules
+ * (spu_sf_fnms). */
+enum { SPU_FLOAT_HOST = 0, SPU_FLOAT_EXACT = 1, SPU_FLOAT_AUDIT = 2 };
+enum { SPU_FOP_FA, SPU_FOP_FS, SPU_FOP_FM, SPU_FOP_FMA, SPU_FOP_FMS,
+       SPU_FOP_CFLTS, SPU_FOP_CFLTU, SPU_FOP_CSFLT, SPU_FOP_CUFLT,
+       SPU_FOP_FCEQ, SPU_FOP_FCGT, SPU_FOP_FCMEQ, SPU_FOP_FCMGT, SPU_FOP_COUNT };
+extern int g_spu_float_mode;   /* -1 until spu_float_mode_init(), then the mode */
+int spu_float_mode_init(void);
+uint64_t spu_float_audit_count(int op, int special);
+/* Operands by address keep the inline host path free of call-ABI moves. */
+u128 spu_fa_mode(const u128* a, const u128* b);
+u128 spu_fs_mode(const u128* a, const u128* b);
+u128 spu_fm_mode(const u128* a, const u128* b);
+u128 spu_fma_mode(const u128* a, const u128* b, const u128* c);
+u128 spu_fms_mode(const u128* a, const u128* b, const u128* c);
+u128 spu_cflts_mode(const u128* a, int i8);
+u128 spu_cfltu_mode(const u128* a, int i8);
+u128 spu_csflt_mode(const u128* a, int i8);
+u128 spu_cuflt_mode(const u128* a, int i8);
+u128 spu_fceq_mode(const u128* a, const u128* b);
+u128 spu_fcgt_mode(const u128* a, const u128* b);
+u128 spu_fcmeq_mode(const u128* a, const u128* b);
+u128 spu_fcmgt_mode(const u128* a, const u128* b);
+static inline u128 spu_fa_host(u128 a, u128 b) { u128 r; for(int i=0;i<4;i++) r._f32[i]=a._f32[i]+b._f32[i]; return r; }
+static inline u128 spu_fs_host(u128 a, u128 b) { u128 r; for(int i=0;i<4;i++) r._f32[i]=a._f32[i]-b._f32[i]; return r; }
