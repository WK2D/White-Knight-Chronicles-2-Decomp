+/* (+-a*b) + (+-c) under the same rules as spu_sf_fnms, which is the
+ * negate_product case. FM passes c = 0; FA and FS pass b = 1.0. */
+static inline uint32_t spu_sf_fused(uint32_t a,uint32_t b,uint32_t c,int negate_product,int negate_addend) {
+    if(negate_addend) c^=0x80000000u;
+    int ea=(int)((a>>23)&255),eb=(int)((b>>23)&255),ec=(int)((c>>23)&255);
+    if(!ea || !eb) return ec ? c : 0;
+    uint64_t product=(uint64_t)((a&0x7fffffu)|0x800000u)*((b&0x7fffffu)|0x800000u);
+    uint64_t addend=ec ? ((c&0x7fffffu)|0x800000u) : 0;
+    int pe=ea+eb-300,ce=ec-150;
+    int pt=pe+(int)spu_sf_msb64(product);
+    int ct=addend ? ce+(int)spu_sf_msb64(addend) : pt;
+    int unit=(pt>ct ? pt : ct)-61;
+    uint64_t p=spu_sf_align(product,unit-pe),q=addend ? spu_sf_align(addend,unit-ce) : 0;
+    uint32_t ps=((a^b)&0x80000000u)^(negate_product ? 0x80000000u : 0),cs=c&0x80000000u,sign;
+    uint64_t magnitude;
+    if(ps==cs) { magnitude=p+q;sign=ps; }
+    else if(p>=q) { magnitude=p-q;sign=ps; }
+    else { magnitude=q-p;sign=cs; }
+    if(!magnitude) return 0;
+    unsigned top=spu_sf_msb64(magnitude);
+    int exponent=unit+(int)top+127;
+    if(exponent<=0) return 0;
+    if(exponent>255) return sign|0x7fffffffu;
+    uint64_t sig=top>23 ? magnitude>>(top-23) : magnitude<<(23-top);
+    return sign|((uint32_t)exponent<<23)|((uint32_t)sig&0x7fffffu);
+}
+/* CFLTS/CFLTU: a * 2^(173-i8), truncated and saturated. Exponent 255 is a
+ * finite value, so it saturates by sign rather than converting a host NaN. */
+static inline uint32_t spu_sf_cflt(uint32_t a, int i8, int is_signed) {
+    int e=(int)((a>>23)&255);
+    if(!e) return 0;
+    int negative=(a>>31)!=0;
+    if(negative && !is_signed) return 0;
+    uint32_t limit=is_signed ? (negative ? 0x80000000u : 0x7fffffffu) : 0xffffffffu;
+    int shift=e+23-i8;   /* value = 24-bit significand * 2^shift */
+    uint64_t sig=(a&0x7fffffu)|0x800000u, magnitude;
+    if(shift>=40) magnitude=UINT64_MAX;
+    else if(shift>=0) magnitude=sig<<shift;
+    else magnitude=-shift>=64 ? 0 : sig>>-shift;
+    if(magnitude>limit) magnitude=limit;
+    return negative ? (uint32_t)(0u-(uint32_t)magnitude) : (uint32_t)magnitude;
+}
+/* CSFLT/CUFLT: integer * 2^(i8-155), truncated to 24 bits, saturated. */
+static inline uint32_t spu_sf_cvflt(uint32_t a, int i8, int is_signed) {
+    uint32_t sign=(is_signed && (a>>31)) ? 0x80000000u : 0;
+    uint32_t magnitude=sign ? 0u-a : a;
+    if(!magnitude) return 0;
+    unsigned top=31u-(unsigned)spu_clz32(magnitude);
+    int exponent=(int)top+i8-155+127;
+    if(exponent<=0) return 0;
+    if(exponent>255) return sign|0x7fffffffu;
+    uint32_t sig=top>23 ? magnitude>>(top-23) : magnitude<<(23-top);
+    return sign|((uint32_t)exponent<<23)|(sig&0x7fffffu);
+}
+/* Compare order: denormals equal zero; exponent 255 is an ordinary value. */
