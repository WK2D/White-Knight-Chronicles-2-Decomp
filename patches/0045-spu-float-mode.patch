Add SPU_FLOAT_MODE: SPU single-precision rules (exact) or an audit of
host/SPU differences for FA, FS, FM, FMA, FMS, conversions and compares.

diff --git a/runtime/spu/spu_float_mode.c b/runtime/spu/spu_float_mode.c
new file mode 100644
--- /dev/null
+++ b/runtime/spu/spu_float_mode.c
@@ -0,0 +1,127 @@
+/* spu_float_mode.c — SPU_FLOAT_MODE selection and the non-host paths of the
+ * single-precision helpers (see spu_helpers.h).
+ *
+ * The mode is read once. A port calls spu_float_mode_init() before starting
+ * SPU threads; until then g_spu_float_mode is -1 and the helpers come here,
+ * which initializes it. Audit mode counts lanes whose host result differs
+ * from the SPU result and logs each count that reaches a power of two, with
+ * one sample, so a long run stays readable. "rounding" is a one-unit
+ * difference between two normal results of the same sign; every other
+ * difference is "special".
+ */
+#include "spu_helpers.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+static SRWLOCK s_lock = SRWLOCK_INIT;
+static void mode_lock(void)   { AcquireSRWLockExclusive(&s_lock); }
+static void mode_unlock(void) { ReleaseSRWLockExclusive(&s_lock); }
+static uint64_t count_add(volatile int64_t* c) { return (uint64_t)InterlockedIncrement64(c); }
+#else
+#include <pthread.h>
+static pthread_mutex_t s_mtx = PTHREAD_MUTEX_INITIALIZER;
+static void mode_lock(void)   { pthread_mutex_lock(&s_mtx); }
+static void mode_unlock(void) { pthread_mutex_unlock(&s_mtx); }
+static uint64_t count_add(volatile int64_t* c) { return (uint64_t)__atomic_add_fetch(c, 1, __ATOMIC_RELAXED); }
+#endif
+
+int g_spu_float_mode = -1;
+
+static const char* const s_names[SPU_FOP_COUNT] = {
+    "FA", "FS", "FM", "FMA", "FMS", "CFLTS", "CFLTU", "CSFLT", "CUFLT",
+    "FCEQ", "FCGT", "FCMEQ", "FCMGT",
+};
+static volatile int64_t s_counts[SPU_FOP_COUNT][2];
+
+static void audit_summary(void)
+{
+    fprintf(stderr, "[spu-float] audit summary (lanes differing from SPU results):\n");
+    for (int op = 0; op < SPU_FOP_COUNT; op++)
+        if (s_counts[op][0] || s_counts[op][1])
+            fprintf(stderr, "[spu-float]   %-5s rounding=%lld special=%lld\n", s_names[op],
+                    (long long)s_counts[op][0], (long long)s_counts[op][1]);
+    fflush(stderr);
+}
+
+int spu_float_mode_init(void)
+{
+    mode_lock();
+    if (g_spu_float_mode < 0) {
+        const char* e = getenv("SPU_FLOAT_MODE");
+        int mode = SPU_FLOAT_HOST;
+        if (e && !strcmp(e, "exact")) mode = SPU_FLOAT_EXACT;
+        else if (e && !strcmp(e, "audit")) mode = SPU_FLOAT_AUDIT;
+        if (mode != SPU_FLOAT_HOST)
+            fprintf(stderr, "[spu-float] SPU_FLOAT_MODE=%s\n", mode == SPU_FLOAT_EXACT ? "exact" : "audit");
+        if (mode == SPU_FLOAT_AUDIT) atexit(audit_summary);
+        g_spu_float_mode = mode;
+    }
+    int mode = g_spu_float_mode;
+    mode_unlock();
+    return mode;
+}
+
+uint64_t spu_float_audit_count(int op, int special)
+{
+    if (op < 0 || op >= SPU_FOP_COUNT) return 0;
+    return (uint64_t)s_counts[op][special ? 1 : 0];
+}
+
+static int is_normal(uint32_t x) { uint32_t e = (x >> 23) & 255; return e && e != 255; }
+
+static void audit(int op, uint32_t a, uint32_t b, uint32_t host, uint32_t spu)
+{
+    int float_result = op <= SPU_FOP_FMS || op == SPU_FOP_CSFLT || op == SPU_FOP_CUFLT;
+    uint32_t gap = host > spu ? host - spu : spu - host;
+    int rounding = float_result && is_normal(host) && is_normal(spu) &&
+                   (host >> 31) == (spu >> 31) && gap == 1;
+    uint64_t n = count_add(&s_counts[op][rounding ? 0 : 1]);
+    if (n & (n - 1)) return;
+    mode_lock();
+    fprintf(stderr, "[spu-float] %s %s #%llu: a=%08X b=%08X host=%08X spu=%08X\n",
+            s_names[op], rounding ? "rounding" : "special", (unsigned long long)n,
+            a, b, host, spu);
+    fflush(stderr);
+    mode_unlock();
+}
+
+static int mode(void)
+{
+    int m = g_spu_float_mode;
+    return m >= 0 ? m : spu_float_mode_init();
+}
+
+/* Start from the host lanes; exact replaces them, audit reports differences. */
+#define LANES(OP, HOST, A, B, SPU_EXPR)                                         \
+    u128 r = (HOST);                                                            \
+    int m = mode();                                                             \
+    if (m == SPU_FLOAT_HOST) return r;                                          \
+    for (int i = 0; i < 4; i++) {                                               \
+        uint32_t spu = (SPU_EXPR);                                              \
+        if (m == SPU_FLOAT_EXACT) r._u32[i] = spu;                              \
+        else if (r._u32[i] != spu) audit(OP, (A), (B), r._u32[i], spu);         \
+    }                                                                           \
+    return r
+
+#define MASK(c) ((c) ? 0xFFFFFFFFu : 0u)
+
+u128 spu_fa_mode(const u128* pa, const u128* pb) { u128 a = *pa, b = *pb; LANES(SPU_FOP_FA, spu_fa_host(a, b), a._u32[i], b._u32[i], spu_sf_fused(a._u32[i], 0x3f800000u, b._u32[i], 0, 0)); }
+u128 spu_fs_mode(const u128* pa, const u128* pb) { u128 a = *pa, b = *pb; LANES(SPU_FOP_FS, spu_fs_host(a, b), a._u32[i], b._u32[i], spu_sf_fused(a._u32[i], 0x3f800000u, b._u32[i], 0, 1)); }
+u128 spu_fm_mode(const u128* pa, const u128* pb) { u128 a = *pa, b = *pb; LANES(SPU_FOP_FM, spu_fm_host(a, b), a._u32[i], b._u32[i], spu_sf_fused(a._u32[i], b._u32[i], 0, 0, 0)); }
+u128 spu_fma_mode(const u128* pa, const u128* pb, const u128* pc) { u128 a = *pa, b = *pb, c = *pc; LANES(SPU_FOP_FMA, spu_fma_host(a, b, c), a._u32[i], b._u32[i], spu_sf_fused(a._u32[i], b._u32[i], c._u32[i], 0, 0)); }
+u128 spu_fms_mode(const u128* pa, const u128* pb, const u128* pc) { u128 a = *pa, b = *pb, c = *pc; LANES(SPU_FOP_FMS, spu_fms_host(a, b, c), a._u32[i], b._u32[i], spu_sf_fused(a._u32[i], b._u32[i], c._u32[i], 0, 1)); }
+u128 spu_cflts_mode(const u128* pa, int i8) { u128 a = *pa; LANES(SPU_FOP_CFLTS, spu_cflts_host(a, i8), a._u32[i], (uint32_t)i8, spu_sf_cflt(a._u32[i], i8, 1)); }
+u128 spu_cfltu_mode(const u128* pa, int i8) { u128 a = *pa; LANES(SPU_FOP_CFLTU, spu_cfltu_host(a, i8), a._u32[i], (uint32_t)i8, spu_sf_cflt(a._u32[i], i8, 0)); }
+u128 spu_csflt_mode(const u128* pa, int i8) { u128 a = *pa; LANES(SPU_FOP_CSFLT, spu_csflt_host(a, i8), a._u32[i], (uint32_t)i8, spu_sf_cvflt(a._u32[i], i8, 1)); }
+u128 spu_cuflt_mode(const u128* pa, int i8) { u128 a = *pa; LANES(SPU_FOP_CUFLT, spu_cuflt_host(a, i8), a._u32[i], (uint32_t)i8, spu_sf_cvflt(a._u32[i], i8, 0)); }
+u128 spu_fceq_mode(const u128* pa, const u128* pb) { u128 a = *pa, b = *pb; LANES(SPU_FOP_FCEQ, spu_fceq_host(a, b), a._u32[i], b._u32[i], MASK(spu_sf_order(a._u32[i]) == spu_sf_order(b._u32[i]))); }
+u128 spu_fcgt_mode(const u128* pa, const u128* pb) { u128 a = *pa, b = *pb; LANES(SPU_FOP_FCGT, spu_fcgt_host(a, b), a._u32[i], b._u32[i], MASK(spu_sf_order(a._u32[i]) > spu_sf_order(b._u32[i]))); }
+u128 spu_fcmeq_mode(const u128* pa, const u128* pb) { u128 a = *pa, b = *pb; LANES(SPU_FOP_FCMEQ, spu_fcmeq_host(a, b), a._u32[i], b._u32[i], MASK(spu_sf_magnitude(a._u32[i]) == spu_sf_magnitude(b._u32[i]))); }
+u128 spu_fcmgt_mode(const u128* pa, const u128* pb) { u128 a = *pa, b = *pb; LANES(SPU_FOP_FCMGT, spu_fcmgt_host(a, b), a._u32[i], b._u32[i], MASK(spu_sf_magnitude(a._u32[i]) > spu_sf_magnitude(b._u32[i]))); }
