 static void ts_lock(void)   { while (InterlockedExchange(&s_ts_lock, 1)) Sleep(0); }
 static void ts_unlock(void) { InterlockedExchange(&s_ts_lock, 0); }
 
+/* Host lifetime ownership and SPU reservation ownership protect different
+ * things. Keep the short guest-state transaction under the same lock as
+ * GETLLAR/PUTLLC; never launch/allocate while holding that lock. Callers hold
+ * ts_lock first, and no reservation-locked path acquires the lifetime lock. */
+static void taskset_clear_bits(uint32_t ea, uint32_t task, unsigned fields)
+{
+    extern uint8_t* vm_base;
+    const uint8_t mask = (uint8_t)(0x80u >> (task & 7));
+    spu_lockline_lock();
+    for (unsigned field = 0; field < 3; field++) {
+        if (!(fields & (1u << field))) continue;
+        uint32_t address = ea + 0x10u * (field + 1) + task / 8;
+        uint8_t old = vm_base[address], next = old & (uint8_t)~mask;
+        if (next != old) {
+            vm_base[address] = next;
+            spu_coh_notify_write(address);
+        }
+    }
+    spu_lockline_unlock();
+}
+
 void spu_workload_taskset_create_lock(void) { ts_lock(); }
 void spu_workload_taskset_create_unlock(void) { ts_unlock(); }
