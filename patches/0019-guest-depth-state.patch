new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_depth_state.h
@@ -0,0 +1,17 @@
+/* Guest depth state packed for immutable per-draw pipeline keys. */
+#ifndef RSX_DEPTH_STATE_H
+#define RSX_DEPTH_STATE_H
+#include <stdint.h>
+static inline uint32_t rsx_depth_key(int enable, int write, uint32_t function) {
+    /* GL NEVER..ALWAYS are 0x200..0x207. The state initializer also uses
+     * the corresponding zero-based ordinal (1 = LESS). D3D values are 1..8. */
+    uint32_t f;
+    if (function>=0x200 && function<=0x207) f=function-0x200+1;
+    else if (function<=7) f=function+1;
+    else return 0; /* invalid comparison, never create a misleading pipeline */
+    return (enable ? 1u : 0u) | (write ? 2u : 0u) | (f<<2);
+}
+static inline unsigned rsx_depth_enabled(uint32_t key) { return key&1u; }
+static inline unsigned rsx_depth_writes(uint32_t key) { return (key&3u)==3u; }
+static inline unsigned rsx_depth_comparison(uint32_t key) { return key>>2; }
+#endif
