 /* The same into the whole of a level, from its origin. */
+/* Host counter pixels are original bitmap digits; no game font/assets. */
+static vk_image s_counter_image;
+static int s_counter_ready;
+static double s_counter_epoch, s_counter_fps;
+static u32 s_counter_frames, s_counter_run_count;
+static VkImageBlit s_counter_runs[512];
+static const u8 s_counter_glyphs[13][7] = {
+    {14,17,19,21,25,17,14}, {4,12,4,4,4,4,14}, {14,17,1,2,4,8,31},
+    {30,1,1,14,1,1,30}, {2,6,10,18,31,2,2}, {31,16,16,30,1,1,30},
+    {14,16,16,30,17,17,14}, {31,1,2,4,8,8,8}, {14,17,17,14,17,17,14},
+    {14,17,17,15,1,1,14}, {31,16,16,30,16,16,16}, /* F */
+    {30,17,17,30,16,16,16}, /* P */ {15,16,16,14,1,1,30} /* S */
+};
+static void vk_counter_update(void)
+{
+    const double now = vk_now_ms();
+    if (!s_counter_epoch) { s_counter_epoch = now; s_counter_frames = 0; }
+    if (now-s_counter_epoch >= 1000.0) {
+        s_counter_fps = 1000.0*s_counter_frames/(now-s_counter_epoch);
+        s_counter_epoch = now; s_counter_frames = 0;
+    }
+    ++s_counter_frames;
+    s_counter_ready = 0;
+    if (!s_graphics_enabled || !s_graphics.fps_counter) return;
+    if (!s_counter_image.img) {
+        if (vk_create_image(&s_counter_image,VK_FORMAT_R8G8B8A8_UNORM,128,24,
+            VK_IMAGE_USAGE_TRANSFER_DST_BIT|VK_IMAGE_USAGE_TRANSFER_SRC_BIT|VK_IMAGE_USAGE_SAMPLED_BIT,VK_IMAGE_ASPECT_COLOR_BIT)) return;
+        vk_barrier_image(s_counter_image.img,VK_IMAGE_ASPECT_COLOR_BIT,VK_IMAGE_LAYOUT_UNDEFINED);
+    }
+    u8 pixels[128*24*4];
+    for (u32 i=0;i<128*24;i++) { pixels[i*4]=10; pixels[i*4+1]=18; pixels[i*4+2]=26; pixels[i*4+3]=255; }
+    char label[32]; snprintf(label,sizeof label,"FPS %.1f",s_counter_fps);
+    for (u32 i=0;label[i] && i<10;i++) {
+        int glyph=label[i]>='0' && label[i]<='9' ? label[i]-'0' :
+                  label[i]=='F' ? 10 : label[i]=='P' ? 11 : label[i]=='S' ? 12 : -1;
+        for (u32 y=0;y<7;y++) for (u32 x=0;x<5;x++) {
+            const int lit = glyph>=0 ? (s_counter_glyphs[glyph][y]>>(4-x))&1 :
+                            label[i]=='.' && y==6 && x==2;
+            if (!lit) continue;
+            for (u32 sy=0;sy<2;sy++) for (u32 sx=0;sx<2;sx++) {
+                const u32 at=((y*2+5+sy)*128+(i*12+x*2+4+sx))*4;
+                pixels[at]=pixels[at+1]=pixels[at+2]=240;
+            }
+        }
+    }
+    /* Copy only foreground runs. A full transfer blit cannot alpha blend;
+     * leaving the gaps untouched makes the counter background transparent. */
+    s_counter_run_count=0;
+    for (u32 y=5;y<19;y+=2) for (u32 x=0;x<128;) {
+        if (pixels[(y*128+x)*4]!=240) { ++x;continue; }
+        const u32 first=x;
+        while(x<128 && pixels[(y*128+x)*4]==240) ++x;
+        s_counter_runs[s_counter_run_count++]=(VkImageBlit){
+            .srcSubresource={VK_IMAGE_ASPECT_COLOR_BIT,0,0,1},
+            .srcOffsets={{(int32_t)first,(int32_t)y,0},{(int32_t)x,(int32_t)y+2,1}},
+            .dstSubresource={VK_IMAGE_ASPECT_COLOR_BIT,0,0,1},
+            .dstOffsets={{(int32_t)first,(int32_t)y,0},{(int32_t)x,(int32_t)y+2,1}} };
+    }
+    if (!vk_eng_upload_region(s_counter_image.img,0,0,0,0,128,24,128*4,24,
+        pixels,128*4,VK_IMAGE_ASPECT_COLOR_BIT)) s_counter_ready=1;
+}
+static void vk_counter_blit(VkCommandBuffer cmd,u32 idx)
+{
+    if (!s_counter_ready || !s_counter_image.img || !s_graphics.fps_counter) return;
+    VkImageBlit visible[512];u32 count=0;
+    for(u32 i=0;i<s_counter_run_count;i++) {
+        VkImageBlit r=s_counter_runs[i];
+        if((u32)r.dstOffsets[0].x>=s_vk.sc_extent.width ||
+           (u32)r.dstOffsets[0].y>=s_vk.sc_extent.height) continue;
+        if((u32)r.dstOffsets[1].x>s_vk.sc_extent.width)
+            r.srcOffsets[1].x=r.dstOffsets[1].x=(int32_t)s_vk.sc_extent.width;
+        if((u32)r.dstOffsets[1].y>s_vk.sc_extent.height)
+            r.srcOffsets[1].y=r.dstOffsets[1].y=(int32_t)s_vk.sc_extent.height;
+        visible[count++]=r;
+    }
+    if (!count) return;
+    vk_barrier_image_in(cmd,s_counter_image.img,VK_IMAGE_ASPECT_COLOR_BIT,VK_IMAGE_LAYOUT_GENERAL);
+    pvkCmdBlitImage(cmd,s_counter_image.img,VK_IMAGE_LAYOUT_GENERAL,s_vk.sc_images[idx],
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,count,visible,VK_FILTER_NEAREST);
+}
