+void rsx_vulkan_backend_configure(const rsx_vulkan_graphics_config* config)
+{
+    if (!config || config->window_mode>2 || config->vsync>1 || config->fps_counter>1 ||
+        (config->width && (config->width<320 || config->width>8192)) ||
+        (config->height && (config->height<240 || config->height>8192)) ||
+        (!!config->width != !!config->height) || config->anisotropy>16 ||
+        (config->frame_limit && config->frame_limit!=30 && config->frame_limit!=40 &&
+         config->frame_limit!=60 && config->frame_limit!=120 && config->frame_limit!=144)) return;
+    if (!s_graphics_enabled || memcmp(config,&s_graphics,sizeof *config)) {
+        s_graphics=*config; s_graphics_enabled=1; s_graphics_dirty=1;
+    }
+}
+static void vk_apply_graphics(void)
+{
+    if (!s_graphics_dirty || !s_vk.device || !s_vk.windowed) return;
+    s_graphics_dirty=0;
+    const int window_change=s_graphics.window_mode!=s_graphics_applied.window_mode ||
+        s_graphics.width!=s_graphics_applied.width || s_graphics.height!=s_graphics_applied.height;
+    const int sync_change=s_graphics.vsync!=s_graphics_applied.vsync;
+    const int filter_change=s_graphics.anisotropy!=s_graphics_applied.anisotropy;
+    if(window_change || sync_change || filter_change) {
+        vk_batch_flush(); vk_slot_drain(); pvkDeviceWaitIdle(s_vk.device);
+        if(filter_change) {
+            for(u32 i=0;i<s_esamp_count;i++) pvkDestroySampler(s_vk.device,s_esamp[i].s,NULL);
+            s_esamp_count=0;
+        }
+        if(window_change) {
+            SDL_SetWindowFullscreen(s_vk.window,0);
+            if(s_graphics.window_mode==1) SDL_SetWindowFullscreen(s_vk.window,SDL_WINDOW_FULLSCREEN_DESKTOP);
+            else if(s_graphics.window_mode==2) {
+                SDL_DisplayMode mode={0};mode.w=(int)s_graphics.width;mode.h=(int)s_graphics.height;
+                if(SDL_SetWindowDisplayMode(s_vk.window,&mode) ||
+                   SDL_SetWindowFullscreen(s_vk.window,SDL_WINDOW_FULLSCREEN))
+                    VK_LOG("fullscreen mode failed: %s\n",SDL_GetError());
+            } else if(s_graphics.width && s_graphics.height)
+                SDL_SetWindowSize(s_vk.window,(int)s_graphics.width,(int)s_graphics.height);
+        }
+        if(window_change || sync_change) vk_swapchain_lost();
+    }
+    s_graphics_applied=s_graphics;
+}
