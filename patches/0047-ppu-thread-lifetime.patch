+/* Guest stacks of released threads. The bump allocator never takes memory
+ * back, so without reuse every sys_ppu_thread_create consumed fresh stack
+ * region and a title that keeps starting short-lived threads ran out of it
+ * (ENOMEM) after a few hundred. Take the smallest cached block that fits,
+ * zeroed as a fresh stack would be. Must be called under the table lock. */
+#define PPU_STACK_CACHE_MAX 64
+static struct { uint32_t addr, size; } s_stack_cache[PPU_STACK_CACHE_MAX];
+static int s_stack_cache_n = 0;
+
+static uint32_t stack_take_locked(uint32_t size, uint32_t* block)
+{
+    int best = -1;
+    for (int i = 0; i < s_stack_cache_n; i++)
+        if (s_stack_cache[i].size >= size &&
+            (best < 0 || s_stack_cache[i].size < s_stack_cache[best].size))
+            best = i;
+    if (best < 0) {
+        *block = VM_ALIGN_UP(size, vm_host_page_size());
+        return vm_stack_allocate(&g_vm_stack_alloc, size);
+    }
+    uint32_t addr = s_stack_cache[best].addr;
+    *block = s_stack_cache[best].size;
+    s_stack_cache[best] = s_stack_cache[--s_stack_cache_n];
+    memset(vm_base + addr, 0, *block);
+    return addr;
+}
+
+static void stack_give_locked(uint32_t addr, uint32_t block)
+{
+    if (addr && block && s_stack_cache_n < PPU_STACK_CACHE_MAX) {
+        s_stack_cache[s_stack_cache_n].addr = addr;
+        s_stack_cache[s_stack_cache_n].size = block;
+        s_stack_cache_n++;
+    }
+}
+
+/* Return a finished thread's slot and stack. The host thread must no longer
+ * touch the slot or the guest stack: it has been joined, or this is its own
+ * epilogue with nothing left to do. Under the table lock; the slot can be
+ * reused as soon as the lock is released. */
+static void release_slot_locked(ppu_thread_info* t)
+{
+#ifdef _WIN32
+    if (t->host_thread)  CloseHandle(t->host_thread);
+    if (t->finish_event) CloseHandle(t->finish_event);
+    t->host_thread = NULL;
+    t->finish_event = NULL;
+#else
+    pthread_mutex_destroy(&t->finish_mutex);
+    pthread_cond_destroy(&t->finish_cond);
+#endif
+    stack_give_locked(t->stack_addr, t->stack_block);
+    t->stack_addr = 0;
+    t->stack_block = 0;
+    t->state = PPU_THREAD_STATE_FREE;
+}
+
