+RSX_COMPACT_INLINE const u8* rsx_vertex_batch_source(
+    const rsx_vertex_fetch_plan* plan, const rsx_vertex_fetch_attr* fetch,
+    u32 attr, const rsx_vertex_ref* ref)
+{
+    const u32 element = rsx_vertex_element_index(
+        ref->vertex_id, ref->base_index, fetch->desc.frequency,
+        (plan->divider_mask >> attr) & 1u);
+    if (fetch->stable_base && element >= fetch->stable_first &&
+        element <= fetch->stable_last)
+        return fetch->stable_base +
+            (u64)(element - fetch->stable_first) * fetch->stride;
+    if (plan->inline_data || !plan->guest_ptr)
+        return NULL;
+    const u32 offset = plan->base_offset + fetch->desc.offset +
+        element * fetch->stride;
+    return plan->guest_ptr(plan->guest_user, fetch->desc.location,
+                           offset, fetch->elem_size);
+}
+
+RSX_COMPACT_INLINE int rsx_vertex_batch_column(
+    const rsx_vertex_fetch_plan* plan, const rsx_vertex_ref* refs,
+    u32 count, u8* out, u32 slot, u32 attr, u32 type)
+{
+    const rsx_vertex_fetch_attr* fetch = &plan->attr[attr];
+    for (u32 i = 0; i < count; i++) {
+        float* value = (float*)(out + (size_t)i * plan->layout.stride + slot * 16u);
+        const u8* source = rsx_vertex_batch_source(plan, fetch, attr, &refs[i]);
+        if (source && rsx_vertex_decode_impl(type, fetch->desc.size, source, value))
+            continue;
+        if (attr == 0)
+            return 0;
+        memcpy(value, fetch->default_value, 16);
+    }
+    return 1;
+}
+
+int rsx_vertex_fetch_batch(
+    const rsx_vertex_fetch_plan* plan, const rsx_vertex_ref* refs,
+    u32 count, u8* out)
+{
+    if (!plan || (!refs && count) || (!out && count && plan->layout.stride))
+        return 0;
+    if (!count || !plan->layout.stride)
+        return 1;
+    if (plan->layout.count > RSX_DSP_NUM_VERTEX_ATTR ||
+        plan->layout.stride < plan->layout.count * 16u ||
+        (size_t)count > SIZE_MAX / plan->layout.stride)
+        return 0;
+    for (u32 slot = 0; slot < plan->layout.count; slot++) {
+        const u32 attr = plan->layout.attrs[slot];
+        if (attr >= RSX_DSP_NUM_VERTEX_ATTR)
+            return 0;
+        const rsx_vertex_fetch_attr* fetch = &plan->attr[attr];
+        if (!fetch->desc.type || !fetch->desc.size) {
+            for (u32 i = 0; i < count; i++)
+                memcpy(out + (size_t)i * plan->layout.stride + slot * 16u,
+                       fetch->default_value, 16);
+            continue;
+        }
+        int ok;
+        /* One format dispatch per attribute, outside the vertex/component loops. */
+#define RSX_BATCH_CASE(type) \
+        case type: \
+            ok = rsx_vertex_batch_column(plan, refs, count, out, slot, attr, type); \
+            break
+        switch (fetch->desc.type) {
+            RSX_BATCH_CASE(RSX_VTX_TYPE_FLOAT);
+            RSX_BATCH_CASE(RSX_VTX_TYPE_HALF);
+            RSX_BATCH_CASE(RSX_VTX_TYPE_UNORM8);
+            RSX_BATCH_CASE(RSX_VTX_TYPE_UINT8);
+            RSX_BATCH_CASE(RSX_VTX_TYPE_SNORM16);
+            RSX_BATCH_CASE(RSX_VTX_TYPE_SINT16);
+            RSX_BATCH_CASE(RSX_VTX_TYPE_CMP32);
+        default:
+            if (attr == 0)
+                return 0;
+            for (u32 i = 0; i < count; i++)
+                memcpy(out + (size_t)i * plan->layout.stride + slot * 16u,
+                       fetch->default_value, 16);
+            ok = 1;
+        }
+#undef RSX_BATCH_CASE
+        if (!ok)
+            return 0;
+    }
+    return 1;
+}
+
+#undef RSX_COMPACT_INLINE
+
 static u64 rsx_vertex_remap_hash(u64 value)
 {
     value ^= value >> 33;
