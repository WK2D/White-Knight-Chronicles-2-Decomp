Reuse freed sys_memory ranges while preserving memory-mapper reservations.

diff --git a/runtime/syscalls/sys_memory.c b/runtime/syscalls/sys_memory.c
--- a/runtime/syscalls/sys_memory.c
+++ b/runtime/syscalls/sys_memory.c
@@ -26,6 +26,23 @@
  * the pre-committed main region, so pages are committed on demand. */
 #define SYS_MEM_ALLOC_BASE  0x40000000u
 #define SYS_MEM_ALLOC_END   0x50000000u
+
+/* Mapper reservations use the same window but are not sys_memory allocation
+ * records. Keep their pages unavailable to the reusable-range search. */
+static uint8_t s_mapper_reserved[(SYS_MEM_ALLOC_END - SYS_MEM_ALLOC_BASE) / VM_PAGE_SIZE / 8];
+
+/* Caller holds the bump lock. Shared mappings may lie outside this window. */
+static void reserve_mapper_range(uint32_t address, uint32_t size)
+{
+    uint64_t first = address, end = first + size;
+    if (first < SYS_MEM_ALLOC_BASE) first = SYS_MEM_ALLOC_BASE;
+    if (end > SYS_MEM_ALLOC_END) end = SYS_MEM_ALLOC_END;
+    if (first >= end) return;
+    uint32_t page = (uint32_t)(first - SYS_MEM_ALLOC_BASE) / VM_PAGE_SIZE;
+    uint32_t last = (uint32_t)(end - 1 - SYS_MEM_ALLOC_BASE) / VM_PAGE_SIZE;
+    for (; page <= last; ++page)
+        s_mapper_reserved[page >> 3] |= (uint8_t)(1u << (page & 7));
+}
 
 static uint32_t s_total_allocated = 0;
 static uint32_t s_container_reserved = 0;
