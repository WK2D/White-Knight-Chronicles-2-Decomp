+
+/* Lowest aligned address in the allocation window whose range overlaps no
+ * active allocation, or 0 when none fits. Caller holds the bump lock. */
+static uint32_t find_free_range(uint32_t size, uint32_t alignment)
+{
+    uint64_t candidate = SYS_MEM_ALLOC_BASE;
+    for (;;) {
+        candidate = (candidate + alignment - 1) & ~(uint64_t)(alignment - 1);
+        if (candidate + size > SYS_MEM_ALLOC_END)
+            return 0;
+        uint64_t blocked_until = 0;
+        for (int i = 0; i < SYS_MEMORY_ALLOC_MAX; i++) {
+            const sys_mem_alloc_info* a = &g_sys_mem_allocs[i];
+            if (!a->active) continue;
+            uint64_t start = a->addr, end = (uint64_t)a->addr + a->size;
+            if (start < candidate + size && candidate < end && end > blocked_until)
+                blocked_until = end;
+        }
+        uint32_t first_page = (uint32_t)(candidate - SYS_MEM_ALLOC_BASE) / VM_PAGE_SIZE;
+        uint32_t last_page = (uint32_t)(candidate + size - 1 - SYS_MEM_ALLOC_BASE) / VM_PAGE_SIZE;
+        for (uint32_t page = first_page; page <= last_page; ++page) {
+            if (s_mapper_reserved[page >> 3] & (1u << (page & 7))) {
+                uint64_t end = SYS_MEM_ALLOC_BASE + (uint64_t)(page + 1) * VM_PAGE_SIZE;
+                if (end > blocked_until) blocked_until = end;
+            }
+        }
+        if (!blocked_until)
+            return (uint32_t)candidate;
+        candidate = blocked_until;
+    }
 }
 
