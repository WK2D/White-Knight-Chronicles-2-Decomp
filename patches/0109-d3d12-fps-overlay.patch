diff --git a/libs/video/rsx_present_metrics.h b/libs/video/rsx_present_metrics.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_present_metrics.h
@@ -0,0 +1,45 @@
+#ifndef RSX_PRESENT_METRICS_H
+#define RSX_PRESENT_METRICS_H
+#include <stdint.h>
+#include <string.h>
+
+/* Caller serializes access. Count accepted presentations, not guest updates or
+ * display scanout. Positive status codes (including occlusion) are not frames. */
+typedef struct rsx_present_metrics {
+    uint64_t epoch_ms, last_ms, intervals, maximum_ms;
+    double fps;
+    uint64_t published_maximum_ms;
+    int started;
+} rsx_present_metrics;
+
+static void rsx_present_metrics_record(rsx_present_metrics* m,
+                                      uint64_t now_ms, int32_t result)
+{
+    if (result != 0) return; /* S_OK only */
+    if (!m->started || now_ms < m->last_ms) {
+        memset(m, 0, sizeof(*m));
+        m->started = 1;
+        m->epoch_ms = m->last_ms = now_ms;
+        return;
+    }
+    const uint64_t interval = now_ms - m->last_ms;
+    m->last_ms = now_ms;
+    if (interval > m->maximum_ms) m->maximum_ms = interval;
+    ++m->intervals;
+    const uint64_t elapsed = now_ms - m->epoch_ms;
+    if (elapsed >= 1000) {
+        m->fps = (double)m->intervals * 1000.0 / (double)elapsed;
+        m->published_maximum_ms = m->maximum_ms;
+        m->epoch_ms = now_ms;
+        m->intervals = m->maximum_ms = 0;
+    }
+}
+
+static double rsx_present_metrics_fps(const rsx_present_metrics* m,
+                                     uint64_t now_ms)
+{
+    if (!m->started || now_ms < m->last_ms || now_ms - m->last_ms > 2000)
+        return 0.0;
+    return m->fps;
+}
+#endif
diff --git a/libs/video/rsx_fps_bitmap.h b/libs/video/rsx_fps_bitmap.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_fps_bitmap.h
@@ -0,0 +1,41 @@
+#ifndef RSX_FPS_BITMAP_H
+#define RSX_FPS_BITMAP_H
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define RSX_FPS_BITMAP_WIDTH 128u
+#define RSX_FPS_BITMAP_HEIGHT 16u
+#define RSX_FPS_BITMAP_PITCH (RSX_FPS_BITMAP_WIDTH * 4u)
+/* Original 5x7 bitmap font, enlarged 2x. Only lit texels are composited. */
+static void rsx_fps_bitmap(uint8_t* rgba, double fps)
+{
+    static const uint8_t glyphs[13][7] = {
+        {14,17,19,21,25,17,14}, {4,12,4,4,4,4,14},
+        {14,17,1,2,4,8,31}, {30,1,1,14,1,1,30},
+        {2,6,10,18,31,2,2}, {31,16,16,30,1,1,30},
+        {14,16,16,30,17,17,14}, {31,1,2,4,8,8,8},
+        {14,17,17,14,17,17,14}, {14,17,17,15,1,1,14},
+        {31,16,16,30,16,16,16}, /* F */
+        {30,17,17,30,16,16,16}, /* P */
+        {15,16,16,14,1,1,30}    /* S */
+    };
+    if (!(fps >= 0.0)) fps = 0.0;
+    if (fps > 9999.9) fps = 9999.9;
+    char text[16];
+    snprintf(text, sizeof(text), "FPS %.1f", fps);
+    memset(rgba, 0, RSX_FPS_BITMAP_PITCH * RSX_FPS_BITMAP_HEIGHT);
+    for (unsigned n=0; text[n] && n*12+10<=RSX_FPS_BITMAP_WIDTH; ++n) {
+        const char c=text[n];
+        const int glyph=c>='0' && c<='9' ? c-'0' : c=='F' ? 10 : c=='P' ? 11 : c=='S' ? 12 : -1;
+        for (unsigned y=0; y<7; ++y) for (unsigned x=0; x<5; ++x) {
+            const int lit=glyph>=0 ? ((glyphs[glyph][y]>>(4-x))&1) : c=='.' && y==6 && x==2;
+            if (!lit) continue;
+            for (unsigned dy=0; dy<2; ++dy) for (unsigned dx=0; dx<2; ++dx) {
+                uint8_t* p=rgba+(y*2+dy)*RSX_FPS_BITMAP_PITCH+(n*12+x*2+dx)*4;
+                p[0]=p[1]=p[2]=240; p[3]=255;
+            }
+        }
+    }
+}
+#endif
diff --git a/libs/video/rsx_d3d12_counter.h b/libs/video/rsx_d3d12_counter.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_d3d12_counter.h
@@ -0,0 +1,65 @@
+#ifndef RSX_D3D12_COUNTER_H
+#define RSX_D3D12_COUNTER_H
+#include <d3d12.h>
+#include "rsx_fps_bitmap.h"
+
+typedef struct rsx_d3d12_counter {
+    ID3D12Resource* upload;
+    uint8_t* mapped;
+} rsx_d3d12_counter;
+
+/* Owner must retire all recorded copies before reuse or destruction. The live
+ * renderer waits for its presentation fence before returning from each frame. */
+static void rsx_d3d12_counter_release(rsx_d3d12_counter* c)
+{
+    if (c->upload) {
+        if (c->mapped) c->upload->lpVtbl->Unmap(c->upload, 0, NULL);
+        c->upload->lpVtbl->Release(c->upload);
+    }
+    c->upload=NULL; c->mapped=NULL;
+}
+
+/* Destination must be RGBA8 in COPY_DEST. Off performs no allocation or copy.
+ * Copy foreground spans only: untouched background bytes stay exactly intact,
+ * without a framebuffer readback, alpha pipeline or black rectangle. */
+static HRESULT rsx_d3d12_counter_draw(rsx_d3d12_counter* c, ID3D12Device* device,
+    ID3D12GraphicsCommandList* list, ID3D12Resource* destination,
+    unsigned width, unsigned height, int enabled, double fps)
+{
+    const unsigned origin=8;
+    if (!enabled || width<=origin || height<=origin) return S_OK;
+    if (!c->upload) {
+        D3D12_HEAP_PROPERTIES hp={0}; hp.Type=D3D12_HEAP_TYPE_UPLOAD;
+        D3D12_RESOURCE_DESC desc={0};
+        desc.Dimension=D3D12_RESOURCE_DIMENSION_BUFFER;
+        desc.Width=RSX_FPS_BITMAP_PITCH*RSX_FPS_BITMAP_HEIGHT;
+        desc.Height=1; desc.DepthOrArraySize=1; desc.MipLevels=1;
+        desc.SampleDesc.Count=1; desc.Layout=D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        HRESULT hr=device->lpVtbl->CreateCommittedResource(device,&hp,D3D12_HEAP_FLAG_NONE,
+            &desc,D3D12_RESOURCE_STATE_GENERIC_READ,NULL,&IID_ID3D12Resource,(void**)&c->upload);
+        if (FAILED(hr)) return hr;
+        D3D12_RANGE no_reads={0,0};
+        hr=c->upload->lpVtbl->Map(c->upload,0,&no_reads,(void**)&c->mapped);
+        if (FAILED(hr)) { rsx_d3d12_counter_release(c); return hr; }
+    }
+    rsx_fps_bitmap(c->mapped,fps);
+    D3D12_TEXTURE_COPY_LOCATION src={0}, dst={0};
+    src.pResource=c->upload; src.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    src.PlacedFootprint.Footprint.Format=DXGI_FORMAT_R8G8B8A8_UNORM;
+    src.PlacedFootprint.Footprint.Width=RSX_FPS_BITMAP_WIDTH;
+    src.PlacedFootprint.Footprint.Height=RSX_FPS_BITMAP_HEIGHT;
+    src.PlacedFootprint.Footprint.Depth=1;
+    src.PlacedFootprint.Footprint.RowPitch=RSX_FPS_BITMAP_PITCH;
+    dst.pResource=destination; dst.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    const unsigned w=width-origin<RSX_FPS_BITMAP_WIDTH ? width-origin : RSX_FPS_BITMAP_WIDTH;
+    const unsigned h=height-origin<RSX_FPS_BITMAP_HEIGHT ? height-origin : RSX_FPS_BITMAP_HEIGHT;
+    for (unsigned y=0; y<h; ++y) for (unsigned x=0; x<w;) {
+        if (!c->mapped[y*RSX_FPS_BITMAP_PITCH+x*4+3]) { ++x; continue; }
+        const unsigned begin=x++;
+        while (x<w && c->mapped[y*RSX_FPS_BITMAP_PITCH+x*4+3]) ++x;
+        D3D12_BOX box={begin,y,0,x,y+1,1};
+        list->lpVtbl->CopyTextureRegion(list,&dst,origin+begin,origin+y,0,&src,&box);
+    }
+    return S_OK;
+}
+#endif
