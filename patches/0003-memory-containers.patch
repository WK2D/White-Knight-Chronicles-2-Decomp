-    if (vm_commit(alloc_addr, size) != CELL_OK) {
-        a->active = 0;
-        return (int64_t)(int32_t)CELL_ENOMEM;
-    }
-
-    fprintf(stderr, "[sys_memory] allocate -> 0x%08X\n", alloc_addr);
+    fprintf(stderr, "[sys_memory] allocate(size=0x%X, container=%u) -> 0x%08X\n",
