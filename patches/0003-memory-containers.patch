@@ -134,6 +144,20 @@ int64_t sys_memory_allocate(ppu_context* ctx)
     return CELL_OK;
 }
 
+int64_t sys_memory_allocate(ppu_context* ctx)
+{
+    return allocate_memory(LV2_ARG_U64(ctx, 0), 0,
+        LV2_ARG_U64(ctx, 1), LV2_ARG_PTR(ctx, 2));
+}
+
+int64_t sys_memory_allocate_from_container(ppu_context* ctx)
+{
+    uint32_t cid = LV2_ARG_U32(ctx, 1);
+    if (!cid) return (int64_t)(int32_t)CELL_ESRCH;
+    return allocate_memory(LV2_ARG_U64(ctx, 0), cid,
+        LV2_ARG_U64(ctx, 2), LV2_ARG_PTR(ctx, 3));
+}
+
 /* ---------------------------------------------------------------------------
  * sys_memory_free
  *
@@ -143,14 +167,19 @@ int64_t sys_memory_free(ppu_context* ctx)
 {
     uint32_t addr = LV2_ARG_U32(ctx, 0);
 
+    bump_lock();
     for (int i = 0; i < SYS_MEMORY_ALLOC_MAX; i++) {
         if (g_sys_mem_allocs[i].active && g_sys_mem_allocs[i].addr == addr) {
-            s_total_allocated -= g_sys_mem_allocs[i].size;
+            int32_t cid = g_sys_mem_allocs[i].container_id;
+            if (cid) g_sys_mem_containers[cid - 1].used_size -= g_sys_mem_allocs[i].size;
+            else s_total_allocated -= g_sys_mem_allocs[i].size;
             g_sys_mem_allocs[i].active = 0;
+            bump_unlock();
             return CELL_OK;
         }
     }
 
+    bump_unlock();
     return (int64_t)(int32_t)CELL_EINVAL;
 }
 
@@ -165,10 +194,12 @@ int64_t sys_memory_get_user_memory_size(ppu_context* ctx)
 
     fprintf(stderr, "[sys_memory] get_user_memory_size()\n");
     if (out_addr != 0) {
-        uint32_t total = SYS_MEM_USER_TOTAL;
+        bump_lock();
+        uint32_t total = SYS_MEM_USER_TOTAL - s_container_reserved;
         uint32_t avail = total - s_total_allocated;
         write_be32(out_addr + 0, total);
         write_be32(out_addr + 4, avail);
+        bump_unlock();
     }
 
     return CELL_OK;
@@ -226,24 +257,37 @@ int64_t sys_memory_get_page_attribute(ppu_context* ctx)
 int64_t sys_memory_container_create(ppu_context* ctx)
 {
     uint32_t id_out_addr = LV2_ARG_PTR(ctx, 0);
-    uint32_t size        = LV2_ARG_U32(ctx, 1);
+    uint64_t requested_size = LV2_ARG_U64(ctx, 1) & ~UINT64_C(0xFFFFF);
+    if (!requested_size || requested_size > SYS_MEM_USER_TOTAL)
+        return (int64_t)(int32_t)CELL_ENOMEM;
+    if (!id_out_addr) return (int64_t)(int32_t)CELL_EFAULT;
+    uint32_t size = (uint32_t)requested_size;
+    bump_lock();
+    if (size > SYS_MEM_USER_TOTAL - s_total_allocated - s_container_reserved) {
+        bump_unlock();
+        return (int64_t)(int32_t)CELL_ENOMEM;
+    }
 
     int slot = -1;
     for (int i = 0; i < SYS_MEMORY_CONTAINER_MAX; i++) {
         if (!g_sys_mem_containers[i].active) { slot = i; break; }
     }
-    if (slot < 0)
+    if (slot < 0) {
+        bump_unlock();
         return (int64_t)(int32_t)CELL_EAGAIN;
+    }
 
     sys_mem_container_info* c = &g_sys_mem_containers[slot];
     c->active     = 1;
     c->total_size = size;
     c->used_size  = 0;
+    s_container_reserved += size;
 
     uint32_t container_id = (uint32_t)(slot + 1);
     if (id_out_addr != 0) {
         write_be32(id_out_addr, container_id);
     }
+    bump_unlock();
 
     return CELL_OK;
 }
@@ -261,35 +305,48 @@ int64_t sys_memory_container_destroy(ppu_context* ctx)
         return (int64_t)(int32_t)CELL_ESRCH;
 
     sys_mem_container_info* c = &g_sys_mem_containers[container_id - 1];
-    if (!c->active)
+    bump_lock();
+    if (!c->active) {
+        bump_unlock();
         return (int64_t)(int32_t)CELL_ESRCH;
+    }
+    if (c->used_size) {
+        bump_unlock();
+        return (int64_t)(int32_t)CELL_EBUSY;
+    }
 
+    s_container_reserved -= c->total_size;
     c->active = 0;
+    bump_unlock();
     return CELL_OK;
