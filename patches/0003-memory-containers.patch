-        alignment = 0x10000;  /* 64 KB */
-    }
-
-    size = VM_ALIGN_UP(size, alignment);
-
-    if (size == 0)
+    uint32_t alignment = flags == SYS_MEMORY_PAGE_SIZE_64K ? 0x10000 :
+        (flags == SYS_MEMORY_PAGE_SIZE_1M || flags == 0) ? 0x100000 : 0;
+    if (!alignment)
         return (int64_t)(int32_t)CELL_EINVAL;
+    if (!requested_size || requested_size % alignment)
+        return (int64_t)(int32_t)CELL_EALIGN;
+    if (requested_size > UINT32_MAX)
+        return (int64_t)(int32_t)CELL_ENOMEM;
+    if (!addr_out)
+        return (int64_t)(int32_t)CELL_EFAULT;
+    uint32_t size = (uint32_t)requested_size;
 
     bump_lock();
+    sys_mem_container_info* container = NULL;
+    if (container_id) {
+        if (container_id > SYS_MEMORY_CONTAINER_MAX ||
+            !g_sys_mem_containers[container_id - 1].active) {
+            bump_unlock();
+            return (int64_t)(int32_t)CELL_ESRCH;
+        }
+        container = &g_sys_mem_containers[container_id - 1];
+        if (size > container->total_size - container->used_size) {
+            bump_unlock();
+            return (int64_t)(int32_t)CELL_ENOMEM;
+        }
+    } else if (size > SYS_MEM_USER_TOTAL - s_total_allocated - s_container_reserved) {
+        bump_unlock();
+        return (int64_t)(int32_t)CELL_ENOMEM;
+    }
 
     /* Initialize bump pointer on first call */
     if (g_sys_mem_bump_ptr == 0)
@@ -90,7 +100,7 @@ int64_t sys_memory_allocate(ppu_context* ctx)
     g_sys_mem_bump_ptr = VM_ALIGN_UP(g_sys_mem_bump_ptr, alignment);
 
     /* Check if we have room */
-    if (g_sys_mem_bump_ptr + size > SYS_MEM_ALLOC_END) {
+    if ((uint64_t)g_sys_mem_bump_ptr + size > SYS_MEM_ALLOC_END) {
         bump_unlock();
         return (int64_t)(int32_t)CELL_ENOMEM;
     }
@@ -106,26 +116,26 @@ int64_t sys_memory_allocate(ppu_context* ctx)
     }
 
