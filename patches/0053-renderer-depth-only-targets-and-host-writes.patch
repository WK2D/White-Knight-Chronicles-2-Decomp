+/* Host code on other threads -- a video post-processor converting a frame,
+ * say -- writes guest memory the GPU may hold a surface for. Those writes are
+ * queued here and applied on the engine's thread before its next draw or
+ * present: the overlapping surfaces are reloaded from guest memory. WKC's
+ * cutscene movies land in a buffer it had earlier used as a render target, and
+ * sampling the stale GPU copy through the movie's crossbar showed it red. */
+#define ENG_PENDING_WRITES 64
+static struct {
+    atomic_flag lock;
+    u32 n, dropped;
+    struct { u32 location, offset, bytes; } w[ENG_PENDING_WRITES];
+} s_pending = { ATOMIC_FLAG_INIT };
+
+void rsx_draw_engine_note_host_write(u32 ea, u32 bytes)
+{
+    u32 location, offset;
+    if (!bytes || !cellGcm_ea_to_location(ea, &location, &offset)) return;
+    while (atomic_flag_test_and_set_explicit(&s_pending.lock, memory_order_acquire)) {}
+    if (s_pending.n < ENG_PENDING_WRITES) {
+        s_pending.w[s_pending.n].location = location;
+        s_pending.w[s_pending.n].offset = offset;
+        s_pending.w[s_pending.n].bytes = bytes;
+        s_pending.n++;
+    } else {
+        s_pending.dropped++;
+    }
+    atomic_flag_clear_explicit(&s_pending.lock, memory_order_release);
+}
+
+static void eng_apply_host_writes(void)
+{
+    if (!s_pending.n) return;
+    struct { u32 location, offset, bytes; } w[ENG_PENDING_WRITES];
+    u32 n, dropped;
+    while (atomic_flag_test_and_set_explicit(&s_pending.lock, memory_order_acquire)) {}
+    n = s_pending.n;
+    dropped = s_pending.dropped;
+    memcpy(w, s_pending.w, n * sizeof w[0]);
+    s_pending.n = 0;
+    s_pending.dropped = 0;
+    atomic_flag_clear_explicit(&s_pending.lock, memory_order_release);
+    if (dropped) {
+        static u32 logs;
+        if (logs++ < 8) fprintf(stderr, "[rsx engine] %u host writes overflowed the queue\n", dropped);
+    }
+    for (u32 i = 0; i < n; i++)
+        rsx_draw_engine_guest_buffer_wrote(w[i].location, w[i].offset, w[i].bytes);
+}
