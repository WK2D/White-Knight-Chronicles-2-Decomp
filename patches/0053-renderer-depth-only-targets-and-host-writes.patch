+        dc.n_source_refs, dc.n_cuts, dc.refs_remapped, layout->mask, layout->stride,
+        dc.n_packets, dc.n_arr, dc.n_idx,
+        rsx_dsp_vertex_data_base_index(&g.rsx), rsx_dsp_vertex_data_base_offset(&g.rsx),
+        W, H, vp->scale[0], vp->scale[1], vp->scale[2],
+        vp->translate[0], vp->translate[1], vp->translate[2],
+        rsx_dsp_reg(&g.rsx, 0x0208) & 0x1Fu, rsx_dsp_reg(&g.rsx, 0x0220), g.frames);
+    for (u32 k = 0; k < n_targets && at < sizeof text; k++)
+        at += (size_t)snprintf(text + at, sizeof text - at, "target %u 0x%08X %ux%u\n",
+                               g.surfaces[targets[k]].location, g.surfaces[targets[k]].offset,
+                               g.surfaces[targets[k]].w, g.surfaces[targets[k]].h);
+    if (zslot != ENG_INVALID && at < sizeof text)
+        at += (size_t)snprintf(text + at, sizeof text - at, "zeta 0x%08X\n",
+                               g.zdepths[zslot].offset);
+    for (u32 a = 0; a < RSX_DSP_NUM_VERTEX_ATTR && at < sizeof text; a++)
+        at += (size_t)snprintf(text + at, sizeof text - at, "attr %u fmt %08X off %08X\n",
+                               a, rsx_dsp_reg(&g.rsx, 0x1740u + a * 4u),
+                               rsx_dsp_reg(&g.rsx, 0x1680u + a * 4u));
