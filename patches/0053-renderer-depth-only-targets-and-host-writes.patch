+/* RSX_ENGINE_DRAW_CAPTURE=<existing dir>: while <dir>/arm exists, every draw
+ * of the next whole frame is written as <dir>/cNN_dNNNN.{txt,verts,cb,idx,refs}
+ * -- its state, the fetched float4 vertices in layout order, the transform
+ * constant block as bound, the rebuilt triangle-list indices and each unique
+ * vertex's guest index -- then <dir>/arm is removed. Pair the pipeline number
+ * with RSX_ENGINE_SHADER_DUMP's pipe<N>.vs.hlsl to replay a draw offline. */
+static struct {
+    int state;              /* 0 unread, 1 idle, 2 capturing, 3 off */
+    const char* dir;
+    u32 capture, draws;
+    time_t polled;
+} s_dcap;
+
+/* RSX_ENGINE_RED_TRIGGER=<existing dir>: keep the text half of the draw
+ * capture for every draw of the frame in memory; at present, read back a
+ * 16x16 patch of the presented surface and, when it is strongly red, write
+ * that frame's draw log and the presented image to the directory (bounded). */
+static struct { int on; const char* dir; char* log; size_t len, cap; u32 hits; } s_red;
+
+static void red_log(const char* text, size_t n)
+{
+    if (s_red.len + n + 1 > s_red.cap) {
+        size_t next = s_red.cap ? s_red.cap * 2 : (1u << 20);
+        while (next < s_red.len + n + 1) next *= 2;
+        char* m = (char*)realloc(s_red.log, next);
+        if (!m) return;
+        s_red.log = m; s_red.cap = next;
+    }
+    memcpy(s_red.log + s_red.len, text, n);
+    s_red.len += n;
+    s_red.log[s_red.len] = 0;
+}
+
+static void red_present(u32 target)
+{
+    if (!s_red.on) {
+        s_red.dir = getenv("RSX_ENGINE_RED_TRIGGER");
+        s_red.on = (s_red.dir && *s_red.dir) ? 1 : -1;
+    }
+    if (s_red.on < 0) return;
+    const eng_surface* s = &g.surfaces[target];
+    if (s_red.hits < 6 && s->fmt == RSX_BE_FMT_R8G8B8A8 && s->w >= 64 && s->h >= 64 &&
+        g.be->readback) {
+        u8 px[16 * 16 * 4];
+        eng_sync(6);
+        g.be->readback(g.be->user, s->handle, s->w / 5, s->h / 2, 16, 16, px, 16 * 4);
+        u32 r = 0, gg = 0, b = 0;
+        for (u32 i = 0; i < 256; i++) { r += px[i * 4]; gg += px[i * 4 + 1]; b += px[i * 4 + 2]; }
+        r /= 256; gg /= 256; b /= 256;
+        if (r > 170 && gg < 120 && b < 120) {
+            char path[1024];
+            snprintf(path, sizeof path, "%s/red_%u.txt", s_red.dir, g.frames);
+            FILE* f = fopen(path, "wb");
+            if (f) {
+                fprintf(f, "frame %u presented surface %u 0x%08X %ux%u patch %u %u %u\n",
+                        g.frames, target, s->offset, s->w, s->h, r, gg, b);
+                for (u32 i = 0; i < g.n_surfaces; i++)
+                    fprintf(f, "surface %u loc %u 0x%08X %ux%u fmt %d serial %llu\n", i,
+                            g.surfaces[i].location, g.surfaces[i].offset, g.surfaces[i].w,
+                            g.surfaces[i].h, (int)g.surfaces[i].fmt,
+                            (unsigned long long)g.surfaces[i].color_serial);
+                /* Each tracked surface's centre pixels as the GPU holds them and
+                 * as guest memory holds them, to show which copy is current. */
+                for (u32 i = 0; i < g.n_surfaces; i++) {
+                    const eng_surface* q = &g.surfaces[i];
+                    if (!q->handle || q->fmt != RSX_BE_FMT_R8G8B8A8 || q->location > 1) continue;
+                    u8 gpu[4 * 4];
+                    g.be->readback(g.be->user, q->handle, q->w / 2, q->h / 2, 4, 1, gpu, 16);
+                    const u8* mem = eng_guest_ptr(NULL, q->location,
+                                                  q->offset + (q->h / 2) * q->pitch + (q->w / 2) * 4, 16);
+                    fprintf(f, "pixels surface %u 0x%08X gpu", i, q->offset);
+                    for (u32 k = 0; k < 16; k++) fprintf(f, "%s%02X", (k & 3) ? "" : " ", gpu[k]);
+                    fprintf(f, " guest");
+                    for (u32 k = 0; k < 16; k++) fprintf(f, "%s%02X", (k & 3) ? "" : " ", mem ? mem[k] : 0);
+                    fprintf(f, " dirty %d\n", q->guest_dirty);
+                }
+                if (s_red.log) fputs(s_red.log, f);
+                fclose(f);
+            }
+            snprintf(path, sizeof path, "%s/red_%u.ppm", s_red.dir, g.frames);
+            pd_write_surface(target, path);
+            fprintf(stderr, "[rsx engine] red frame %u captured\n", g.frames);
+            s_red.hits++;
+        }
+    }
+    s_red.len = 0;
+    if (s_red.log) s_red.log[0] = 0;
+}
+
+static void dcap_present(void)
+{
+    if (s_dcap.state == 0) {
+        s_dcap.dir = getenv("RSX_ENGINE_DRAW_CAPTURE");
+        s_dcap.state = (s_dcap.dir && *s_dcap.dir) ? 1 : 3;
+    }
+    if (s_dcap.state == 3) return;
+    char path[1024];
+    snprintf(path, sizeof path, "%s/arm", s_dcap.dir);
+    if (s_dcap.state == 2) {
+        fprintf(stderr, "[rsx engine] draw capture %u: %u draws\n", s_dcap.capture, s_dcap.draws);
+        remove(path);
+        s_dcap.capture++;
+        s_dcap.state = 1;
+        return;
+    }
+    const time_t now = time(NULL);
+    if (now == s_dcap.polled) return;
+    s_dcap.polled = now;
+    FILE* f = fopen(path, "rb");
+    if (!f) return;
+    fclose(f);
+    s_dcap.draws = 0;
+    s_dcap.state = 2;
+}
+
+static void dcap_write(const char* ext, const void* data, size_t bytes)
+{
+    char path[1024];
+    snprintf(path, sizeof path, "%s/c%02u_d%04u.%s", s_dcap.dir, s_dcap.capture,
+             s_dcap.draws, ext);
+    FILE* f = fopen(path, "wb");
+    if (!f) return;
+    if (bytes) fwrite(data, 1, bytes, f);
+    fclose(f);
+}
+
+static void dcap_draw(u32 prim, u32 pipeline, int indexed, u32 n_draw,
+                      const rsx_vertex_layout_plan* layout, const u32* targets,
+                      u32 n_targets, u32 zslot, const rsx_dsp_viewport* vp,
