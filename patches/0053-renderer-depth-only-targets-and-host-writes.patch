+static void test_depth_only_target(void)
+{
+    printf("-- depth-only target\n");
+    engine_up();
+    m(M_COLOR_TARGET, 1u);                    /* explicit target A */
+    draw_triangle();
+    const u32 surface = stub.last_created_color;
+    const int creates = stub.n_color_create, releases = stub.n_color_release;
+
+    m(M_COLOR_TARGET, 0u);                    /* NONE */
+    m(M_SURFACE_CLIP_H, 512u << 16);
+    m(M_SURFACE_CLIP_V, 512u << 16);
+    draw_triangle();
+    CHECK(stub.n_color_release == releases && stub.alive[surface],
+          "a depth-only pass leaves the surface at its colour offset alive");
+    CHECK(stub.n_color_create == creates + 1 && stub.bound_rt[0] != surface,
+          "and draws into a separate scratch target");
