+
+static int eng_buffer_overlaps(const eng_surface* s, u32 location, u32 offset, u32 bytes)
+{
+    return s->handle && s->location == location && bytes &&
+           (u64)offset < (u64)s->offset + (u64)s->pitch * s->h &&
+           (u64)offset + bytes > s->offset;
+}
+
+int rsx_draw_engine_guest_buffer_read(u32 location, u32 offset, u32 bytes)
+{
+    if (!g.ready || !bytes) return 1;
+    eng_resolves_sync(location, offset, bytes);
+    for (u32 i=0; i<g.n_surfaces; i++)
+        if (eng_buffer_overlaps(&g.surfaces[i], location, offset, bytes)) {
+            const eng_surface* s=&g.surfaces[i];
+            if (s->fmt != RSX_BE_FMT_R8G8B8A8 || s->pitch < s->w*4u ||
+                !g.be->readback || !g.be->color_target_write || !eng_surface_to_guest(i)) return 0;
+        }
+    return 1;
+}
+
+void rsx_draw_engine_guest_buffer_wrote(u32 location, u32 offset, u32 bytes)
+{
+    if (!g.ready || !bytes) return;
+    for (u32 i=0; i<g.n_surfaces; i++)
+        if (eng_buffer_overlaps(&g.surfaces[i], location, offset, bytes)) {
+            eng_surface* s=&g.surfaces[i];
+            if (s->fmt == RSX_BE_FMT_R8G8B8A8 && s->pitch >= s->w*4u) {
+                rsx_draw_engine_guest_wrote(location, s->offset, s->pitch, s->w, s->h);
+                s->guest_dirty=0;
+            }
+        }
+    eng_textures_rehash(location, offset, bytes);
 }
 
