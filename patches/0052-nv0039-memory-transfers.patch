 static void gcm_2d_method(u32 subch, u32 method, u32 data)
 {
+    if (subch == 1) {
+        switch (method) {
+        case 0x0000: case 0x0180: return; /* object / notification DMA binding */
+        case 0x0184: s_nv0039.src_dma=data; return;
+        case 0x0188: s_nv0039.dst_dma=data; return;
+        case 0x030C: s_nv0039.src=data; return;
+        case 0x0310: s_nv0039.dst=data; return;
+        case 0x0314: s_nv0039.src_pitch=data; return;
+        case 0x0318: s_nv0039.dst_pitch=data; return;
+        case 0x031C: s_nv0039.columns=data; return;
+        case 0x0320: s_nv0039.rows=data; return;
+        case 0x0324: s_nv0039.format=data; return;
+        case 0x0328: nv0039_copy(data); return;
+        default: nv0039_reject("unknown subchannel-1 method"); return;
+        }
+    }
