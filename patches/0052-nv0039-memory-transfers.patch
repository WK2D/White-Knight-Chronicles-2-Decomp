+
+/* NV0039 memory-to-memory transfers. The FORMAT bytes are column increments,
+ * not pixel formats: one byte is copied at each increment. Row pitches are
+ * signed, and zero repeats the row. Keep these semantics separate from the
+ * NV3089 image sampler. No RSX instruction or game code is interpreted here. */
+static struct {
+    u32 src_dma, dst_dma, src, dst, src_pitch, dst_pitch, columns, rows, format;
+} s_nv0039;
+static u64 s_nv0039_copies, s_nv0039_bytes, s_nv0039_rejected, s_nv0039_verify_errors;
+
+static void nv0039_reject(const char* reason)
+{
+    if (++s_nv0039_rejected <= 8 || !(s_nv0039_rejected & (s_nv0039_rejected - 1)))
+        fprintf(stderr, "[NV0039] rejected=%llu reason=%s\n",
+                (unsigned long long)s_nv0039_rejected, reason);
+}
+
+static u32 nv0039_ea(u32 dma, u32 offset)
+{
+    /* Do not use the renderer's ambiguous LOCAL fallback for unmapped MAIN. */
+    if (dma == 0xFEED0001u) return gcm_io2ea(offset);
+    return s_config.localAddress + offset;
+}
+
+static int nv0039_span(u32 dma, int64_t offset, u64 bytes)
+{
+    const u64 limit = dma == 0x66626660u ? (u64)CELL_GCM_MAX_REPORT_COUNT * 16u
+                    : dma == 0xFEED0000u ? s_config.localSize : 0x100000000ull;
+    if (offset < 0 || (u64)offset >= limit || bytes > limit - (u64)offset) return 0;
+    if (dma == 0x66626660u) return 1;
+    extern u32 ppu_vm_size;
+    const u64 vm_limit = ppu_vm_size ? ppu_vm_size : 0x100000000ull;
+    if (dma == 0xFEED0000u && (u64)s_config.localAddress + (u64)offset + bytes > vm_limit) return 0;
+    const u64 end = (u64)offset + bytes;
+    for (u64 at = (u64)offset; at < end;) {
+        u64 chunk = 0x100000u - (at & 0xFFFFFu);
+        if (chunk > end - at) chunk = end - at;
+        const u32 ea = nv0039_ea(dma, (u32)at);
+        if (!ea || (u64)ea + chunk > vm_limit) return 0;
+        at += chunk;
+    }
+    return 1;
+}
+
+static u8 nv0039_read(u32 dma, u32 offset)
+{
+    if (dma != 0x66626660u) return vm_read8(nv0039_ea(dma, offset));
+    /* Host report records must be exposed as their big-endian guest bytes. */
+    const CellGcmReportData* r = &s_report_data[offset / 16u];
+    const u32 byte = offset % 16u;
+    if (byte < 8) return (u8)(r->timestamp >> (56u - byte * 8u));
+    return byte < 12 ? (u8)(r->value >> (24u - (byte - 8u) * 8u)) : 0;
+}
+
+static void nv0039_copy(u32 notify)
+{
+    const u32 columns=s_nv0039.columns, rows=s_nv0039.rows;
+    const u32 si=s_nv0039.format & 255u, di=(s_nv0039.format >> 8) & 255u;
+    const int64_t sp=(int32_t)s_nv0039.src_pitch, dp=(int32_t)s_nv0039.dst_pitch;
+    if (!columns || !rows) return;
+    /* Bound staging and work if a malformed FIFO is decoded as a copy. */
+    const u64 count=(u64)columns * rows;
+    if (count > 0x4000000ull) { nv0039_reject("transfer exceeds 64 MiB"); return; }
+    if ((si != 1 && si != 2 && si != 4) || (di != 1 && di != 2 && di != 4) ||
+        (s_nv0039.format & 0xFFFF0000u)) { nv0039_reject("unsupported byte stride"); return; }
+    if ((s_nv0039.src_dma != 0xFEED0000u && s_nv0039.src_dma != 0xFEED0001u && s_nv0039.src_dma != 0x66626660u) ||
+        (s_nv0039.dst_dma != 0xFEED0000u && s_nv0039.dst_dma != 0xFEED0001u)) {
+        nv0039_reject("unsupported DMA object"); return;
+    }
+    if (notify != 0) { nv0039_reject("notification mode not implemented"); return; }
+    const u64 sw=(u64)(columns-1)*si+1, dw=(u64)(columns-1)*di+1;
+    /* Validate every page of every row before any coherence operation or write.
+     * MAIN pages need not be contiguous in guest effective-address space. */
+    for (u32 y=0; y<rows; y++)
+        if (!nv0039_span(s_nv0039.src_dma, (int64_t)s_nv0039.src+sp*y, sw) ||
+            !nv0039_span(s_nv0039.dst_dma, (int64_t)s_nv0039.dst+dp*y, dw)) {
+            nv0039_reject("unmapped or overflowing range"); return;
+        }
+    u8* snapshot=(u8*)malloc((size_t)count);
+    if (!snapshot) { nv0039_reject("staging allocation failed"); return; }
+    const u32 sl=s_nv0039.src_dma == 0xFEED0001u ? RSX_LOCATION_MAIN : RSX_LOCATION_LOCAL;
+    const u32 dl=s_nv0039.dst_dma == 0xFEED0001u ? RSX_LOCATION_MAIN : RSX_LOCATION_LOCAL;
+    if (rsx_draw_engine_enabled()) {
+        for (u32 y=0; y<rows; y++) {
+            if ((s_nv0039.src_dma != 0x66626660u &&
+                 !rsx_draw_engine_guest_buffer_read(sl, (u32)((int64_t)s_nv0039.src+sp*y), (u32)sw)) ||
+                !rsx_draw_engine_guest_buffer_read(dl, (u32)((int64_t)s_nv0039.dst+dp*y), (u32)dw)) {
+                free(snapshot); nv0039_reject("unsupported GPU surface readback"); return;
+            }
+        }
+    }
+    /* Snapshot the whole source before any write, including overlapping rows. */
+    for (u32 y=0; y<rows; y++)
+        for (u32 x=0; x<columns; x++)
+            snapshot[(size_t)y*columns+x]=nv0039_read(s_nv0039.src_dma,
+                (u32)((int64_t)s_nv0039.src+sp*y+(u64)x*si));
+    static int verify=-1;
+    if (verify < 0) { const char* e=getenv("GCM_M2MF_VERIFY"); verify=e && atoi(e); }
+    for (u32 y=0; y<rows; y++) {
+        const u32 row=(u32)((int64_t)s_nv0039.dst+dp*y);
+        for (u32 x=0; x<columns; x++) {
+            const u32 ea=nv0039_ea(s_nv0039.dst_dma, row+x*di);
+            vm_write8(ea, snapshot[(size_t)y*columns+x]);
+            if (g_resv_store_active > 0) ppu_resv_break_store(ea);
+        }
+        if (verify)
+            for (u32 x=0; x<columns; x++)
+                if (vm_read8(nv0039_ea(s_nv0039.dst_dma, row+x*di)) != snapshot[(size_t)y*columns+x]) {
+                    ++s_nv0039_verify_errors;
+                    if (s_nv0039_verify_errors <= 8 || !(s_nv0039_verify_errors & (s_nv0039_verify_errors-1)))
+                        fprintf(stderr, "[NV0039] verification mismatch errors=%llu\n",
+                            (unsigned long long)s_nv0039_verify_errors);
+                }
+    }
+    if (rsx_draw_engine_enabled())
+        for (u32 y=0; y<rows; y++)
+            rsx_draw_engine_guest_buffer_wrote(dl, (u32)((int64_t)s_nv0039.dst+dp*y), (u32)dw);
+    free(snapshot);
+    s_nv0039_bytes += count;
+    ++s_nv0039_copies;
+    if (s_nv0039_copies <= 8 || !(s_nv0039_copies & (s_nv0039_copies-1)))
+        fprintf(stderr, "[NV0039] copies=%llu bytes=%llu columns=%u rows=%u verify=%d errors=%llu\n",
+            (unsigned long long)s_nv0039_copies, (unsigned long long)s_nv0039_bytes,
+            columns, rows, verify, (unsigned long long)s_nv0039_verify_errors);
+}
