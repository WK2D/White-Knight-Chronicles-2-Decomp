+/* Changing a texture from raw depth to comparison sampling changes HLSL,
+ * so the shadow mask belongs in the real pipeline key. The comparison op
+ * itself belongs in the sampler and must not multiply shader variants. */
+static void test_depth_comparison_pipeline_key(void)
+{
+    printf("-- depth comparison shader and sampler identity\n");
+    engine_up();
+    rsx_draw_backend backend = g_stub_backend;
+    backend.depth_compare = 1;
+    rsx_draw_engine_set_backend(&backend);
+    u8 vp[16], fp[16];
+    rsx_test_vp_mov_out(vp, 0, RSX_TEST_VP_SWZ_IDENT, 0, 1);
+    m(0x1E9Cu, 0u);
+    for (u32 i = 0; i < 4; i++) {
+        u32 word; memcpy(&word, vp + 4u * i, 4);
+        m(0x0B80u + 4u * i, word);
+    }
+    m(0x1EA0u, 0u);
+    rsx_test_fp_instr(fp, RSX_TEST_FP_OPC(RSX_TEST_FP_OP_TEX) |
+        RSX_TEST_FP_MASK_XYZW | RSX_TEST_FP_INSRC_TC0 | RSX_TEST_FP_END,
+        RSX_TEST_FP_SRC_INPUT | RSX_TEST_FP_SWZ_IDENT);
+    memcpy(vm_base + 0x300000u, fp, sizeof fp);
+    m(0x08E4u, 0x300002u); /* main-memory program */
+    m(0x1D60u, 0x40u);
+    bind_texture_unit(RSX_LOCATION_MAIN, TEX_OFFSET);
+    m(M_TEX_UNIT + 0x04, 2u | (2u << 4) | (0xB0u << 8) | (1u << 16));
+    m(M_TEX_UNIT + 0x08, 0u);
+    draw_triangle();
+    const u32 raw = stub.bound_pipeline;
+    CHECK(raw && !stub.pipeline_shadow[raw] && !stub.bound_compare,
+          "ZFUNC NEVER retains raw depth sampling");
+    const int count = stub.n_pipeline_create;
+    m(M_TEX_UNIT + 0x08, 1u << 28);
+    draw_triangle();
+    const u32 compared = stub.bound_pipeline;
+    CHECK(compared != raw && stub.n_pipeline_create == count + 1 &&
+          stub.pipeline_shadow[compared] && stub.bound_compare == 1u &&
+          stub.bound_mask == 1u && stub.bound_tex[0] != 0,
+          "ZFUNC LESS selects a comparison shader and sampler");
+    m(M_TEX_UNIT + 0x08, 3u << 28);
+    draw_triangle();
+    CHECK(stub.bound_pipeline == compared && stub.n_pipeline_create == count + 1 &&
+          stub.bound_compare == 3u, "comparison function changes only sampler state");
+    m(M_TEX_UNIT + 0x08, 7u << 28);
+    draw_triangle();
+    CHECK(stub.bound_pipeline == raw && !stub.bound_compare,
+          "ZFUNC ALWAYS reuses the raw-depth shader");
+    m(M_TEX_UNIT + 0x08, 1u << 28);
+    m(M_TEX_UNIT + 0x0C, 0x80000004u);
+    draw_triangle();
+    CHECK(stub.bound_pipeline == raw && !stub.bound_compare,
+          "texture alpha kill disables depth comparison");
+    m(M_TEX_UNIT + 0x0C, 0x80000000u);
+    m(M_TEX_UNIT + 0x04, 2u | (2u << 4) | (0xA5u << 8) | (1u << 16));
+    draw_triangle();
+    CHECK(stub.bound_pipeline == raw && !stub.bound_compare,
+          "a color texture with ZFUNC LESS remains an ordinary sample");
+    m(M_TEX_UNIT + 0x04, 2u | (2u << 4) | (0xB0u << 8) | (1u << 16));
+    m(M_TEX_UNIT + 0x04, 2u | (2u << 4) | (0xB0u << 8) | (2u << 16));
+    draw_triangle();
+    CHECK(stub.bound_pipeline == raw && !stub.bound_compare,
+          "multiple mip levels retain the legacy path instead of forcing TXB/TXL to level zero");
+    m(M_TEX_UNIT + 0x04, 2u | (2u << 4) | (0xB0u << 8) | (1u << 16));
+    backend.depth_compare = 0;
+    draw_triangle();
+    CHECK(stub.bound_pipeline == raw && !stub.bound_compare,
+          "a backend without depth-comparison capability retains its old shader path");
+    backend.depth_compare = 1;
+    u8 mixed[48];
+    rsx_test_fp_instr(mixed, RSX_TEST_FP_OPC(RSX_TEST_FP_OP_TEX) |
+        RSX_TEST_FP_MASK_XYZW | RSX_TEST_FP_OUTREG(1) |
+        RSX_TEST_FP_INSRC_TC0 | RSX_TEST_FP_TEXU(3),
+        RSX_TEST_FP_SRC_INPUT | RSX_TEST_FP_SWZ_IDENT);
+    rsx_test_fp_instr(mixed + 16, RSX_TEST_FP_OPC(RSX_TEST_FP_OP_TEX) |
+        RSX_TEST_FP_MASK_XYZW | RSX_TEST_FP_INSRC_TC0 | RSX_TEST_FP_TEXU(4),
+        RSX_TEST_FP_SRC_INPUT | RSX_TEST_FP_SWZ_IDENT);
