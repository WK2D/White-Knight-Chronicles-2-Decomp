+/* Depth texture ZFUNC 1..6 requests a comparison, not a raw depth fetch.
+ * NEVER/ALWAYS are the RSX raw-depth modes; alpha kill disables comparison.
+ * This path is opt-in per backend because a color R32 snapshot cannot be
+ * used as a Vulkan comparison image. */
+static u32 eng_shadow_mask(void)
+{
+    if (!g.be->depth_compare) return 0;
+    u32 mask = 0;
+    for (u32 u = 0; u < RSX_DSP_NUM_TEXTURES; u++) {
+        rsx_dsp_texture t;
+        rsx_dsp_get_texture(&g.rsx, u, &t);
+        const u32 fmt = t.format & RSX_TEX_FMT_BASE_MASK;
+        const u32 cmp = (t.wrap >> 28) & 0xFu;
+        if (t.enabled && t.dimension == 2u && !t.cubemap && t.mipmaps <= 1u &&
+            (fmt == RSX_TEX_FMT_DEPTH24_D8 || fmt == 0x92u) &&
+            !(t.control0 & 4u) && cmp >= 1u && cmp <= 6u)
+            mask |= 1u << u;
     }
     return mask;
 }
