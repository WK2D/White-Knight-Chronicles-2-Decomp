--- /dev/null
+++ b/runtime/ppu/guest_callback_stack.hpp
@@ -0,0 +1,39 @@
+/* Each host callback thread needs distinct guest stack memory. A TLS variable
+ * containing the same constant address does not provide that isolation.
+ * Slots are returned when the host thread exits; nested callbacks use a separate
+ * 64 KiB slice within their thread's 1 MiB slot. This range is outside WKC2's
+ * mapped heaps and below the normal PPU thread-stack region.
+ */
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+
+namespace ps3recomp {
+class GuestCallbackStack {
+    struct Pool { std::mutex mutex; std::array<bool,128> used{}; };
+    static Pool& pool() { static Pool value; return value; }
+    struct Lease {
+        unsigned slot=128;
+        Lease() {
+            auto& p=pool(); std::lock_guard l(p.mutex);
+            for(unsigned i=0;i<p.used.size();++i) if(!p.used[i]) {p.used[i]=true; slot=i; break;}
+            if(slot==128) {std::fputs("[ppu] guest callback stack pool exhausted\n",stderr); std::abort();}
+        }
+        ~Lease() {auto& p=pool(); std::lock_guard l(p.mutex); p.used[slot]=false;}
+    };
+    static Lease& lease() {static thread_local Lease value; return value;}
+    static unsigned& depth() {static thread_local unsigned value=0; return value;}
+public:
+    const uint32_t top;
+    GuestCallbackStack():top(0xCFFF0000u-lease().slot*0x100000u-depth()*0x10000u) {
+        if(depth()>=16) {std::fputs("[ppu] guest callback nesting exceeds stack slot\n",stderr); std::abort();}
+        ++depth();
+    }
+    ~GuestCallbackStack() {--depth();}
+    GuestCallbackStack(const GuestCallbackStack&)=delete;
+    GuestCallbackStack& operator=(const GuestCallbackStack&)=delete;
+};
+}
