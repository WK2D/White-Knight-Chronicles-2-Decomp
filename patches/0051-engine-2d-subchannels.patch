     return handle;
 }
 
@@ -526,6 +529,33 @@ static void test_surface_aliasing(void)
     engine_down();
 }
 
+/* libgcm's 2D objects sit on other subchannels, at offsets NV4097 uses for
+ * state: NV3089 SET_OPERATION and IMAGE_OUT_POINT are the alpha-test and
+ * blend enables, NV3062 SET_PITCH and NV308A POINT the alpha-test enable. A
+ * blit or inline transfer between two draws must not change the second. */
+static void test_2d_subchannels(void)
+{
+    printf("-- 2D object subchannels\n");
+    engine_up();
+    m(M_COLOR_A_OFFSET, 0x90000u);
+    m(0x0310u, 1u);                        /* NV4097 SET_BLEND_ENABLE */
+    draw_triangle();
+    CHECK(stub.pipeline_blend[stub.bound_pipeline] == 1 &&
+          stub.pipeline_alpha_test[stub.bound_pipeline] == 0,
+          "subchannel 0 sets the 3D state");
+    m(0xC304u, 3u);                        /* NV3089 SET_OPERATION: SRCCOPY */
+    m(0xC310u, 0u);                        /* NV3089 IMAGE_OUT_POINT */
+    m(0x6304u, (128u << 16) | 128u);       /* NV3062 SET_PITCH */
+    m(0xA304u, 1u);                        /* NV308A POINT */
+    draw_triangle();
+    CHECK(stub.n_draw == 2 && stub.pipeline_blend[stub.bound_pipeline] == 1 &&
+          stub.pipeline_alpha_test[stub.bound_pipeline] == 0,
+          "2D-object methods leave blending and alpha test (blend %u, alpha test %u)",
+          stub.pipeline_blend[stub.bound_pipeline],
+          stub.pipeline_alpha_test[stub.bound_pipeline]);
+    engine_down();
+}
+
 /* A backend with GPU copies must preserve the pixels before the consuming
  * draw, rather than read stale guest bytes or bind an attachment as a texture. */
 static void test_surface_feedback(void)
@@ -1276,6 +1306,7 @@ int main(void)
 
     test_surface_set();
     test_surface_aliasing();
+    test_2d_subchannels();
     test_surface_feedback();
     test_mrt_set();
     test_texture_cache();
