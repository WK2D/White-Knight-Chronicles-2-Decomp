+#ifdef _WIN32
+static SRWLOCK s_pad_lock = SRWLOCK_INIT;
+static void pad_lock(void) { AcquireSRWLockExclusive(&s_pad_lock); }
+static void pad_unlock(void) { ReleaseSRWLockExclusive(&s_pad_lock); }
+#else
+#include <pthread.h>
+static pthread_mutex_t s_pad_lock = PTHREAD_MUTEX_INITIALIZER;
+static void pad_lock(void) { pthread_mutex_lock(&s_pad_lock); }
+static void pad_unlock(void) { pthread_mutex_unlock(&s_pad_lock); }
+#endif
