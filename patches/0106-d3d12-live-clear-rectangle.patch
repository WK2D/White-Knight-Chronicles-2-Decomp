diff --git a/libs/video/rsx_d3d12_clear.h b/libs/video/rsx_d3d12_clear.h
--- a/libs/video/rsx_d3d12_clear.h
+++ b/libs/video/rsx_d3d12_clear.h
@@ -19,6 +19,16 @@
     if (y >= surface_h) c.h=0;
     else if (h > surface_h-y) c.h=surface_h-y;
     return c;
+}
+/* Live NV4097 clear inputs. Zero is an explicit near-depth value, not an
+ * uninitialized sentinel; the dispatcher supplies the hardware reset value. */
+static inline rsx_surface_clear rsx_d3d12_clear_from_registers(uint32_t flags,
+    uint32_t zstencil, uint32_t horizontal, uint32_t vertical,
+    uint32_t surface_w, uint32_t surface_h)
+{
+    return rsx_surface_clear_make(flags, (float)(zstencil >> 8) / 16777215.0f,
+        (uint8_t)zstencil, horizontal & 0xffffu, vertical & 0xffffu,
+        horizontal >> 16, vertical >> 16, surface_w, surface_h);
 }
 static inline int rsx_clear_rect(const rsx_surface_clear* c,
     uint32_t w, uint32_t h, D3D12_RECT* r)
