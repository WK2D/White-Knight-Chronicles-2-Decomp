 /* ===========================================================================
  * Channel write
  * ===========================================================================*/
+void spu_wrch(spu_context* ctx, uint32_t channel, u128 value);
+/* One MFC request from native code: the five parameter channels, then the
+ * command through spu_wrch, exactly as six channel writes would make it. */
+void spu_mfc_issue(spu_context* ctx, uint32_t lsa, uint32_t ea, uint32_t size,
+                   uint32_t tag, uint32_t cmd)
+{
+    ctx->mfc_lsa = lsa; ctx->mfc_eah = 0; ctx->mfc_eal = ea;
+    ctx->mfc_size = size; ctx->mfc_tag = tag & 0x1F;
+    u128 c = {0};
+    c._u32[0] = cmd;
+    spu_wrch(ctx, MFC_Cmd, c);
+}
+
 void spu_wrch(spu_context* ctx, uint32_t channel, u128 value)
 {
     /* SPU_CHHIST=1: which channels a job actually touches, and how often. A
@@ -784,6 +797,17 @@ void spu_wrch(spu_context* ctx, uint32_t channel, u128 value)
                   fprintf(stderr, "   wrch ch%-3d %llu%c", i, w[i], 10); } } }
     uint32_t v = value._u32[0];  /* channel writes use the preferred slot */
 
+    /* The five MFC parameter channels are plain stores (mfc_channel_write);
+     * every DMA writes all of them, so take them before anything else. */
+    if (!wkc_ab_mfc_old()) switch (channel) {
+    case MFC_LSA:   ctx->mfc_lsa = v; return;
+    case MFC_EAH:   ctx->mfc_eah = v; return;
+    case MFC_EAL:   ctx->mfc_eal = v; return;
+    case MFC_Size:  ctx->mfc_size = v; return;
+    case MFC_TagID: ctx->mfc_tag = v & 0x1F; return;
+    default: break;
+    }
+
     if (channel_is_mfc(channel)) {
         /* Atomic line ops (GETLLAR/PUTLLC/...) need real reservation semantics,
          * not the plain GET/PUT the DMA engine would do. */
