diff --git a/include/ps3emu/wkc_ab.h b/include/ps3emu/wkc_ab.h
index 7a24379..ee283a8 100644
--- a/include/ps3emu/wkc_ab.h
+++ b/include/ps3emu/wkc_ab.h
@@ -5,6 +5,7 @@
  * Nonzero while the change under test is switched off; it stays 0 in play. */
 #ifndef WKC_AB_H
 #define WKC_AB_H
+#include <stdlib.h>
 /* C linkage from both languages: main.cpp sets it, the C runtime reads it. */
 #ifdef __cplusplus
 extern "C" {
@@ -14,6 +15,14 @@ __declspec(selectany) volatile int g_wkc_ab_off = 0;
 #else
 __attribute__((weak)) volatile int g_wkc_ab_off = 0;
 #endif
+/* WKC_AB_MFC (private A/B): the SPU transfer path's old per-transfer work while
+ * the gate is off. */
+static inline int wkc_ab_mfc_old(void)
+{
+    static int ab = -1;
+    if (ab < 0) ab = getenv("WKC_AB_MFC") != 0;
+    return ab && g_wkc_ab_off;
+}
 #ifdef __cplusplus
 }
 #endif
