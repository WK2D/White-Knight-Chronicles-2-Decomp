Cut per-job host overhead on SPURS job chains. Cache job-image
fingerprints per (address, size) behind a 33-word sample check instead of
hashing up to 67 KB per dispatch; build each job directly in its context's
local store and retain a copy only after a title polls a chain handle;
compute FI's power-of-two scale from exponent bits (bit-identical to the
ldexpf form). Adds RSX_VK_PRESENT_MODE (mailbox/immediate) and an average
present GPU wait to RSX_ENGINE_PRESENT_LOG.

diff --git a/runtime/spu/spu_workload.c b/runtime/spu/spu_workload.c
--- a/runtime/spu/spu_workload.c
+++ b/runtime/spu/spu_workload.c
@@ -27,15 +27,59 @@
 
 /* ---- fingerprint ------------------------------------------------------- */
 
-uint64_t spu_workload_fingerprint(const void* data, size_t n)
-{
-    const uint8_t* p = (const uint8_t*)data;
+#ifdef _WIN32
+#  define SPU_FP_THREAD_LOCAL __declspec(thread)
+#else
+#  define SPU_FP_THREAD_LOCAL __thread
+#endif
+
+static uint64_t spu_workload_fingerprint_full(const uint8_t* p, size_t n)
+{
     uint64_t h = 1469598103934665603ULL;          /* FNV offset basis */
     for (size_t i = 0; i < n; i++) {
         h ^= p[i];
         h *= 1099511628211ULL;                     /* FNV prime */
     }
     return h;
+}
+
+/* A cheap summary of the bytes: 32 words spread over the image plus its last
+ * word and length. Only used to confirm a cached full fingerprint. */
+static uint64_t spu_workload_fingerprint_sample(const uint8_t* p, size_t n)
+{
+    uint64_t h = 1469598103934665603ULL ^ (uint64_t)n;
+    if (n >= 8) {
+        for (size_t k = 0; k < 32; k++) {
+            uint64_t w;
+            memcpy(&w, p + (n - 8) * k / 31, 8);
+            h = (h ^ w) * 1099511628211ULL;
+        }
+    } else {
+        for (size_t i = 0; i < n; i++) h = (h ^ p[i]) * 1099511628211ULL;
+    }
+    return h;
+}
+
+/* The full byte-wise hash of a 67 KB job binary costs ~0.1 ms, and job chains
+ * dispatch the same binaries thousands of times a second; in WKC1's town that
+ * made one chain thread spend about a third of its time hashing. Job images
+ * stay at fixed addresses, so remember the fingerprint per (address, size)
+ * and reuse it while a 33-word sample of the bytes is unchanged; a different
+ * image at the same address changes the sample and is hashed in full. One
+ * small cache per thread, so dispatching threads never contend. */
+uint64_t spu_workload_fingerprint(const void* data, size_t n)
+{
+    const uint8_t* p = (const uint8_t*)data;
+    if (n < 4096) return spu_workload_fingerprint_full(p, n);
+    static SPU_FP_THREAD_LOCAL struct { const void* data; size_t n; uint64_t sample, fp; } cache[32];
+    const size_t slot = ((uintptr_t)data >> 4) & 31u;
+    const uint64_t sample = spu_workload_fingerprint_sample(p, n);
+    if (cache[slot].data == data && cache[slot].n == n && cache[slot].sample == sample)
+        return cache[slot].fp;
+    const uint64_t fp = spu_workload_fingerprint_full(p, n);
+    cache[slot].data = data; cache[slot].n = n;
+    cache[slot].sample = sample; cache[slot].fp = fp;
+    return fp;
 }
 
 /* ---- registry ---------------------------------------------------------- */
diff --git a/runtime/spu/spu_helpers.h b/runtime/spu/spu_helpers.h
--- a/runtime/spu/spu_helpers.h
+++ b/runtime/spu/spu_helpers.h
@@ -119,6 +119,17 @@
 static inline u128 spu_sfx(u128 a, u128 b, u128 t) { u128 r; for(int i=0;i<4;i++) r._u32[i]=b._u32[i]+~a._u32[i]+(t._u32[i]&1u); return r; }
 /* FI decodes the base and step fields produced by the hardware estimate
  * instructions; its second operand is not an ordinary reciprocal float. */
+/* 2^e as a float, built from its bits while it is representable. Scaling an
+ * integer by it is one correctly rounded multiply -- the result ldexpf gives
+ * -- without ldexpf's library call, which FI made hot in WKC1's Edge jobs. */
+static inline float spu_pow2f(int e) {
+    uint32_t bits;
+    if (e >= -126 && e <= 127) bits = (uint32_t)(e + 127) << 23;
+    else if (e >= -149 && e < -126) bits = 1u << (e + 149);
+    else return ldexpf(1.0f, e);
+    float f; memcpy(&f, &bits, sizeof f);
+    return f;
+}
 static inline u128 spu_fi(u128 a, u128 b) {
     u128 r;
     for (int i = 0; i < 4; i++) {
@@ -128,9 +139,11 @@
         uint32_t base_bits = rb & 0xFFFFFC00u;
         float base; memcpy(&base, &base_bits, sizeof base);
         uint32_t step_frac = rb & 0x3FFu;
-        float step = ldexpf((float)step_frac, (int)exp - 127 - 13);
+        const int e = (int)exp - 127 - 13;
+        float step = (e >= -149 && e <= 127) ? (float)step_frac * spu_pow2f(e)
+                                             : ldexpf((float)step_frac, e);
         if (base < 0.0f) step = -step;
-        float y = ldexpf((float)(ra & 0x7FFFFu), -19);
+        float y = (float)(ra & 0x7FFFFu) * (1.0f / 524288.0f);   /* exact: 2^-19 */
         r._f32[i] = base - step * y;
     }
     return r;
