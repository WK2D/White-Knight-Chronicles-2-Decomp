+/* Depth-byte conversion may replace only the CPU decoder's equivalent
+ * one-level linear 2D layout. Exercise real texture routing through draws. */
+static int zconv_calls, zconv_fail;
+static u32 stub_depth_to_argb8(void* user, u32 snapshot, u32 w, u32 h,
+                               u32 remap, u32 format)
+{
+    (void)user; (void)snapshot; (void)w; (void)h; (void)remap; (void)format;
+    ++zconv_calls;
+    return zconv_fail ? 0 : stub_handle();
+}
+
+static void test_depth_conversion_layout(u32 format, u32 dimension, u32 levels,
+                                        u32 pitch, u32 depth, int cube,
+                                        u32 remap, u32 width, int fail,
+                                        int eligible, const char* label)
+{
+    engine_up();
+    m(M_SURFACE_CLIP_H, 1280u << 16);
+    m(M_SURFACE_CLIP_V, 720u << 16);
+    rsx_draw_backend backend = g_stub_backend;
+    backend.depth_to_argb8 = stub_depth_to_argb8;
+    rsx_draw_engine_set_backend(&backend);
+    m(M_CONTEXT_DMA_ZETA, DMA_LOCAL);
+    m(M_SURFACE_FORMAT, 8u | (2u << 5));
+    m(M_ZETA_OFFSET, ZETA_OFFSET);
+    m(M_ZETA_PITCH, 1280u * 4u);
+    m(M_COLOR_A_OFFSET, ZETA_OFFSET);
+    m(M_COLOR_MASK, 0u);
+    m(M_DEPTH_TEST, 1u);
+    m(M_DEPTH_WRITE, 1u);
+    draw_triangle();
+    m(M_COLOR_MASK, 0x01010101u);
+    m(M_DEPTH_TEST, 0u);
+    m(M_DEPTH_WRITE, 0u);
+    m(M_COLOR_A_OFFSET, 0x90000u);
+    bind_texture_unit(RSX_LOCATION_LOCAL, ZETA_OFFSET);
+    m(M_TEX_UNIT + 0x04, 1u | (dimension << 4) | (format << 8) |
+                            (levels << 16) | (cube ? 4u : 0u));
+    m(M_TEX_UNIT + 0x10, remap);
+    m(M_TEX_UNIT + 0x18, (width << 16) | 720u);
+    m(0x1840u, (depth << 20) | pitch);
+    zconv_calls = 0;
+    zconv_fail = fail;
+    draw_triangle();
+    CHECK(zconv_calls == eligible, "%s: GPU conversion eligibility (%d)", label, zconv_calls);
+    CHECK(stub.n_depth_readback == (!eligible || fail),
+          "%s: incompatible/failed conversion retains CPU fallback (%d)", label, stub.n_depth_readback);
+    engine_down();
+}
+
+static void test_depth_conversion_layouts(void)
+{
+    test_depth_conversion_layout(0xA5u,2,1,5120,1,0,0xAAE4u,1280,0,1,"matching linear 2D");
+    test_depth_conversion_layout(0xA5u,2,1,0,0,0,0xAAE4u,1280,0,1,"implicit tight pitch");
+    test_depth_conversion_layout(0xE5u,2,1,5120,1,0,0xAAE4u,1280,0,1,"unnormalized coordinates");
+    test_depth_conversion_layout(0xA5u,2,1,5120,1,0,0xAAE4u,1280,1,1,"backend failure");
+    test_depth_conversion_layout(0x85u,2,1,5120,1,0,0xAAE4u,1280,0,0,"swizzled bytes");
+    test_depth_conversion_layout(0xA5u,2,2,5120,1,0,0xAAE4u,1280,0,0,"mip chain");
+    test_depth_conversion_layout(0xA5u,2,1,10240,1,0,0xAAE4u,1280,0,0,"different row pitch");
+    test_depth_conversion_layout(0xA5u,2,1,2560,1,0,0xAAE4u,1280,0,0,"short row pitch");
+    test_depth_conversion_layout(0xA5u,1,1,5120,1,0,0xAAE4u,1280,0,0,"one-dimensional image");
+    test_depth_conversion_layout(0xA5u,3,1,5120,2,0,0xAAE4u,1280,0,0,"three-dimensional image");
+    test_depth_conversion_layout(0xA5u,2,1,5120,2,0,0xAAE4u,1280,0,0,"depth slices");
+    test_depth_conversion_layout(0xA5u,2,1,5120,1,1,0xAAE4u,1280,0,0,"cube image");
+    test_depth_conversion_layout(0xA5u,2,1,5120,1,0,0xA9E4u,1280,0,0,"different remap");
+    test_depth_conversion_layout(0xA5u,2,1,5120,1,0,0xAAE4u,640,0,0,"different dimensions");
+}
