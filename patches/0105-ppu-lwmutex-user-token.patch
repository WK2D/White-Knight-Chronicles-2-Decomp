+#ifndef PS3RECOMP_PPU_LWMUTEX_TOKEN_H
+#define PS3RECOMP_PPU_LWMUTEX_TOKEN_H
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+struct PpuLwmutexToken {
+    std::atomic<unsigned> free{1};
+    std::atomic<unsigned> waiters{0};
+    std::mutex sleep_mutex;
+    std::condition_variable changed;
+
+    bool try_acquire() {
+        unsigned expected = 1;
+        return free.compare_exchange_strong(expected, 0);
+    }
+    bool acquire(std::uint32_t milliseconds) {
+        const bool infinite = milliseconds == UINT32_MAX;
+        const auto deadline = std::chrono::steady_clock::now() +
+            std::chrono::milliseconds(milliseconds);
+        std::unique_lock<std::mutex> guard(sleep_mutex);
+        struct Registration {
+            std::atomic<unsigned>& count;
+            explicit Registration(std::atomic<unsigned>& value) : count(value) { count.fetch_add(1); }
+            ~Registration() { count.fetch_sub(1); }
+        } registration(waiters);
+        bool acquired = false;
+        for (;;) {
+            if (try_acquire()) { acquired = true; break; }
+            if (infinite) changed.wait(guard);
+            else {
+                if (std::chrono::steady_clock::now() >= deadline) break;
+                changed.wait_until(guard, deadline);
+            }
+        }
+        return acquired;
+    }
+    void release() {
+        // Sequentially consistent count/waiter operations pair the final try
+        // with the release-side check: both cannot miss each other. Locking
+        // the sleep mutex closes the interval between that try and cv.wait.
+        free.exchange(1);
+        if (waiters.load()) {
+            std::lock_guard<std::mutex> guard(sleep_mutex);
+            changed.notify_one();
+        }
+    }
+};
+#endif
