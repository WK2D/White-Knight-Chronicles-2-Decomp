diff --git a/libs/video/rsx_index_assembly.h b/libs/video/rsx_index_assembly.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_index_assembly.h
@@ -0,0 +1,40 @@
+#ifndef RSX_INDEX_ASSEMBLY_H
+#define RSX_INDEX_ASSEMBLY_H
+#include <stdint.h>
+
+/* Keep this cursor across contiguous packets in a single BEGIN/END stream.
+ * Restart markers terminate the current primitive and never name a vertex. */
+typedef struct rsx_index_assembly {
+    uint32_t previous[2];
+    unsigned have;
+    unsigned odd;
+} rsx_index_assembly;
+
+static inline void rsx_index_assembly_reset(rsx_index_assembly* s) {
+    s->have = 0;
+    s->odd = 0;
+}
+
+/* Returns one triangle, or zero while collecting a new strip/fan. The full
+ * restart value is compared: a value above 0xffff cannot match a u16 index. */
+static inline int rsx_index_assembly_push(rsx_index_assembly* s, uint32_t index,
+        int fan, int restart_enabled, uint32_t restart, uint32_t triangle[3]) {
+    if (restart_enabled && index == restart) {
+        rsx_index_assembly_reset(s);
+        return 0;
+    }
+    if (s->have < 2) {
+        s->previous[s->have++] = index;
+        return 0;
+    }
+    triangle[0] = s->previous[!fan && s->odd ? 1 : 0];
+    triangle[1] = s->previous[!fan && s->odd ? 0 : 1];
+    triangle[2] = index;
+    if (!fan) {
+        s->previous[0] = s->previous[1];
+        s->odd ^= 1;
+    }
+    s->previous[1] = index;
+    return 1;
+}
+#endif
