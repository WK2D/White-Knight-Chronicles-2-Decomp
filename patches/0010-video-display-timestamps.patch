+/* Timestamp only the first coded AU, then check the decoded display order. */
+static void take_timed_pictures(u32 h, u32 rate_num, u32 rate_den, int* count, int* bframes)
+{
+    while (cellVdecGetPicItem(h, (const CellVdecPicItem**)(uintptr_t)G_ITEMPTR) == CELL_OK) {
+        u32 it = vm_read32(G_ITEMPTR), info = vm_read32(it + 0x48);
+        u64 pts = vm_read64(it + 0x10);
+        CHECK(pts == 90000 + (u64)*count * 90000 * rate_den / rate_num);
+        CHECK(vm_read8(info + 5) != 0 && vm_read8(info + 0x14) == 3);
+        *bframes += vm_read8(info + 0x12) == 3;
+        set_format(3, 0, 255);
+        CHECK(cellVdecGetPicture(h, (const void*)(uintptr_t)G_FMT, (void*)(uintptr_t)G_PIC) == CELL_OK);
+        ++*count;
+    }
+}
+static int mode_timing(int argc, char** argv)
+{
+    CHECK(argc == 5);
+    size_t len; u8* es = read_file(argv[2], &len);
+    split(es, len, 0);
+    u32 rate_num = (u32)atoi(argv[3]), rate_den = (u32)atoi(argv[4]);
+    u32 h = open_decoder(CELL_VDEC_CODEC_TYPE_MPEG2);
+    if (!s_vdec[h].ff) return 77;
+    for (int pass = 0; pass < 2; ++pass) {
+        int count = 0, bframes = 0;
+        CHECK(cellVdecStartSeq(h) == CELL_OK);
+        for (int i = 0; i < s_nau; ++i) {
+            u32 size = (u32)(s_au_off[i + 1] - s_au_off[i]);
+            memcpy(vm_base + G_AU, es + s_au_off[i], size);
+            vm_write32(G_AUINFO, G_AU); vm_write32(G_AUINFO + 4, size);
+            vm_write64(G_AUINFO + 8, i ? UINT64_MAX : 90000);
+            vm_write64(G_AUINFO + 16, UINT64_MAX);
+            vm_write64(G_AUINFO + 24, 0xABCD0000ull + i);
+            CHECK(cellVdecDecodeAu(h, 0, (const CellVdecAuInfo*)(uintptr_t)G_AUINFO) == CELL_OK);
+            take_timed_pictures(h, rate_num, rate_den, &count, &bframes);
+        }
+        CHECK(cellVdecEndSeq(h) == CELL_OK);
+        take_timed_pictures(h, rate_num, rate_den, &count, &bframes);
+        CHECK(count == s_nau && bframes > 0);
+        printf("sparse timing pass %d: %d pictures, %d B-frames\n", pass, count, bframes);
+    }
+    CHECK(cellVdecClose(h) == CELL_OK); free(es); return 0;
+}
+
