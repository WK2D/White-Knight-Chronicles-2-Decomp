+    s_vk.title_frequency = SDL_GetPerformanceFrequency();
+    if (s_vk.title_frequency) {
+        char caption[sizeof s_vk.window_title + 96];
+        snprintf(caption, sizeof caption, "%s | FPS: -- | max: -- ms", s_vk.window_title);
+        SDL_SetWindowTitle(s_vk.window, caption);
     }
     unsigned n = 0;
     if (!SDL_Vulkan_GetInstanceExtensions(s_vk.window, &n, NULL) || n == 0 || n > 16 ||
@@ -2020,6 +2071,7 @@
         .swapchainCount = 1, .pSwapchains = &s_vk.swapchain, .pImageIndices = &idx,
     };
     const VkResult r = pvkQueuePresentKHR(s_vk.queue, &pi);
+    if (r == VK_SUCCESS || r == VK_SUBOPTIMAL_KHR) vk_window_title_presented();
