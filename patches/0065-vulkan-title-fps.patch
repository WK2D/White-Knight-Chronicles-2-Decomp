Show live Vulkan presentation FPS and the largest interval between accepted
presentation-call completions in the SDL window title. Refresh after about
one second using SDL's monotonic high-resolution clock. Count VK_SUCCESS and
VK_SUBOPTIMAL_KHR, exclude failed/acquire-only/readback/guest-tick paths, and
reset the window-owned counters when opening or dropping a window. Keep the
existing title as a bounded base and add no worker threads or log files.

diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -213,6 +213,10 @@
     u32              max_dim;         /* maxImageDimension2D of the device  */
     int              windowed;
     SDL_Window*      window;
+    char             window_title[512]; /* immutable base for the FPS suffix */
+    Uint64           title_frequency, title_epoch, title_last;
+    Uint64           title_frames, title_max_interval;
+    int              title_started;
     const char*      inst_exts[16];
     u32              inst_ext_count;
     VkSurfaceKHR     surface;
@@ -1752,6 +1756,44 @@
     return v && v[0] && v[0] != '0';
 }
 
+/* These counters belong to the window, not a guest tick or a readback.
+ * WKC2 creates, presents and pumps this window on the same render thread.
+ * Count only accepted vkQueuePresentKHR completions; this measures host
+ * presentation-call pacing, not scanout timing or input/GPU latency. */
+static void vk_window_title_reset(void)
+{
+    s_vk.window_title[0] = '\0';
+    s_vk.title_frequency = s_vk.title_epoch = s_vk.title_last = 0;
+    s_vk.title_frames = s_vk.title_max_interval = 0;
+    s_vk.title_started = 0;
+}
+
+static void vk_window_title_presented(void)
+{
+    if (!s_vk.window || !s_vk.title_frequency) return;
+    const Uint64 now = SDL_GetPerformanceCounter();
+    if (!s_vk.title_started || now < s_vk.title_last) {
+        s_vk.title_epoch = s_vk.title_last = now;
+        s_vk.title_frames = s_vk.title_max_interval = 0;
+        s_vk.title_started = 1;
+        return;
+    }
+    const Uint64 interval = now - s_vk.title_last;
+    s_vk.title_last = now;
+    if (interval > s_vk.title_max_interval) s_vk.title_max_interval = interval;
+    ++s_vk.title_frames;
+    const Uint64 elapsed = now - s_vk.title_epoch;
+    if (elapsed >= s_vk.title_frequency) {
+        const double fps = (double)s_vk.title_frames * (double)s_vk.title_frequency / (double)elapsed;
+        const double worst_ms = 1000.0 * (double)s_vk.title_max_interval / (double)s_vk.title_frequency;
+        char title[sizeof s_vk.window_title + 96];
+        snprintf(title, sizeof title, "%s | FPS: %.1f | max: %.1f ms", s_vk.window_title, fps, worst_ms);
+        SDL_SetWindowTitle(s_vk.window, title);
+        s_vk.title_epoch = now;
+        s_vk.title_frames = s_vk.title_max_interval = 0;
+    }
+}
+
 static void vk_window_drop(const char* why)
 {
     if (why) VK_LOG("window disabled, continuing headless: %s\n", why);
