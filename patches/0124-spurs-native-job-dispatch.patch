                       uint32_t job_ea, uint32_t job_desc_size);
 
+/* Optional whole-job dispatch binding, installed before worker dispatch starts
+ * and kept stable until all job-chain workers have stopped. The exact registered
+ * image fingerprint has already matched when these callbacks run; no job input
+ * has been staged and no lifted game routine has executed yet.
+ *
+ * Scope begin/end must be installed together. A native hook requires both.
+ * begin returns a port-owned opaque token (NULL is allowed for an uninterested
+ * image); end is called exactly once after native completion/failure OR after
+ * a declined native attempt's lifted fallback returns. The port must serialize
+ * every user of the same allocator slot, including native and fallback paths.
+ * In this SPURS constructor the virtual slot is0, shared across host chains.
+ *
+ * Callbacks must not throw, longjmp out, unregister themselves or stop dispatch
+ * ownership before end. begin owns any blocking/lease acquisition. Native
+ * DECLINED means no external write or queued operation was committed. FATAL
+ * means failure after which fallback must not run. Any other hook result is
+ * treated as FATAL. COMPLETED is the same synchronous chain success as the
+ * lifted runner returning0; the port owns required visibility/completion.
+ */
+enum {
+    SPU_NATIVE_JOB_FATAL = -1,
+    SPU_NATIVE_JOB_DECLINED = 0,
+    SPU_NATIVE_JOB_COMPLETED = 1
+};
+typedef int (*spu_native_job_hook_fn)(int image_id, uint32_t job_ea,
+                                      uint32_t job_desc_size);
+typedef void* (*spu_job_scope_begin_fn)(int image_id, uint32_t job_ea,
+                                        uint32_t job_desc_size);
+typedef void (*spu_job_scope_end_fn)(int image_id, uint32_t job_ea,
+                                     uint32_t job_desc_size, void* token);
+extern spu_native_job_hook_fn g_spu_native_job_hook;
+extern spu_job_scope_begin_fn g_spu_job_scope_begin;
+extern spu_job_scope_end_fn g_spu_job_scope_end;
+
