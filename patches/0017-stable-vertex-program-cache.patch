+/* Stable vertex-program IDs for deferred draws. Entries live until shutdown. */
+#ifndef RSX_VP_CACHE_H
+#define RSX_VP_CACHE_H
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <limits.h>
+typedef struct {
+    uint32_t hash, bytes;
+    uint8_t* ucode;
+    void* vs;
+    int uses_c03;
+} rsx_vp_cache_entry;
+typedef struct {
+    rsx_vp_cache_entry* entries;
+    int count;
+    size_t capacity;
+} rsx_vp_cache;
+static inline int rsx_vp_cache_find(const rsx_vp_cache* c, uint32_t hash,
+                                   const uint8_t* code, uint32_t bytes) {
+    if (!code || !bytes) return -1;
+    for (int i=0; i<c->count; ++i)
+        if (c->entries[i].hash==hash && c->entries[i].bytes==bytes &&
+            memcmp(c->entries[i].ucode,code,bytes)==0) return i;
+    return -1;
+}
+static inline int rsx_vp_cache_add(rsx_vp_cache* c, uint32_t hash,
+                                  const uint8_t* code, uint32_t bytes,
+                                  void* compiled, int uses_c03) {
+    if (!code || !bytes || !compiled || c->count==INT_MAX) return -1;
+    uint8_t* copy=(uint8_t*)malloc(bytes);
+    if (!copy) return -1;
+    memcpy(copy,code,bytes);
+    if ((size_t)c->count==c->capacity) {
+        size_t cap=c->capacity ? c->capacity*2 : 16;
+        if (cap<c->capacity || cap>SIZE_MAX/sizeof(*c->entries)) { free(copy);return -1; }
+        void* grown=realloc(c->entries,cap*sizeof(*c->entries));
+        if (!grown) { free(copy);return -1; }
+        c->entries=(rsx_vp_cache_entry*)grown;c->capacity=cap;
+    }
+    int id=c->count++;
+    c->entries[id]=(rsx_vp_cache_entry){hash,bytes,copy,compiled,uses_c03};
+    return id;
+}
+static inline void rsx_vp_cache_clear(rsx_vp_cache* c, void (*release)(void*)) {
+    for (int i=0; i<c->count; ++i) {
+        if (release) release(c->entries[i].vs);
+        free(c->entries[i].ucode);
+    }
+    free(c->entries);memset(c,0,sizeof(*c));
+}
+#endif
