+/* A completed SPU PUT can resume an exact self-JUMP producer wait. The
+ * sequentially consistent arm followed by a command reread closes the race
+ * where the producer writes between the walker's first read and registration.
+ * Zero means the renderer is not waiting on a producer word. */
+/* Publish address and expected word together: a producer must never pair
+ * an old address with a different park's expected command. */
+static atomic_ullong s_gcm_producer_park_descriptor;
+/* Optional host-only aggregate observations, enabled by GCM_PRODUCER_PROFILE.
+ * These contain no command bytes or guest addresses and perform no logging. */
+atomic_ullong g_gcm_producer_park_count;
+atomic_ullong g_gcm_producer_overlap_wake_count;
+atomic_ullong g_gcm_producer_unchanged_overlap_count;
+atomic_ullong g_gcm_producer_retry_count;
+static int s_gcm_producer_profile;
+static int gcm_producer_arm(u32 ea, u32 word);
+static void gcm_producer_put_completed(u32 ea, u32 size);
 
 static int  s_gcm_initialized = 0;
 static u32  s_flip_mode   = CELL_GCM_DISPLAY_VSYNC;
