+}
 void* cellGcm_fifo_kick_event(void)
 {
-    if (!s_gcm_kick_ev) s_gcm_kick_ev = CreateEventA(NULL, FALSE, FALSE, NULL);
-    return (void*)s_gcm_kick_ev;
+    if (!InitOnceExecuteOnce(&s_gcm_kick_once, gcm_kick_init, NULL, NULL))
+        return NULL;
+    return (void*)atomic_load(&s_gcm_kick_ev);
+}
+
+static int gcm_producer_arm(u32 ea, u32 word)
+{
+    /* Event creation/configuration completes before the parked EA is visible
+     * to a producer. The atomic arm includes a StoreLoad barrier. */
+    if (!cellGcm_fifo_kick_event()) return 1;
+    atomic_store(&s_gcm_producer_park_descriptor, ((u64)word << 32) | ea);
+    if (s_gcm_producer_profile)
+        atomic_fetch_add(&g_gcm_producer_park_count, 1);
+#ifdef GCM_PRODUCER_TEST_AFTER_ARM
+    GCM_PRODUCER_TEST_AFTER_ARM(ea);
+#endif
+    if (vm_read32(ea) != word) {
+        atomic_store(&s_gcm_producer_park_descriptor, 0);
+        if (s_gcm_producer_profile)
+            atomic_fetch_add(&g_gcm_producer_retry_count, 1);
+        return 0;
+    }
+    return 1;
+}
+
+static void gcm_producer_put_completed(u32 ea, u32 size)
+{
+    /* Pair the walker's arm/reread with StoreLoad ordering on this side too:
+     * the DMA copy must be visible before a producer can observe no waiter.
+     * A sequentially consistent load alone does not provide that barrier. */
+    atomic_thread_fence(memory_order_seq_cst);
+    const u64 descriptor = atomic_load(&s_gcm_producer_park_descriptor);
+    const u32 parked = (u32)descriptor;
+    const u32 expected = (u32)(descriptor >> 32);
+    /* Geometry jobs may copy the unchanged park command repeatedly while
+     * filling later segments. Only a changed word can let the walker resume.
+     * Reading after the descriptor also pairs with its release publication. */
+    if (parked && (u64)ea < (u64)parked + 4u &&
+                  (u64)ea + size > (u64)parked) {
+        if (vm_read32(parked) == expected) {
+            if (s_gcm_producer_profile)
+                atomic_fetch_add(&g_gcm_producer_unchanged_overlap_count, 1);
+            return;
+        }
+        HANDLE event = atomic_load(&s_gcm_kick_ev);
+        if (event && SetEvent(event)) {
+            if (s_gcm_producer_profile)
+                atomic_fetch_add(&g_gcm_producer_overlap_wake_count, 1);
+        }
+    }
 }
 
