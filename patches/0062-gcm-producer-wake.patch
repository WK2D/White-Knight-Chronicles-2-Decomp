-static HANDLE s_gcm_kick_ev = NULL;
+static _Atomic(HANDLE) s_gcm_kick_ev;
+static INIT_ONCE s_gcm_kick_once = INIT_ONCE_STATIC_INIT;
+static BOOL WINAPI gcm_kick_init(PINIT_ONCE once, PVOID parameter, PVOID* context)
+{
+    (void)once; (void)parameter; (void)context;
+    const char* e = getenv("GCM_FIFO_KICK");
+    s_gcm_producer_profile = getenv("GCM_PRODUCER_PROFILE") != NULL;
+    if (e && *e == '0') return TRUE;  /* preserve the bounded-sleep opt-out */
+    HANDLE event = CreateEventA(NULL, FALSE, FALSE, NULL);
+    if (!event) return FALSE;        /* failure remains a timed wait */
