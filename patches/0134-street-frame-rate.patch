+/* Collect the written pages of a texture's span into the epoch table and
+ * return the span's newest epoch, or 0 when the span cannot be watched. */
+static u32 eng_watch_epoch(u32 location, u32 offset, u32 span)
+{
+#ifdef _WIN32
+    if (span < ENG_WATCH_MIN_SPAN) return 0;
+    const u8* src = eng_guest_ptr(NULL, location, offset, span);
+    if (!src || src < vm_base) return 0;
+    const u64 first = (u64)(src - vm_base) >> 12;
+    const u64 last = ((u64)(src - vm_base) + span - 1u) >> 12;
+    if (last >= (1u << 20)) return 0;
+    const size_t pages = (size_t)(last - first + 1u);
+    if (!s_page_epoch && !(s_page_epoch = (u32*)calloc((size_t)1 << 20, sizeof(u32)))) return 0;
+    if (s_watch_cap < pages) {
+        void** grown = (void**)realloc(s_watch_pages, pages * sizeof(void*));
+        if (!grown) return 0;
+        s_watch_pages = grown;
+        s_watch_cap = pages;
+    }
+    size_t n = pages; unsigned long gran = 0;
+    if (GetWriteWatch(1u /* WRITE_WATCH_FLAG_RESET */, vm_base + (first << 12),
+                      pages << 12, s_watch_pages, &n, &gran) != 0)
+        return 0;
