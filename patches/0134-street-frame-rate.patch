+/* Private same-process A/B switch for performance work.
+ *
+ * WKC2's frame clock sets this from a gate file (main.cpp, WKC_AB_GATE) so a
+ * change and the code it replaces can be timed in one process, on one scene.
+ * Nonzero while the change under test is switched off; it stays 0 in play. */
+#ifndef WKC_AB_H
+#define WKC_AB_H
+/* C linkage from both languages: main.cpp sets it, the C runtime reads it. */
+#ifdef __cplusplus
+extern "C" {
+#endif
+#if defined(_MSC_VER)
+__declspec(selectany) volatile int g_wkc_ab_off = 0;
+#else
+__attribute__((weak)) volatile int g_wkc_ab_off = 0;
+#endif
+#ifdef __cplusplus
+}
+#endif
+#endif
