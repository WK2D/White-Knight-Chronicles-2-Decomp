diff --git a/libs/video/rsx_d3d12_clear.h b/libs/video/rsx_d3d12_clear.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_d3d12_clear.h
@@ -0,0 +1,57 @@
+/* Production D3D12 surface-clear operations, also exercised on WARP. */
+#ifndef RSX_D3D12_CLEAR_H
+#define RSX_D3D12_CLEAR_H
+#include <stdint.h>
+#include <d3d12.h>
+typedef struct rsx_surface_clear {
+    uint32_t flags;
+    float depth;
+    uint8_t stencil;
+    uint32_t x, y, w, h;
+} rsx_surface_clear;
+static inline rsx_surface_clear rsx_surface_clear_make(uint32_t flags,
+    float depth, uint8_t stencil, uint32_t x, uint32_t y, uint32_t w,
+    uint32_t h, uint32_t surface_w, uint32_t surface_h)
+{
+    rsx_surface_clear c = {flags,depth,stencil,x,y,w,h};
+    if (x >= surface_w) c.w=0;
+    else if (w > surface_w-x) c.w=surface_w-x;
+    if (y >= surface_h) c.h=0;
+    else if (h > surface_h-y) c.h=surface_h-y;
+    return c;
+}
+static inline int rsx_clear_rect(const rsx_surface_clear* c,
+    uint32_t w, uint32_t h, D3D12_RECT* r)
+{
+    uint64_t right=(uint64_t)c->x+c->w, bottom=(uint64_t)c->y+c->h;
+    r->left=(LONG)(c->x<w?c->x:w); r->top=(LONG)(c->y<h?c->y:h);
+    r->right=(LONG)(right<w?right:w); r->bottom=(LONG)(bottom<h?bottom:h);
+    return r->left<r->right && r->top<r->bottom;
+}
+/* -1 explicitly reports unsupported partial colour masks. Clearing all
+ * components for a depth-only or partial-colour operation corrupts the pass. */
+static inline int rsx_d3d12_clear_color(ID3D12GraphicsCommandList* list,
+    const rsx_surface_clear* c, const float rgba[4],
+    D3D12_CPU_DESCRIPTOR_HANDLE handle, uint32_t w, uint32_t h)
+{
+    if (!(c->flags&0xF0u)) return 0;
+    if ((c->flags&0xF0u)!=0xF0u) return -1;
+    D3D12_RECT rect;
+    if (!rsx_clear_rect(c,w,h,&rect)) return 0;
+    list->lpVtbl->ClearRenderTargetView(list,handle,rgba,1,&rect);
+    return 1;
+}
+static inline void rsx_d3d12_clear_depth(ID3D12GraphicsCommandList* list,
+    ID3D12Resource* resource, const rsx_surface_clear* c,
+    D3D12_CPU_DESCRIPTOR_HANDLE handle)
+{
+    if (!(c->flags&3u) || !resource) return;
+    D3D12_RESOURCE_DESC desc; resource->lpVtbl->GetDesc(resource,&desc);
+    D3D12_RECT rect;
+    if (!rsx_clear_rect(c,(uint32_t)desc.Width,desc.Height,&rect)) return;
+    D3D12_CLEAR_FLAGS flags=(D3D12_CLEAR_FLAGS)(
+        ((c->flags&1u)?D3D12_CLEAR_FLAG_DEPTH:0) |
+        ((c->flags&2u)?D3D12_CLEAR_FLAG_STENCIL:0));
+    list->lpVtbl->ClearDepthStencilView(list,handle,flags,c->depth,c->stencil,1,&rect);
+}
+#endif
