+/* Keep guest clear components and scissor bounds independent. A Z-only
+ * clear between two draws must neither erase colour nor wait for a target
+ * switch. Clear rectangles are clipped to each actual host attachment. */
+static void replay_color_clear(const D3D12DrawRecord* dr,
+    D3D12_CPU_DESCRIPTOR_HANDLE handle, u32 w, u32 h)
+{
+    if (rsx_d3d12_clear_color(s_d3d.cmd_list,&dr->clear,dr->cc,handle,w,h)<0) {
+        static unsigned reports;
+        if (reports++<8) fprintf(stderr,
+            "[RSX] unsupported partial colour clear mask=%X\n",dr->clear.flags);
+    }
+}
+static void replay_depth_clear(const D3D12DrawRecord* dr,
+    D3D12_CPU_DESCRIPTOR_HANDLE handle)
+{
+    rsx_d3d12_clear_depth(s_d3d.cmd_list,s_d3d.depth_buffer,&dr->clear,handle);
+}
+
+static void record_surface_info(D3D12DrawRecord* dr)
+{
+    const rsx_state* st = s_d3d.current_rsx_state;
+    dr->zeta_off = st ? st->surface_zeta_offset : 0;
+    dr->zeta_pitch = st ? st->surface_zeta_pitch : 0;
+    dr->surface_w = st ? st->surface_clip_w : 0;
+    dr->surface_h = st ? st->surface_clip_h : 0;
+    dr->color_target = st ? st->color_target : 0;
+}
+
+static void record_surface_clear(u32 rt, u32 w, u32 h, const u32 mrt[3],
+    u32 flags, const float cc[4], float depth, u8 stencil)
+{
+    if (!(flags & 0xF3u) || s_d3d.draw_count >= MAX_DRAWS) return;
+    D3D12DrawRecord* dr = &s_d3d.draws[s_d3d.draw_count++];
+    memset(dr, 0, sizeof(*dr));
+    dr->is_vp = 1; dr->is_clear = 1; dr->tex_slot = -1;
+    dr->rt_off = rt; memcpy(dr->rt_mrt, mrt, sizeof(dr->rt_mrt));
+    dr->rt_w = w; dr->rt_h = h;
+    const rsx_state* st = s_d3d.current_rsx_state;
+    dr->rt_fmt = st ? st->surface_format : 0;
+    record_surface_info(dr);
+    dr->clear = rsx_surface_clear_make(flags,depth,stencil,
+        st?st->scissor_x:0,st?st->scissor_y:0,
+        st?st->scissor_w:s_d3d.width,st?st->scissor_h:s_d3d.height,
+        dr->surface_w?dr->surface_w:s_d3d.width,
+        dr->surface_h?dr->surface_h:s_d3d.height);
+    memcpy(dr->cc, cc, sizeof(dr->cc));
+}
 
