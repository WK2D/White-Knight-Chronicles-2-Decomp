+            const u32 z = ((u32)p[0] << 16) | ((u32)p[1] << 8) | p[2];
+            depth[(size_t)y * w + x] = z / 16777215.0f;
+        }
+        tex_level_t level = {w, h, (const u8*)depth, w * 4u, h};
+        ID3D12Resource* result = create_texture_mipped(DXGI_FORMAT_R32_FLOAT, &level, 1);
