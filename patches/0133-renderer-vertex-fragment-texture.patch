+/* Fragment programs, remembered by where they live. Every draw used to walk
+ * the bound program three times (its size, its inline constants and its
+ * structural hash, a byte-at-a-time FNV) and clear two 32 KB constant blocks;
+ * on the crowded street that was about a twentieth of the renderer thread.
+ * The bytes are kept, and an entry is reused only when the program's current
+ * bytes compare equal to them, so size, constants and hash are those the
+ * program would produce again. RSX_ENGINE_FP_MEMO_VERIFY=1 recomputes all
+ * three on every reuse and counts differences; RSX_ENGINE_FP_MEMO=0 turns the
+ * memo off. */
+#define ENG_FP_MEMO_SLOTS 256u
+typedef struct eng_fp_memo {
+    u32 location, offset, size, valid;
+    u8* bytes; u32 bytes_cap;
+    u32 constants_valid, constant_count;
+    u32 (*constants)[4]; u32 constants_cap;
+    u32 hash_valid; u64 hash_seed, hash;
+} eng_fp_memo;
+static eng_fp_memo s_fp_memo[ENG_FP_MEMO_SLOTS];
+static eng_fp_memo* s_fp_memo_bound;      /* the memo of the program eng_guest_programs last found */
+static struct { u64 reused, verified, mismatched; } s_fp_memo_stats;
+
+static int eng_fp_memo_mode(void)       /* 0 off, 1 on, 2 on and verified */
+{
+    static int mode = -1;
+    if (mode < 0) {
+        const char* off = getenv("RSX_ENGINE_FP_MEMO");
+        const char* verify = getenv("RSX_ENGINE_FP_MEMO_VERIFY");
+        mode = off && !strcmp(off, "0") ? 0 : verify && *verify && strcmp(verify, "0") ? 2 : 1;
+    }
+    return mode;
+}
+
+static void eng_fp_memo_mismatch(const char* what)
+{
+    if (++s_fp_memo_stats.mismatched <= 8)
+        fprintf(stderr, "[rsx-engine] fragment program memo: %s differs on reuse\n", what);
+}
+
+/* The bound fragment program: its bytes and size, reused from the memo when
+ * the bytes are unchanged. */
+static const u8* eng_fragment_program(u32 location, u32 offset, u32* out_size)
+{
+    s_fp_memo_bound = NULL;
+    *out_size = 0;
+    const u8* uc = eng_guest_ptr(NULL, location, offset, 16);
+    if (!uc) return NULL;
+    const int mode = eng_fp_memo_mode();
+    eng_fp_memo* m = &s_fp_memo[((offset >> 4) ^ (location * 0x9E3779B1u)) & (ENG_FP_MEMO_SLOTS - 1u)];
+    if (mode && m->valid && m->location == location && m->offset == offset) {
+        const u8* full = eng_guest_ptr(NULL, location, offset, m->size);
+        if (full && !memcmp(full, m->bytes, m->size)) {
+            s_fp_memo_stats.reused++;
+            if (mode == 2) {
+                if ((++s_fp_memo_stats.verified & 0x3FFFFu) == 0)
+                    fprintf(stderr, "[rsx-engine] fragment program memo: %llu reused, %llu verified, %llu differed\n",
+                            (unsigned long long)s_fp_memo_stats.reused, (unsigned long long)s_fp_memo_stats.verified,
+                            (unsigned long long)s_fp_memo_stats.mismatched);
+                if (rsx_fp_program_size(uc, ENG_FP_MAX_BYTES) != m->size) eng_fp_memo_mismatch("size");
+            }
+            s_fp_memo_bound = m;
+            *out_size = m->size;
+            return full;
+        }
+    }
+    const u32 size = rsx_fp_program_size(uc, ENG_FP_MAX_BYTES);
+    if (!size) return uc;     /* as before: no program size, the pointer kept, size 0 */
+    const u8* full = eng_guest_ptr(NULL, location, offset, size);
+    if (!full) return NULL;
+    *out_size = size;
+    if (!mode) return full;
+    if (m->bytes_cap < size) {
+        u8* grown = (u8*)realloc(m->bytes, size);
+        if (!grown) { m->valid = 0; return full; }
+        m->bytes = grown; m->bytes_cap = size;
+    }
+    memcpy(m->bytes, full, size);
+    m->location = location; m->offset = offset; m->size = size; m->valid = 1;
+    m->constants_valid = m->hash_valid = 0;
+    s_fp_memo_bound = m;
+    return full;
+}
+
+/* rsx_fp_collect_constants into g.fp_constants, from the memo when it holds
+ * them. Only the first `count` slots are read downstream (the constant
+ * buffer copy and the slot count), so a reused block sets just those. */
+static int eng_fp_constants(const u8* uc, u32 size)
+{
+    eng_fp_memo* m = s_fp_memo_bound;
+    if (m && m->constants_valid) {
+        g.fp_constants.count = m->constant_count;
+        memcpy(g.fp_constants.values, m->constants, (size_t)m->constant_count * 16u);
+        if (eng_fp_memo_mode() == 2) {
+            static rsx_fp_constant_block check;
+            const int n = rsx_fp_collect_constants(uc, size, &check);
+            if (n != (int)m->constant_count ||
+                memcmp(check.values, m->constants, (size_t)m->constant_count * 16u))
+                eng_fp_memo_mismatch("constants");
+        }
+        return (int)m->constant_count;
+    }
+    const int n = rsx_fp_collect_constants(uc, size, &g.fp_constants);
+    if (n < 0 || !m) return n;
+    if (m->constants_cap < (u32)n) {
+        u32 (*grown)[4] = (u32 (*)[4])realloc(m->constants, (size_t)n * 16u);
+        if (!grown) return n;
+        m->constants = grown; m->constants_cap = (u32)n;
+    }
+    if (n) memcpy(m->constants, g.fp_constants.values, (size_t)n * 16u);
+    m->constant_count = (u32)n;
+    m->constants_valid = 1;
+    return n;
+}
+
+/* rsx_fp_structural_hash, from the memo when the seed matches too. */
+static u64 eng_fp_structural_hash(const u8* uc, u32 size, u64 seed)
+{
+    eng_fp_memo* m = s_fp_memo_bound;
+    if (m && m->hash_valid && m->hash_seed == seed) {
+        if (eng_fp_memo_mode() == 2 && rsx_fp_structural_hash(uc, size, seed) != m->hash)
+            eng_fp_memo_mismatch("structural hash");
+        return m->hash;
+    }
+    const u64 hash = rsx_fp_structural_hash(uc, size, seed);
+    if (m) { m->hash_seed = seed; m->hash = hash; m->hash_valid = 1; }
+    return hash;
+}
