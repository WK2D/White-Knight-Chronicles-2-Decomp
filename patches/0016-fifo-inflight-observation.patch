+/* Optional host-only FIFO observations. Published GET updates at the end of
+ * a drain; these atomics reveal progress inside a long or blocked pass.
+ * Fields are sampled independently and are approximate, not a coherent dump. */
+#include <stdatomic.h>
+static atomic_uint s_debug_fifo_get, s_debug_fifo_word, s_debug_fifo_data;
+static atomic_uint s_debug_fifo_phase, s_debug_fifo_steps, s_debug_fifo_branches;
+static atomic_uint s_debug_branch_get[16], s_debug_branch_word[16];
+
+void cellGcmDebugFifoSnapshot(void)
+{
+    if (!getenv("GCM_FIFO_PROGRESS")) return;
+    fprintf(stderr, "[fifo-progress] approximate phase=%u steps=%u inflight_get=%08X word=%08X data=%08X branches=%u\n",
+        atomic_load(&s_debug_fifo_phase), atomic_load(&s_debug_fifo_steps),
+        atomic_load(&s_debug_fifo_get), atomic_load(&s_debug_fifo_word),
+        atomic_load(&s_debug_fifo_data), atomic_load(&s_debug_fifo_branches));
+    u32 count = atomic_load(&s_debug_fifo_branches);
+    for (u32 i = count > 16 ? count - 16 : 0; i < count; ++i)
+        fprintf(stderr, "[fifo-branch] sample=%u get=%08X word=%08X\n", i,
+            atomic_load(&s_debug_branch_get[i % 16]),
+            atomic_load(&s_debug_branch_word[i % 16]));
+    u32 get = atomic_load(&s_debug_fifo_get);
+    for (u32 i = 0; i < 16; ++i) {
+        u32 ea = gcm_io2ea(get + i * 4);
+        if (ea) fprintf(stderr, "[fifo-inflight] io=%08X ea=%08X word=%08X\n",
+            get + i * 4, ea, vm_read32(ea));
+    }
+}
