Wake job-chain walkers blocked on a job guard through a condition variable
instead of 1 ms polling, and yield the host time slice when an SPU re-reads
an unchanged reservation line so the holder of a contended lock can run.
Without the yield a WKC1 loading burst left ~160 task threads spinning.

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -2397,6 +2397,10 @@
  * multiple guards per chain, so the host registry has no fixed global cap. */
 static JobGuard* s_jobguards;
 static SRWLOCK s_jobguard_lock = SRWLOCK_INIT;
+/* Signalled whenever a guard gains credits or is (re)initialized, so a chain
+ * walker blocked on a guard resumes as soon as the title notifies it instead
+ * of on its next 1 ms poll -- WKC opens several guards per frame. */
+static CONDITION_VARIABLE s_jobguard_cv = CONDITION_VARIABLE_INIT;
 
 /* Caller holds s_jobguard_lock. */
 static JobGuard* jg_find(u32 ea)
@@ -2441,6 +2445,7 @@
      * peek meaningful. */
     vm_write32(ea, notify_count);
     ReleaseSRWLockExclusive(&s_jobguard_lock);
+    WakeAllConditionVariable(&s_jobguard_cv);
 
     printf("[cellSpurs] JobGuardInitialize(guard=0x%08X chain=0x%08X notify=%u "
            "autoReset=%u)\n", ea, (u32)jc_ea, notify_count, auto_reset);
@@ -2473,6 +2478,7 @@
           printf("[cellSpurs] JobGuardNotify(0x%08X) -> %u remaining\n",
                  ea, g->count); }
     ReleaseSRWLockExclusive(&s_jobguard_lock);
+    WakeAllConditionVariable(&s_jobguard_cv);
     return CELL_OK;
 }
 
@@ -2493,6 +2499,7 @@
     g->count = g->reset = g->initial;
     vm_write32(ea, g->count);
     ReleaseSRWLockExclusive(&s_jobguard_lock);
+    WakeAllConditionVariable(&s_jobguard_cv);
     return CELL_OK;
 }
 
@@ -2528,12 +2535,9 @@
             ReleaseSRWLockExclusive(&s_jobguard_lock);
             return 1;
         }
+        /* Bounded so a stop request (which does not signal) is still seen. */
+        SleepConditionVariableSRW(&s_jobguard_cv, &s_jobguard_lock, 50, 0);
         ReleaseSRWLockExclusive(&s_jobguard_lock);
-#ifdef _WIN32
-        Sleep(1);
-#else
-        usleep(1000);
-#endif
     }
 }
 
diff --git a/runtime/spu/spu_channels.c b/runtime/spu/spu_channels.c
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -534,7 +534,8 @@
                       ctx->image_id, (uint32_t)ctx->pc, ea);
       } }
     switch (cmd) {
-    case MFC_GETLLAR_CMD:
+    case MFC_GETLLAR_CMD: {
+        int spu_llar_yield = 0;
         /* Lockstep tick: a guest GETLLAR..PUTLLC poll loop is intra-function
          * (all gotos), so it never crosses the SPU_DRAIN tick site -- without a
          * tick here a polling SPU would hold the run token forever while the
@@ -586,6 +587,20 @@
          * once per line with the line's head, so the stuck word is visible
          * without a per-function probe. */
         { static SPU_THREAD_LOCAL uint32_t t_ea; static SPU_THREAD_LOCAL unsigned long t_n;
+          /* An SPU spinning on a line that has not changed (a lock another
+           * task holds: WKC's loader workers wait while a 1000+ writer count
+           * is set) gives up its host time slice, so the holder -- possibly
+           * another task thread -- can run. Without it a loading burst left
+           * ~160 waiters starving the holder. Never sleeps: a change is seen
+           * on the very next read, so live handoffs keep full speed. */
+          static SPU_THREAD_LOCAL uint8_t t_line[MFC_ATOMIC_LINE];
+          static SPU_THREAD_LOCAL uint32_t t_same;
+          if (ea == t_ea && memcmp(t_line, ls, MFC_ATOMIC_LINE) == 0) {
+              if (++t_same > 64) spu_llar_yield = 1;
+          } else {
+              t_same = 0;
+              memcpy(t_line, ls, MFC_ATOMIC_LINE);
+          }
           if (ea != t_ea) { t_ea = ea; t_n = 0; }
           else if (++t_n == 4000000) {
               const uint8_t* m = vm_base + ea;
@@ -595,6 +610,9 @@
                       m[0],m[1],m[2],m[3], m[4],m[5],m[6],m[7], m[8],m[9],m[10],m[11], m[12],m[13],m[14],m[15]);
           } }
         spu_lockline_unlock();
+#ifdef _WIN32
+        if (spu_llar_yield) SwitchToThread();
+#endif
         /* SPU_LLARWATCH=<hex EA>: every GETLLAR of that line, with the LSA it
          * used and the first word as it lands in BOTH places.
          *
@@ -651,6 +669,7 @@
               }
           } }
         return 1;
+    }
 
     case MFC_PUTLLC_CMD:
         g_spu_putllc_count++;   /* run-scoped delta read by the PM flow trace */
