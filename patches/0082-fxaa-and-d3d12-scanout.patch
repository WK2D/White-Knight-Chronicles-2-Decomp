+/* CopyResource requires matching dimensions. Keep the swapchain image size
+ * equal to the selected guest scanout; DXGI stretches it to the host window.
+ * Retire all GPU references before releasing its backbuffers. */
+static int ld_scanout_size(u32 width,u32 height)
+{
+    D3D12_RESOURCE_DESC desc={0};
+    if(g.backbuf[0]) g.backbuf[0]->lpVtbl->GetDesc(g.backbuf[0],&desc);
+    if(desc.Width==width && desc.Height==height) return 0;
+    ld_flush(LD_FLUSH_PRESENT);
+    for(u32 i=0;i<LD_SWAP_BUFFERS;i++) {
+        if(g.backbuf[i]) g.backbuf[i]->lpVtbl->Release(g.backbuf[i]);
+        g.backbuf[i]=NULL;
+    }
+    HRESULT hr=g.swap->lpVtbl->ResizeBuffers(g.swap,LD_SWAP_BUFFERS,width,height,DXGI_FORMAT_R8G8B8A8_UNORM,0);
+    if(FAILED(hr)) { fprintf(stderr,"[live-draw] scanout resize failed hr=0x%08lX\n",(unsigned long)hr);g.ready=0;return -1; }
+    for(u32 i=0;i<LD_SWAP_BUFFERS;i++) {
+        if(FAILED(g.swap->lpVtbl->GetBuffer(g.swap,i,&IID_ID3D12Resource,(void**)&g.backbuf[i]))) {g.ready=0;return -1;}
+        g.dev->lpVtbl->CreateRenderTargetView(g.dev,g.backbuf[i],NULL,rtv_handle(i));
+    }
+    return 0;
+}
