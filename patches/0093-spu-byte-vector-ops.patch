diff --git a/runtime/spu/spu_byte_ops.h b/runtime/spu/spu_byte_ops.h
new file mode 100644
--- /dev/null
+++ b/runtime/spu/spu_byte_ops.h
@@ -0,0 +1,56 @@
+/* Project-written quadword byte operations. Host u128 words contain SPU word
+ * values, so architectural byte p lives at host byte (p ^ 3). */
+#ifndef PS3RECOMP_SPU_BYTE_OPS_H
+#define PS3RECOMP_SPU_BYTE_OPS_H
+#include "spu_context.h"
+#include <string.h>
+
+#if defined(__SSSE3__) && !defined(PS3RECOMP_SPU_BYTE_SCALAR)
+#include <tmmintrin.h>
+#define PS3RECOMP_SPU_BYTE_VECTOR 1
+static inline __m128i spu_byte_positions(void) {
+    return _mm_setr_epi8(3,2,1,0,7,6,5,4,11,10,9,8,15,14,13,12);
+}
+static inline u128 spu_byte_shuffle(u128 a, __m128i indices) {
+    __m128i input,result;u128 out;
+    memcpy(&input,&a,16);
+    result=_mm_shuffle_epi8(input,_mm_xor_si128(indices,_mm_set1_epi8(3)));
+    memcpy(&out,&result,16);return out;
+}
+#endif
+
+static inline u128 spu_bytes_left(u128 a,unsigned shift) {
+    shift&=31u;
+#ifdef PS3RECOMP_SPU_BYTE_VECTOR
+    /* p+shift in [0,46]. Adding 0x70 sets PSHUFB's zero bit iff the source
+     * falls beyond byte 15, while preserving the low selector nibble. */
+    return spu_byte_shuffle(a,_mm_add_epi8(spu_byte_positions(),_mm_set1_epi8((char)(0x70u+shift))));
+#else
+    u128 r;memset(&r,0,16);
+    for(unsigned p=0;p<16;p++) if(p+shift<16) r._u8[p^3]=a._u8[(p+shift)^3];
+    return r;
+#endif
+}
+static inline u128 spu_bytes_rotate(u128 a,unsigned shift) {
+    shift&=15u;
+#ifdef PS3RECOMP_SPU_BYTE_VECTOR
+    /* PSHUFB ignores bits 4-6: its low nibble supplies the wraparound. */
+    return spu_byte_shuffle(a,_mm_add_epi8(spu_byte_positions(),_mm_set1_epi8((char)shift)));
+#else
+    u128 r;
+    for(unsigned p=0;p<16;p++) r._u8[p^3]=a._u8[((p+shift)&15u)^3];
+    return r;
+#endif
+}
+static inline u128 spu_bytes_right(u128 a,unsigned shift) {
+    shift&=31u;
+#ifdef PS3RECOMP_SPU_BYTE_VECTOR
+    /* A negative source index has its high bit set, selecting zero. */
+    return spu_byte_shuffle(a,_mm_sub_epi8(spu_byte_positions(),_mm_set1_epi8((char)shift)));
+#else
+    u128 r;memset(&r,0,16);
+    for(unsigned p=shift;p<16;p++) r._u8[p^3]=a._u8[(p-shift)^3];
+    return r;
+#endif
+}
+#endif
