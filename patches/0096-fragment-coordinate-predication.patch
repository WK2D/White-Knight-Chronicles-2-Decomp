+static void test_texcoord_pipeline_key(void)
+{
+    printf("-- texture-coordinate control and pipeline identity\n");
+    engine_up();
+    u8 vp[16],fp[16];
+    rsx_test_vp_mov_out(vp,0,RSX_TEST_VP_SWZ_IDENT,0,1);
+    m(0x1E9C,0);
+    for(u32 i=0;i<4;i++){u32 word;memcpy(&word,vp+i*4,4);m(0x0B80+i*4,word);}
+    m(0x1EA0,0);
+    rsx_test_fp_instr(fp,RSX_TEST_FP_OPC(RSX_TEST_FP_OP_MOV)|RSX_TEST_FP_MASK_XYZW|
+        RSX_TEST_FP_INSRC_TC0|RSX_TEST_FP_END,RSX_TEST_FP_SRC_INPUT|RSX_TEST_FP_SWZ_IDENT);
+    memcpy(vm_base+0x300000,fp,sizeof fp);m(0x08E4,0x300002);m(0x1D60,0x40);
+    draw_triangle();const u32 original=stub.bound_pipeline;const int created=stub.n_pipeline_create;
+    CHECK(original && !stub.pipeline_tc2d[original],"default coordinate source remains unchanged");
+    m(0x0B40,1);draw_triangle();const u32 modified=stub.bound_pipeline;
+    CHECK(modified!=original && stub.pipeline_tc2d[modified] && stub.n_pipeline_create==created+1,
+          "2D control selects a new pipeline containing corrected Z/W");
+    draw_triangle();CHECK(stub.bound_pipeline==modified && stub.n_pipeline_create==created+1,
+          "unchanged coordinate control reuses that pipeline");
+    m(0x0B40,0);draw_triangle();
+    CHECK(stub.bound_pipeline==original && stub.n_pipeline_create==created+1,
+          "disabling coordinate override reuses the original pipeline");
+    engine_down();
+}
