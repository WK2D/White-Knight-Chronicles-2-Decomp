+/* A depth image can be rewritten after its snapshot was published and then
+ * sampled while another zeta is bound. Its generation, not the current
+ * attachment, determines whether that snapshot is still usable. */
+static void test_depth_snapshot_generation(void)
+{
+    printf("-- depth snapshot generations across zeta switches\n");
+    engine_up();
+    m(M_CONTEXT_DMA_ZETA, DMA_LOCAL);
+    m(M_SURFACE_FORMAT, 8u | (2u << 5));
+    m(M_ZETA_OFFSET, ZETA_OFFSET);
+    m(M_ZETA_PITCH, 256u * 4u);
+    m(M_DEPTH_TEST, 1u);
+    m(M_DEPTH_WRITE, 1u);
+    draw_triangle();
+    const u32 depth_a = stub.bound_depth;
+    CHECK(stub.depth_stamp[depth_a] == 1u, "first draw writes depth A generation 1");
+
+    m(M_DEPTH_TEST, 0u);
+    m(M_DEPTH_WRITE, 0u);
+    bind_texture_unit(RSX_LOCATION_LOCAL, ZETA_OFFSET);
+    m(M_TEX_UNIT + 0x04, 1u | (2u << 4) | (0xB0u << 8) | (1u << 16));
+    draw_triangle();
+    const u32 first = stub.bound_tex[0];
+    CHECK(first && stub.n_depth_snapshot == 1 && stub.depth_stamp[first] == 1u,
+          "first sample copies depth A generation 1");
+
+    /* Rewrite A without a depth clear (which already invalidates snapshots).
+     * Unit 0 is off so this write does not itself refresh the snapshot. */
+    m(M_TEX_UNIT + 0x0C, 0u);
+    m(M_DEPTH_TEST, 1u);
+    m(M_DEPTH_WRITE, 1u);
+    draw_triangle();
+    CHECK(stub.depth_stamp[depth_a] == 2u && stub.n_depth_snapshot == 1,
+          "second depth A write leaves its published copy at generation 1");
+
+    m(M_ZETA_OFFSET, ZETA_OFFSET + 0x200000u);
+    m(M_DEPTH_TEST, 0u);
+    m(M_DEPTH_WRITE, 0u);
+    m(M_TEX_UNIT + 0x0C, 0x80000000u);
+    draw_triangle();
+    const u32 refreshed = stub.bound_tex[0];
+    CHECK(stub.bound_depth != depth_a && refreshed != first && stub.n_depth_snapshot == 2,
+          "sampling rewritten A with depth B bound refreshes the snapshot");
+    CHECK(stub.depth_stamp[refreshed] == 2u,
+          "the bound snapshot contains depth A generation 2, not stale generation 1");
+    CHECK(!stub.alive[first], "refresh releases the replaced snapshot handle");
+
+    draw_triangle();
+    CHECK(stub.bound_tex[0] == refreshed && stub.n_depth_snapshot == 2,
+          "unchanged depth A reuses its current snapshot while B remains bound");
+    engine_down();
+}
