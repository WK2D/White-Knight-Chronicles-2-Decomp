 }
 
-/* A depth target read back as a texture, but only once the pass has executed
- * a depth-WRITING draw: a write-enable bit alone does not prove the pass
- * produced a usable depth map, and a clear-only zeta falls through to guest
- * memory instead (rsx_live_draw.c:6016-6018, 6265-6269). */
+/* A defined depth target read through a copy of its current generation.
+ * The target need not still be bound when a later pass samples it. */
 static u32 eng_zdepth_snapshot(u32 slot)
 {
     eng_zdepth* z = &g.zdepths[slot];
@@ -1192,7 +1190,8 @@
      * sampled, just-cleared depth through guest memory (a GPU wait and a full
      * readback) every frame of WKC2's character creator. */
     if (!z->handle || !(z->had_write || z->cleared)) return 0;
-    if (z->snapshot_valid && z->snapshot) return z->snapshot;
+    if (z->snapshot_valid && z->snapshot && z->snapshot_serial == z->depth_serial)
+        return z->snapshot;
     if (!g.be->depth_snapshot) return 0;
     const u32 tex = g.be->depth_snapshot(g.be->user, z->handle, z->w, z->h);
     if (!tex) return 0;
@@ -2136,11 +2135,6 @@
                   (t.pitch ? t.pitch : t.width * 4u) == zz->pitch &&
                   zz->pitch >= zz->w * 4u &&
                   zz->used_w >= zz->w && zz->used_h >= zz->h) {
-                  /* The bound depth is read through a copy, so no feedback; the
-                   * copy must postdate the last depth write, though, which the
-                   * clear-only invalidation does not ensure for a bound target. */
-                  if (g.zdepths[zsrc].snapshot_serial != g.zdepths[zsrc].depth_serial)
-                      g.zdepths[zsrc].snapshot_valid = 0;
                   const u32 snap = eng_zdepth_snapshot((u32)zsrc);
                   const u32 tex = snap ? g.be->depth_to_argb8(g.be->user, snap, t.width, t.height,
                                                                   t.remap & 0xFFFFu, t.format) : 0;
@@ -2152,9 +2146,6 @@
                 /* The bound depth too, through a copy taken after its last
                  * write: it went through guest memory, a GPU wait and a 26 MB
                  * readback per frame for WKC2's 2560x2560 shadow map. */
-                if (current_zslot == (u32)zsrc &&
-                    g.zdepths[zsrc].snapshot_serial != g.zdepths[zsrc].depth_serial)
-                    g.zdepths[zsrc].snapshot_valid = 0;
                 const u32 snap = eng_zdepth_snapshot((u32)zsrc);
                 if (snap) { textures[u] = snap; continue; }
             }
