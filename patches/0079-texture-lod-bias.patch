 /* ---- 1. the surface set -------------------------------------------------- */
 
+static void test_sampler_lod_bias(void)
+{
+    printf("-- signed sampler LOD bias\n");
+    engine_up();
+    bind_texture_unit(RSX_LOCATION_LOCAL, 0x40000u);
+    const struct { u32 bits; float expected; } cases[] = {
+        {0x0000u, 0.0f}, {0x1E80u, -1.5f}, {0x0180u, 1.5f},
+        {0x1FFFu, -1.0f/256.0f}, {0x1000u, -16.0f},
+        {0x0FFFu, 16.0f-1.0f/256.0f}, {0x0000u, 0.0f}
+    };
+    for (u32 i = 0; i < sizeof cases / sizeof cases[0]; i++) {
+        m(M_TEX_UNIT + 0x14, (2u << 24) | (6u << 16) | cases[i].bits);
+        draw_triangle();
+        CHECK((stub.bound_mask & 1u) && stub.bound_lod_bias == cases[i].expected,
+              "sampler bias 0x%04x reaches backend as %.8g (got %.8g)",
+              cases[i].bits, cases[i].expected, stub.bound_lod_bias);
+    }
+    engine_down();
+}
+
