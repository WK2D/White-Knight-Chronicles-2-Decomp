diff --git a/include/ps3emu/wkc_frame_trace.h b/include/ps3emu/wkc_frame_trace.h
new file mode 100644
--- /dev/null
+++ b/include/ps3emu/wkc_frame_trace.h
@@ -0,0 +1,96 @@
+/* Optional WKC frame timeline. Records host timing and IDs, never game bytes.
+ * The frame-clock thread alone starts/stops/dumps. Workers publish only while
+ * recording; the clock closes admission and waits for active publishers before
+ * reading records. No allocations or file I/O occur on recording workers. */
+#ifndef WKC_FRAME_TRACE_H
+#define WKC_FRAME_TRACE_H
+#include <stdint.h>
+#ifdef _WIN32
+#include <windows.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+enum { WT_DRAIN=1,WT_PRESENT,WT_FRAME_WAIT,WT_SPU_RUN,WT_SPU_WAIT,
+       WT_SYSCALL,WT_HLE,WT_GPU_WAIT,WT_READBACK,WT_FLUSH };
+typedef struct { uint64_t t0,t1; uint32_t kind,tid,a,b; } wt_record;
+typedef struct {
+    volatile LONG on,writers,n,dropped;
+    uint64_t base,end,frequency;
+    wt_record* records;
+    unsigned cap;
+} wt_shared;
+__declspec(selectany) wt_shared g_wkc_private_trace = {0};
+static inline uint64_t wt_now(void) { LARGE_INTEGER c; QueryPerformanceCounter(&c);return (uint64_t)c.QuadPart; }
+static inline uint64_t wt_begin(void) {
+    return __atomic_load_n(&g_wkc_private_trace.on,__ATOMIC_ACQUIRE)==1 ? wt_now() : 0;
+}
+static inline void wt_end(unsigned kind,unsigned a,unsigned b,uint64_t t0) {
+    if(!t0)return;
+    wt_shared* s=&g_wkc_private_trace;
+    const uint64_t t1=wt_now();
+    /* Discard sub-20-us calls before claiming a ring slot: very short syscall
+     * probes occur hundreds of thousands of times a second in this title. */
+    if((kind==WT_SYSCALL || kind==WT_HLE) && t1-t0<s->frequency/50000)return;
+    InterlockedIncrement(&s->writers);
+    if(__atomic_load_n(&s->on,__ATOMIC_ACQUIRE)==1) {
+        if(t0>=s->base && t0<s->end) {
+            LONG i=InterlockedIncrement(&s->n)-1;
+            if((unsigned)i<s->cap) {
+                wt_record r={t0,t1,kind,GetCurrentThreadId(),a,b};s->records[i]=r;
+            } else InterlockedIncrement(&s->dropped);
+        }
+    }
+    InterlockedDecrement(&s->writers);
+}
+static inline void wt_tick(void) {
+    static int initialized,finished;
+    static const char *gate,*output;
+    static uint64_t next_check;
+    wt_shared* s=&g_wkc_private_trace;
+    if(!initialized) {
+        initialized=1;gate=getenv("WKC_TRACE_GATE");output=getenv("WKC_TRACE_OUT");
+        if(!gate||!output){finished=1;return;}
+        LARGE_INTEGER f;QueryPerformanceFrequency(&f);s->frequency=f.QuadPart;
+        s->cap=2000000;s->records=(wt_record*)calloc(s->cap,sizeof(wt_record));
+        if(!s->records){finished=1;return;}
+    }
+    if(finished)return;
+    uint64_t now=wt_now();
+    if(!s->on && now>=next_check) {
+        next_check=now+s->frequency/10;
+        if(GetFileAttributesA(gate)!=INVALID_FILE_ATTRIBUTES) {
+            s->base=now;s->end=now+s->frequency*10;
+            __atomic_store_n(&s->on,1,__ATOMIC_RELEASE);
+        }
+    }
+    if(s->on==1 && now>=s->end) {
+        __atomic_store_n(&s->on,2,__ATOMIC_RELEASE);
+        while(InterlockedCompareExchange(&s->writers,0,0))Sleep(0);
+        FILE* f=fopen(output,"wb");
+        if(f) {
+            fprintf(f,"# private WKC timeline: kind tid a b start_us end_us; dropped=%ld\n",s->dropped);
+            unsigned n=(unsigned)s->n;if(n>s->cap)n=s->cap;
+            for(unsigned i=0;i<n;i++) {
+                const wt_record* r=&s->records[i];
+                fprintf(f,"%u %u %u %u %.3f %.3f\n",r->kind,r->tid,r->a,r->b,
+                    (r->t0-s->base)*1e6/s->frequency,(r->t1-s->base)*1e6/s->frequency);
+            }
+            fclose(f);
+        }
+        finished=1;
+    }
+}
+#ifdef __cplusplus
+}
+#endif
+#else
+enum { WT_DRAIN=1,WT_PRESENT,WT_FRAME_WAIT,WT_SPU_RUN,WT_SPU_WAIT,
+       WT_SYSCALL,WT_HLE,WT_GPU_WAIT,WT_READBACK,WT_FLUSH };
+static inline uint64_t wt_begin(void) { return 0; }
+static inline void wt_end(unsigned k,unsigned a,unsigned b,uint64_t t) { (void)k;(void)a;(void)b;(void)t; }
+static inline void wt_tick(void) {}
+#endif /* _WIN32: other hosts have no diagnostic hooks yet */
+#endif
