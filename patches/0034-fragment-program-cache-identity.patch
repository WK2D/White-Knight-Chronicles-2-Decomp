--- a/libs/video/rsx_fp_decompiler.c
+++ b/libs/video/rsx_fp_decompiler.c
@@ -1177,6 +1177,26 @@
  * on their values, so including them in the pipeline key made it change every
  * time the title re-patched a constant -- which is exactly what thrashed the
  * cache. */
+int rsx_fp_code_equal(const u8* a, u32 a_bytes, const u8* b, u32 b_bytes)
+{
+    const u32 an = rsx_fp_program_size(a,a_bytes);
+    const u32 bn = rsx_fp_program_size(b,b_bytes);
+    if (!an || an != bn) return 0;
+    u32 off = 0;
+    while (off + 16 <= an) {
+        if (memcmp(a+off,b+off,16)) return 0;
+        const u32 w0=rsx_fp_read_word(a+off);
+        const u32 w1=rsx_fp_read_word(a+off+4);
+        const u32 w2=rsx_fp_read_word(a+off+8);
+        const u32 w3=rsx_fp_read_word(a+off+12);
+        off += 16;
+        /* Match the decompiler's instruction/constant-slot layout exactly. */
+        if (fp_instruction_has_constant(w1,w2,w3)) off += 16;
+        if (w0 & FP_END) return off == an;
+    }
+    return 0;
+}
