diff --git a/libs/video/rsx_raster_state.h b/libs/video/rsx_raster_state.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_raster_state.h
@@ -0,0 +1,18 @@
+/* Immutable raster state. Bit 3 carries depth clipping beside face culling. */
+#ifndef RSX_RASTER_STATE_H
+#define RSX_RASTER_STATE_H
+#include <stdint.h>
+static inline unsigned rsx_raster_depth_clip(uint32_t control) {
+    /* ZMIN_MAX_CONTROL: low nibble enables clipping; next enables clamping. */
+    return (control & 15u) != 0 && (control & 0xf0u) == 0;
+}
+static inline uint32_t rsx_raster_key(int cull, uint32_t face,
+                                     uint32_t front, uint32_t clip_control) {
+    uint32_t key=rsx_raster_depth_clip(clip_control) ? 8u : 0u;
+    if (!cull) return key;
+    key|=1u;
+    if (face==0x404u || face==0x408u) key|=2u;
+    if (front==0x901u) key|=4u;
+    return key;
+}
+#endif
