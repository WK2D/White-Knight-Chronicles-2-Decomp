diff --git a/runtime/spu/spurs_job.c b/runtime/spu/spurs_job.c
--- a/runtime/spu/spurs_job.c
+++ b/runtime/spu/spurs_job.c
@@ -44,6 +44,33 @@
 #include <string.h>
 #include <stddef.h>
 #include <malloc.h>
+
+/* These diagnostics are selected at host launch, independently of job state.
+ * Each thread initializes its own cache, without a shared initialization race. */
+#if defined(_MSC_VER)
+#  define SPURS_JOB_DIAG_TLS __declspec(thread)
+#else
+#  define SPURS_JOB_DIAG_TLS __thread
+#endif
+typedef struct {
+    int initialized;
+    int descriptor_dump, descriptor_level;
+    int job_dump, exit_trace;
+} spurs_job_diagnostics;
+
+static const spurs_job_diagnostics* job_diagnostics(void)
+{
+    static SPURS_JOB_DIAG_TLS spurs_job_diagnostics cached;
+    if (!cached.initialized) {
+        const char* level = getenv("SPURS_JOB_DESCDUMP");
+        cached.descriptor_dump = level != NULL;
+        cached.descriptor_level = level ? atoi(level) : 0;
+        cached.job_dump = getenv("SPURS_JOB_DUMP") != NULL;
+        cached.exit_trace = getenv("SPURS_JOB_EXIT_TRACE") != NULL;
+        cached.initialized = 1;
+    }
+    return &cached;
+}
 
