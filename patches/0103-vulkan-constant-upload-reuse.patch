diff --git a/libs/video/rsx_constant_reuse.h b/libs/video/rsx_constant_reuse.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_constant_reuse.h
@@ -0,0 +1,71 @@
+/* Producer-owned constant shadows and immutable offsets in a live upload arena.
+ * Invalidate all stamps after retirement, before the arena can be overwritten. */
+#ifndef RSX_CONSTANT_REUSE_H
+#define RSX_CONSTANT_REUSE_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+typedef struct rsx_constant_stamp {
+    uint64_t buffer, offset, bytes;
+    int valid;
+} rsx_constant_stamp;
+typedef struct rsx_constant_reuse {
+    rsx_constant_stamp stage[2];
+} rsx_constant_reuse;
+
+static inline void rsx_constant_forget(rsx_constant_reuse* cache)
+{
+    cache->stage[0].valid = cache->stage[1].valid = 0;
+}
+
+/* Compare only the producer's cached host shadow, never write-combined GPU memory.
+ * The producer exclusively owns this shadow; callers cannot mutate it directly. */
+static inline int rsx_constant_update(rsx_constant_reuse* cache, unsigned stage,
+                                      void* shadow, uint32_t previous_bytes,
+                                      const void* data, uint32_t bytes)
+{
+    if (stage >= 2) return -1;
+    if (bytes && (!shadow || !data)) {
+        cache->stage[stage].valid = 0;
+        return -1;
+    }
+    if (previous_bytes == bytes && (!bytes || !memcmp(shadow, data, bytes)))
+        return 0;
+    cache->stage[stage].valid = 0;
+    if (bytes) memcpy(shadow, data, bytes);
+    return 1;
+}
+
+static inline int rsx_constant_range(uint64_t offset, uint64_t bytes,
+                                     uint64_t cursor, uint64_t capacity,
+                                     uint64_t alignment)
+{
+    return bytes && alignment && !(offset % alignment) &&
+        offset <= cursor && bytes <= cursor - offset &&
+        offset <= capacity && bytes <= capacity - offset;
+}
+
+static inline int rsx_constant_lookup(const rsx_constant_reuse* cache,
+    unsigned stage, uint64_t buffer, uint64_t cursor, uint64_t capacity,
+    uint64_t bytes, uint64_t alignment, uint64_t* offset)
+{
+    if (stage >= 2 || !buffer || !offset) return 0;
+    const rsx_constant_stamp* stamp = &cache->stage[stage];
+    if (!stamp->valid || stamp->buffer != buffer || stamp->bytes != bytes ||
+        !rsx_constant_range(stamp->offset, bytes, cursor, capacity, alignment))
+        return 0;
+    *offset = stamp->offset;
+    return 1;
+}
+
+static inline void rsx_constant_remember(rsx_constant_reuse* cache,
+    unsigned stage, uint64_t buffer, uint64_t offset, uint64_t bytes,
+    uint64_t cursor, uint64_t capacity, uint64_t alignment)
+{
+    if (stage >= 2) return;
+    rsx_constant_stamp* stamp = &cache->stage[stage];
+    stamp->valid = buffer && rsx_constant_range(offset, bytes, cursor, capacity, alignment);
+    stamp->buffer = buffer; stamp->offset = offset; stamp->bytes = bytes;
+}
+#endif
