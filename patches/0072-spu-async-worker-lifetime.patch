--- /dev/null
+++ b/runtime/spu/spu_async_lifetime.h
@@ -0,0 +1,91 @@
+/* Host lifetime claims for detached SPU tasks/workloads. A claim precedes
+ * thread creation and stays active through all runner/stack cleanup. The key
+ * is an explicit guest owner plus task/workload id, never an image pointer or
+ * the process-global last-task diagnostic variables. */
+#ifndef SPU_ASYNC_LIFETIME_H
+#define SPU_ASYNC_LIFETIME_H
+#include <stdint.h>
+#include <stdlib.h>
+#include <stdatomic.h>
+
+enum { SPU_ASYNC_TASK = 1, SPU_ASYNC_WORKLOAD = 2 };
+typedef struct spu_async_owner {
+    uint32_t kind, ea, instance, generation, active;
+    int closed;
+    uint64_t serial;
+    uint64_t slots[128];
+    struct spu_async_owner* next;
+} spu_async_owner;
+typedef struct {
+    spu_async_owner* owner;
+    uint32_t generation, slot;
+    uint64_t serial;
+} spu_async_ticket;
+static atomic_flag s_async_owner_lock = ATOMIC_FLAG_INIT;
+static spu_async_owner* s_async_owners;
+static void async_owner_lock(void) {
+    while (atomic_flag_test_and_set_explicit(&s_async_owner_lock, memory_order_acquire)) { }
+}
+static void async_owner_unlock(void) {
+    atomic_flag_clear_explicit(&s_async_owner_lock, memory_order_release);
+}
+static spu_async_owner* async_owner_find(uint32_t kind, uint32_t ea, uint32_t instance, int create) {
+    for (spu_async_owner* p=s_async_owners; p; p=p->next)
+        if (p->kind==kind && p->ea==ea && p->instance==instance) return p;
+    if (!create) return NULL;
+    spu_async_owner* p=(spu_async_owner*)calloc(1,sizeof(*p));
+    if (!p) return NULL;
+    p->kind=kind; p->ea=ea; p->instance=instance; p->generation=1;
+    p->next=s_async_owners; s_async_owners=p; return p;
+}
+/* A new guest lifetime may replace only a quiescent owner. No live worker can
+ * have its descriptor/bitsets overwritten by an address-reused owner. */
+static int async_owner_begin(uint32_t kind, uint32_t ea, uint32_t instance) {
+    if (!ea) return 0;
+    async_owner_lock();
+    spu_async_owner* p=async_owner_find(kind,ea,instance,1);
+    int ok=p && !p->active;
+    if (ok) { if (++p->generation==0) ++p->generation; p->closed=0; }
+    async_owner_unlock(); return ok;
+}
+static int async_owner_close(uint32_t kind, uint32_t ea, uint32_t instance) {
+    async_owner_lock();
+    spu_async_owner* p=async_owner_find(kind,ea,instance,0);
+    int ok=!p || !p->active;
+    if (ok && p) p->closed=1;
+    async_owner_unlock(); return ok;
+}
+/* 1=new claim, 0=already active, -1=closed/invalid/allocation failure. */
+static int async_owner_claim(uint32_t kind, uint32_t ea, uint32_t instance,
+                             uint32_t slot, spu_async_ticket* out) {
+    out->owner=NULL;
+    if (!ea || slot>=128) return -1;
+    async_owner_lock();
+    spu_async_owner* p=async_owner_find(kind,ea,instance,1);
+    int result=-1;
+    if (p && !p->closed) {
+        if (p->slots[slot]) result=0;
+        else { if (++p->serial==0) ++p->serial; p->slots[slot]=p->serial;
+               ++p->active; out->owner=p; out->serial=p->serial;
+               out->generation=p->generation; out->slot=slot; result=1; }
+    }
+    async_owner_unlock(); return result;
+}
+/* Ignore an already-released or stale-generation ticket. The production
+ * runner owns one ticket; this makes duplicate cleanup safe to detect. */
+static int async_owner_finish(spu_async_ticket* ticket) {
+    if (!ticket->owner) return 0;
+    async_owner_lock();
+    spu_async_owner* p=ticket->owner;
+    int released=p->generation==ticket->generation && p->slots[ticket->slot]==ticket->serial;
+    if (released) { p->slots[ticket->slot]=0; --p->active; }
+    ticket->owner=NULL;
+    async_owner_unlock(); return released;
+}
+static int async_owner_active(uint32_t kind, uint32_t ea, uint32_t instance, uint32_t slot) {
+    async_owner_lock();
+    spu_async_owner* p=async_owner_find(kind,ea,instance,0);
+    int active=p && slot<128 && p->slots[slot];
+    async_owner_unlock(); return active;
+}
+#endif
