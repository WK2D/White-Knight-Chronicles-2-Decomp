         /* Block key. Version 0/1 seeds from zero and uses a zero CBC IV;
@@ -643,10 +649,25 @@ const char* edat_resolve(const char* host_path, char* buf, size_t cap)
 
     if ((size_t)snprintf(buf, cap, "%s.dec", host_path) >= cap) return host_path;
 
+    /* Reject partial caches left by an interrupted process. */
+    uint8_t header[0x90];
+    FILE* source = fopen(host_path, "rb");
+    if (!source) return host_path;
+    size_t got = fread(header, 1, sizeof header, source);
+    fclose(source);
+    if (got != sizeof header) return host_path;
+    uint64_t expected_size = be64(header + 0x88);
     struct stat ss, ds;
-    if (stat(host_path, &ss) == 0 && stat(buf, &ds) == 0 && ds.st_mtime >= ss.st_mtime)
+    if (stat(host_path, &ss) == 0 && stat(buf, &ds) == 0 &&
+        ds.st_mtime >= ss.st_mtime && (uint64_t)ds.st_size == expected_size)
         return buf;                                    /* cache still valid */
 
-    if (edat_decrypt_file(host_path, buf) != 0) return host_path;
+    char partial[1400];
+    if ((size_t)snprintf(partial, sizeof partial, "%s.partial", buf) >= sizeof partial)
+        return host_path;
+    if (edat_decrypt_file(host_path, partial) != 0) return host_path;
+    /* Never publish a partial cache, even if the process is interrupted. */
+    remove(buf);
+    if (rename(partial, buf) != 0) return host_path;
     return buf;
 }
