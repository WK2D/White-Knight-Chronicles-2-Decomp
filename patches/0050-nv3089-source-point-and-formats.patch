 } s_nv3089;
 
+/* One axis of IMAGE_IN (12.4 fixed point) as 12.20, the format of DS_DX and
+ * DT_DY. A CENTER origin (IMAGE_IN_FORMAT bits 16-23 = 1) names pixel centres,
+ * so the first source pixel is floor(max(p, 0.5) - 0.5), as RPCS3's nv3089
+ * computes it. Shifting the point by 8 read it as 12.12: a start below 256
+ * pixels was lost and the copy began at the source origin. */
+static u64 nv3089_src_start(u32 point)
+{
+    u64 p = (u64)(point & 0xFFFFu) << 16;
+    if (((s_nv3089.in_fmt >> 16) & 0xFFu) == 1u)
+        p = p > 0x80000u ? p - 0x80000u : 0;
+    return p;
+}
