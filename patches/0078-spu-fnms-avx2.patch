diff --git a/runtime/spu/spu_fnms_avx2.h b/runtime/spu/spu_fnms_avx2.h
new file mode 100644
--- /dev/null
+++ b/runtime/spu/spu_fnms_avx2.h
@@ -0,0 +1,96 @@
+#ifndef PS3RECOMP_SPU_FNMS_AVX2_H
+#define PS3RECOMP_SPU_FNMS_AVX2_H
+#if defined(__AVX2__)
+/* SPU FNMS in four independent 64-bit lanes. Arithmetic, sticky alignment,
+ * flush-to-zero and saturation match spu_sf_fnms; exponent 255 remains finite.
+ * The exact double subtractions only locate integer leading bits and cannot
+ * change the result under host rounding, FTZ or DAZ settings. */
+#include <immintrin.h>
+
+static inline __m256i spu_fnms_vselect(__m256i no, __m256i yes, __m256i mask) {
+    return _mm256_blendv_epi8(no, yes, mask);
+}
+static inline __m256i spu_fnms_valign(__m256i value, __m256i shift) {
+    const __m256i zero = _mm256_setzero_si256();
+    const __m256i right = _mm256_srlv_epi64(value, shift);
+    const __m256i left = _mm256_sllv_epi64(value, _mm256_sub_epi64(zero, shift));
+    const __m256i lost = _mm256_andnot_si256(
+        _mm256_cmpeq_epi64(value, _mm256_sllv_epi64(right, shift)),
+        _mm256_cmpgt_epi64(shift, zero));
+    return _mm256_or_si256(_mm256_or_si256(left, right),
+                          _mm256_and_si256(lost, _mm256_set1_epi64x(1)));
+}
+static inline __m256i spu_fnms_vmsb(__m256i value) {
+    /* Every payload is an unsigned 32-bit integer. Both subtractions are
+     * exact under every rounding mode; the double exponent gives floor(log2).
+     * Zero is arbitrary here and is masked from the final instruction result. */
+    const __m256i magic = _mm256_set1_epi64x(0x4330000000000000LL);
+    const __m256d bias = _mm256_castsi256_pd(magic);
+    const __m256i high = _mm256_srli_epi64(value, 32);
+    const __m256i low = _mm256_and_si256(value, _mm256_set1_epi64x(0xffffffffLL));
+    const __m256i hi_double = _mm256_castpd_si256(
+        _mm256_sub_pd(_mm256_castsi256_pd(_mm256_or_si256(magic, high)), bias));
+    const __m256i lo_double = _mm256_castpd_si256(
+        _mm256_sub_pd(_mm256_castsi256_pd(_mm256_or_si256(magic, low)), bias));
+    const __m256i ht = _mm256_sub_epi64(_mm256_srli_epi64(hi_double, 52), _mm256_set1_epi64x(1023-32));
+    const __m256i lt = _mm256_sub_epi64(_mm256_srli_epi64(lo_double, 52), _mm256_set1_epi64x(1023));
+    return spu_fnms_vselect(ht, lt, _mm256_cmpeq_epi64(high, _mm256_setzero_si256()));
+}
+static inline u128 spu_fnms_avx2(u128 a, u128 b, u128 c) {
+    const __m256i zero = _mm256_setzero_si256();
+    const __m256i one = _mm256_set1_epi64x(1);
+    const __m256i mask23 = _mm256_set1_epi64x(0x7fffff);
+    const __m256i hidden = _mm256_set1_epi64x(0x800000);
+    const __m256i signbit = _mm256_set1_epi64x(0x80000000LL);
+    __m128i av, bv, cv;
+    memcpy(&av,&a,16); memcpy(&bv,&b,16); memcpy(&cv,&c,16);
+    const __m256i A = _mm256_cvtepu32_epi64(av);
+    const __m256i B = _mm256_cvtepu32_epi64(bv);
+    const __m256i C = _mm256_cvtepu32_epi64(cv);
+    const __m256i ea = _mm256_and_si256(_mm256_srli_epi64(A,23),_mm256_set1_epi64x(255));
+    const __m256i eb = _mm256_and_si256(_mm256_srli_epi64(B,23),_mm256_set1_epi64x(255));
+    const __m256i ec = _mm256_and_si256(_mm256_srli_epi64(C,23),_mm256_set1_epi64x(255));
+    const __m256i product = _mm256_mul_epu32(
+        _mm256_or_si256(_mm256_and_si256(A,mask23),hidden),
+        _mm256_or_si256(_mm256_and_si256(B,mask23),hidden));
+    const __m256i addend = _mm256_andnot_si256(_mm256_cmpeq_epi64(ec,zero),
+        _mm256_or_si256(_mm256_and_si256(C,mask23),hidden));
+    const __m256i pe = _mm256_sub_epi64(_mm256_add_epi64(ea,eb),_mm256_set1_epi64x(300));
+    const __m256i ce = _mm256_sub_epi64(ec,_mm256_set1_epi64x(150));
+    const __m256i pt = _mm256_add_epi64(pe,
+        _mm256_add_epi64(_mm256_set1_epi64x(46),_mm256_srli_epi64(product,47)));
+    const __m256i ct = spu_fnms_vselect(_mm256_add_epi64(ce,_mm256_set1_epi64x(23)),pt,
+                                _mm256_cmpeq_epi64(addend,zero));
+    const __m256i unit = _mm256_sub_epi64(spu_fnms_vselect(ct,pt,_mm256_cmpgt_epi64(pt,ct)),
+                                         _mm256_set1_epi64x(61));
+    const __m256i p = spu_fnms_valign(product,_mm256_sub_epi64(unit,pe));
+    const __m256i q = spu_fnms_valign(addend,_mm256_sub_epi64(unit,ce));
+    const __m256i ps = _mm256_and_si256(_mm256_xor_si256(_mm256_xor_si256(A,B),signbit),signbit);
+    const __m256i cs = _mm256_and_si256(C,signbit);
+    const __m256i same = _mm256_cmpeq_epi64(ps,cs);
+    const __m256i qgt = _mm256_cmpgt_epi64(q,p);
+    const __m256i difference = _mm256_sub_epi64(p,q);
+    const __m256i magnitude = spu_fnms_vselect(
+        spu_fnms_vselect(difference,_mm256_sub_epi64(zero,difference),qgt),
+        _mm256_add_epi64(p,q),same);
+    const __m256i sign = spu_fnms_vselect(ps,cs,_mm256_andnot_si256(same,qgt));
+    const __m256i top = spu_fnms_vmsb(magnitude);
+    const __m256i exponent = _mm256_add_epi64(_mm256_add_epi64(unit,top),_mm256_set1_epi64x(127));
+    const __m256i shift = _mm256_sub_epi64(top,_mm256_set1_epi64x(23));
+    const __m256i sig = _mm256_or_si256(_mm256_srlv_epi64(magnitude,shift),
+        _mm256_sllv_epi64(magnitude,_mm256_sub_epi64(zero,shift)));
+    __m256i result = _mm256_or_si256(sign,_mm256_or_si256(
+        _mm256_slli_epi64(exponent,23),_mm256_and_si256(sig,mask23)));
+    result = spu_fnms_vselect(result,_mm256_or_si256(sign,_mm256_set1_epi64x(0x7fffffff)),
+                        _mm256_cmpgt_epi64(exponent,_mm256_set1_epi64x(255)));
+    result = _mm256_andnot_si256(_mm256_or_si256(_mm256_cmpeq_epi64(magnitude,zero),
+                                   _mm256_cmpgt_epi64(one,exponent)),result);
+    const __m256i product_zero = _mm256_or_si256(_mm256_cmpeq_epi64(ea,zero),_mm256_cmpeq_epi64(eb,zero));
+    result = spu_fnms_vselect(result,_mm256_andnot_si256(_mm256_cmpeq_epi64(ec,zero),C),product_zero);
+    const __m256i packed = _mm256_permutevar8x32_epi32(result,_mm256_setr_epi32(0,2,4,6,0,0,0,0));
+    const __m128i words = _mm256_castsi256_si128(packed);
+    u128 r; memcpy(&r,&words,16); return r;
+}
+
+#endif /* __AVX2__ */
+#endif
