diff --git a/runtime/spu/spurs_job.c b/runtime/spu/spurs_job.c
--- a/runtime/spu/spurs_job.c
+++ b/runtime/spu/spurs_job.c
@@ -42,6 +42,8 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <stddef.h>
+#include <malloc.h>
 
 /* Optional host observer: const context, before and after the same job.
  * The observer owns its storage and must not change guest execution state. */
@@ -158,6 +160,63 @@
  * The chain walker must not enqueue an additional synthetic completion. */
 SPURS_JOB_TLS int g_spurs_job_running, g_spurs_job_user_events;
 
+/* One job context per host thread, reused. On hardware jm2 does not clear
+ * local store between jobs at all: a job's binary and bss arrive by DMA and its
+ * buffers hold whatever the previous job left. We keep the old zero-filled
+ * behaviour, but zero only what can be dirty -- [binary end, highest region end
+ * of any earlier job on this thread) plus the context/descriptor block at the
+ * top -- instead of all 256 KB. SPURS_JOB_ZERO_LS=1 restores a full clear.
+ * A job dispatched while another runs on the same thread gets a fresh
+ * context, as before. */
+static SPURS_JOB_TLS spu_context* t_job_ctx;
+static SPURS_JOB_TLS int          t_job_ctx_busy;
+static SPURS_JOB_TLS uint32_t     t_job_dirty_hi;
+static SPURS_JOB_TLS int          t_job_ctx_fresh;
+
+static spu_context* job_ctx_acquire(void)
+{
+    spu_context* c;
+    if (t_job_ctx_busy || !t_job_ctx) {
+        c = (spu_context*)_aligned_malloc(sizeof(spu_context), 64);
+        if (!c) return NULL;
+        spu_context_init(c, 0);
+        if (!t_job_ctx_busy && !t_job_ctx) { t_job_ctx = c; t_job_dirty_hi = 0; }
+        t_job_ctx_fresh = (c != t_job_ctx);
+        if (c == t_job_ctx) t_job_ctx_busy = 1;
+        return c;
+    }
+    c = t_job_ctx;
+    t_job_ctx_busy = 1;
+    t_job_ctx_fresh = 0;
+    /* Everything but the local store, as spu_context_init leaves it. */
+    const size_t lo = offsetof(spu_context, ls_store);
+    const size_t hi = lo + sizeof(c->ls_store);
+    memset(c, 0, lo);
+    memset((uint8_t*)c + hi, 0, sizeof(spu_context) - hi);
+    c->ls     = c->ls_store;
+    c->spu_id = 0;
+    c->status = SPU_STATUS_STOPPED;
+    return c;
+}
+
+static void job_ls_clear(uint8_t* ls, uint32_t size_bin)
+{
+    static int s_full = -1;
+    if (s_full < 0) s_full = getenv("SPURS_JOB_ZERO_LS") ? 1 : 0;
+    if (t_job_ctx_fresh) return;                 /* zero from spu_context_init */
+    if (s_full) { memset(ls + size_bin, 0, SPU_LS_SIZE - size_bin); return; }
+    const uint32_t top = SPU_LS_SIZE - 0x440;   /* context, descriptor, return */
+    if (t_job_dirty_hi > size_bin)
+        memset(ls + size_bin, 0, (t_job_dirty_hi < top ? t_job_dirty_hi : top) - size_bin);
+    memset(ls + top, 0, SPU_LS_SIZE - top);
+}
+
+static void job_ctx_release(spu_context* c)
+{
+    if (c == t_job_ctx) { t_job_ctx_busy = 0; return; }
+    _aligned_free(c);
+}
+
 int spu_run_spurs_job(spu_lifted_entry_fn entry, int image_id,
                       uint32_t job_ea, uint32_t job_desc_size)
 {
@@ -182,15 +241,18 @@
         return -1;
     }
 
