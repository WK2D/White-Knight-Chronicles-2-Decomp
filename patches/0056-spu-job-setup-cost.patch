+/* Whether this step needs spu_task_launch_check. The check acts only on a
+ * branch to LS 0 (a finished job), a registered stack-reset entry, a SPURS
+ * policy context or a step-level diagnostic; for every other step it is
+ * bookkeeping, and calling it on each trampoline hop cost an Edge job chain
+ * a seventh of its time. A skipped step is still counted in `steps`, which
+ * the LS-0 test reads to tell a job's entry from its exit.
+ * g_spu_launch_check_all starts at -1 so the first step takes the full
+ * check, which reads the diagnostic switches and settles it at 0 or 1. */
+extern int g_spu_launch_check_all;
+extern unsigned g_spu_stack_reset_count;
+extern void* volatile g_pm_flow_ctx;
+static inline int spu_launch_check_due(spu_context* ctx)
+{
+    if (g_spu_launch_check_all || ctx->policy_mode ||
+        (ctx->pc & SPU_LS_MASK) == 0 ||
+        (g_spu_stack_reset_count && ctx->host_depth) ||
+        g_pm_flow_ctx == (void*)ctx)
+        return 1;
+    ctx->steps++;
+    return 0;
+}
