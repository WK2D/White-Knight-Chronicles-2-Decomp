diff --git a/runtime/spu/spu_context.h b/runtime/spu/spu_context.h
--- a/runtime/spu/spu_context.h
+++ b/runtime/spu/spu_context.h
@@ -19,6 +19,22 @@
 #ifdef __cplusplus
 extern "C" {
 #endif
+
+/* Legacy CRI behavior belongs to a title's selected image, not an ordinal
+ * shared by all games. SPU_CRI_IMAGE=-1 disables it; 22 preserves SDK defaults.
+ * Selection adapted from soyjxck/ps3recomp de08397c0a485cd7705c049ca7532dd90fadc704
+ * (MIT), as used by dod3-recomp. Configure before any SPU threads start.
+ * Cache per host thread so first use in concurrent jobs cannot race. */
+static inline int spu_cri_image(void)
+{
+#if defined(_MSC_VER)
+    static __declspec(thread) int v = -2;
+#else
+    static __thread int v = -2;
+#endif
+    if (v == -2) { const char* e = getenv("SPU_CRI_IMAGE"); v = e ? atoi(e) : 22; }
+    return v;
+}
 
 /* Portable 16-byte alignment (MSVC __declspec vs GCC/clang __attribute__). */
 #if defined(_MSC_VER)
