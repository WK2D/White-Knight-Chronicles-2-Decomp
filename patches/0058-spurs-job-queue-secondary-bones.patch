+static s32 jq_abi_attr_reset(u64 attr_ea)
+{
+    if (!jq_abi_range(attr_ea, sizeof(CellSpursJobQueueAttribute), 8))
+        return (s32)CELL_SPURS_JOB_ERROR_INVAL;
+    jq_abi_lock();
+    JqAbiAttribute* a=jq_abi_attr((u32)attr_ea);
+    if (!a) for (u32 i=0; i<JQ_ABI_MAX_ATTRIBUTES; ++i)
+        if (!s_abi_attrs[i].ea) { a=&s_abi_attrs[i]; break; }
+    if (a) { a->ea=(u32)attr_ea; a->max_descriptor=256; a->halt_on_error=1; }
+    jq_abi_unlock();
+    return a ? CELL_OK : (s32)CELL_SPURS_JOB_ERROR_NOMEM;
+}
+s32 cellSpursJobQueueAttributeSetMaxSizeJobDescriptor(u64 attr_ea, u32 size)
+{
+    if (attr_ea > UINT32_MAX || !jq_abi_descriptor_size(size))
+        return (s32)CELL_SPURS_JOB_ERROR_INVAL;
+    jq_abi_lock();
+    JqAbiAttribute* a=jq_abi_attr((u32)attr_ea);
+    if (a) a->max_descriptor=size;
+    jq_abi_unlock();
+    return a ? CELL_OK : (s32)CELL_SPURS_JOB_ERROR_STAT;
+}
+s32 cellSpursJobQueueAttributeSetGrabParameters(u64 attr_ea, u32 maxGrab, u32 maxJob)
+{
+    if (attr_ea > UINT32_MAX || !maxGrab || !maxJob)
+        return (s32)CELL_SPURS_JOB_ERROR_INVAL;
+    jq_abi_lock(); JqAbiAttribute* a=jq_abi_attr((u32)attr_ea); jq_abi_unlock();
+    return a ? CELL_OK : (s32)CELL_SPURS_JOB_ERROR_STAT;
+}
+static s32 jq_abi_attr_flag(u64 attr_ea, u32 enabled, int halt)
+{
+    if (attr_ea > UINT32_MAX || enabled > 1)
+        return (s32)CELL_SPURS_JOB_ERROR_INVAL;
+    jq_abi_lock(); JqAbiAttribute* a=jq_abi_attr((u32)attr_ea);
+    if (a && halt) a->halt_on_error=enabled;
+    jq_abi_unlock();
+    return a ? CELL_OK : (s32)CELL_SPURS_JOB_ERROR_STAT;
+}
+s32 cellSpursJobQueueAttributeSetSubmitWithEntryLock(u64 ea,u32 v) { return jq_abi_attr_flag(ea,v,0); }
+s32 cellSpursJobQueueAttributeSetDoBusyWaiting(u64 ea,u32 v) { return jq_abi_attr_flag(ea,v,0); }
+s32 cellSpursJobQueueAttributeSetIsHaltOnError(u64 ea,u32 v) { return jq_abi_attr_flag(ea,v,1); }
+s32 cellSpursJobQueueAttributeSetIsJobTypeMemoryCheck(u64 ea,u32 v) { return jq_abi_attr_flag(ea,v,0); }
+
+s32 _cellSpursCreateJobQueue(u32 jmRevision, u32 sdkRevision, u64 spurs_ea,
+                    u64 queue_ea, u64 attr_ea, u64 name_ea, u64 buffer_ea, u32 depth)
+{
+    (void)sdkRevision; (void)name_ea;
+    if (jmRevision != 2 || !jq_abi_range(spurs_ea,128,128) ||
+        !jq_abi_range(queue_ea,128,128) || attr_ea > UINT32_MAX ||
+        !depth || depth > 65536 || !jq_abi_range(buffer_ea,(u64)depth*8,128))
+        return (s32)CELL_SPURS_JOB_ERROR_INVAL;
+    jq_abi_lock();
+    JqAbiAttribute* a=jq_abi_attr((u32)attr_ea);
+    JqAbiQueue* q=jq_abi_queue((u32)queue_ea);
+    if (!a || q) { jq_abi_unlock(); return (s32)(q ? CELL_SPURS_JOB_ERROR_STAT : CELL_SPURS_JOB_ERROR_STAT); }
+    for (u32 i=0; i<CELL_SPURS_JQ_MAX_QUEUES; ++i)
+        if (!s_abi_queues[i].ea) { q=&s_abi_queues[i]; break; }
+    if (q) {
+        q->ea=(u32)queue_ea; q->max_descriptor=a->max_descriptor;
+        q->halt_on_error=a->halt_on_error; q->shutdown=0; q->error=0; q->cause=0;
+        atomic_flag_clear_explicit(&q->busy,memory_order_relaxed);
+    }
+    jq_abi_unlock();
+    if (q) fprintf(stderr,"[cellSpursJq] create queue=0x%08X maxDescriptor=%u\n",(u32)queue_ea,q->max_descriptor);
+    return q ? CELL_OK : (s32)CELL_SPURS_JOB_ERROR_NOMEM;
+}
+s32 cellSpursJobQueuePortInitializeWithDescriptorBuffer(u64 port_ea, u64 queue_ea,
+                              u64 buffer_ea, u32 size, u32 count, u32 thread_safe)
+{
+    if (!jq_abi_range(port_ea,128,128) || queue_ea > UINT32_MAX ||
+        !jq_abi_descriptor_size(size) || !count || count > 65536 || thread_safe > 1 ||
+        !jq_abi_range(buffer_ea,(u64)size*count,128))
+        return (s32)CELL_SPURS_JOB_ERROR_INVAL;
+    jq_abi_lock();
+    JqAbiQueue* q=jq_abi_queue((u32)queue_ea);
+    JqAbiPort* p=jq_abi_port((u32)port_ea);
+    if (!q || q->shutdown || size > q->max_descriptor || p) {
+        jq_abi_unlock(); return (s32)(p ? CELL_SPURS_JOB_ERROR_STAT : CELL_SPURS_JOB_ERROR_INVAL);
+    }
+    for (u32 i=0; i<JQ_ABI_MAX_PORTS; ++i)
+        if (!s_abi_ports[i].ea) { p=&s_abi_ports[i]; break; }
+    if (p) { p->ea=(u32)port_ea; p->queue_ea=(u32)queue_ea; p->buffer_ea=(u32)buffer_ea;
+             p->descriptor_size=size; p->count=count; p->next=0; }
+    jq_abi_unlock();
+    return p ? CELL_OK : (s32)CELL_SPURS_JOB_ERROR_NOMEM;
+}
+/* Return with registry and per-queue execution locks held. Nothing can retire
+ * or reconfigure the selected queue/port before the caller drops both. */
+static JqAbiQueue* jq_abi_acquire(u64 ea, int is_port, int blocking, JqAbiPort** port)
+{
+    if (!ea || ea > UINT32_MAX) return NULL;
+    for (;;) {
+        jq_abi_lock();
+        JqAbiPort* p=is_port ? jq_abi_port((u32)ea) : NULL;
+        JqAbiQueue* q=(!is_port || p) ? jq_abi_queue(is_port ? p->queue_ea : (u32)ea) : NULL;
+        if (!q) { jq_abi_unlock(); return NULL; }
+        if (!atomic_flag_test_and_set_explicit(&q->busy,memory_order_acquire)) {
+            if (port) *port=p;
+            return q;
+        }
+        jq_abi_unlock();
+        if (!blocking) return NULL;
+        jq_abi_yield();
+    }
+}
+static void jq_abi_release(JqAbiQueue* q)
+{
+    atomic_flag_clear_explicit(&q->busy,memory_order_release);
+}
+extern int spu_workload_dispatch_job(const uint8_t*,uint32_t,uint32_t,uint32_t);
+s32 _cellSpursJobQueuePortCopyPushBody(u64 port_ea, u64 descriptor_ea,
+                                      u32 size, u32 flag0, u32 flag1)
+{
+    if (!jq_abi_descriptor_size(size) || !jq_abi_range(descriptor_ea,size,16) ||
+        flag0 > 1 || flag1 > 1)
+        return (s32)CELL_SPURS_JOB_ERROR_INVAL;
+    /* Both observed flags are booleans, never guest output pointers. Their
+     * asynchronous scheduling variants are not inferred here: this path runs
+     * each copied descriptor to completion in submission order. */
+    JqAbiPort* p=NULL;
+    JqAbiQueue* q=jq_abi_acquire(port_ea,1,1,&p);
+    if (!q) return (s32)CELL_SPURS_JOB_ERROR_STAT;
+    if (q->shutdown || (q->error && q->halt_on_error) || size > p->descriptor_size) {
+        s32 rc=q->error ? q->error : (s32)CELL_SPURS_JOB_ERROR_INVAL;
+        jq_abi_unlock(); jq_abi_release(q); return rc;
+    }
+    const u32 owned=p->buffer_ea+p->next*p->descriptor_size;
+    p->next=(p->next+1)%p->count;
+    jq_abi_unlock();
+    memmove(vm_base+owned,vm_base+(u32)descriptor_ea,size);
+    /* CellSpursJobHeader: binaryEA BE64+0, sizeBinary BE16+8 (16B units).
+     * Only bit0 is the documented CACHE_INHIBIT flag in the staging path. */
+    u64 binary=vm_read64(owned)&~UINT64_C(1);
+    u32 binary_size=(u32)vm_read16(owned+8)<<4;
+    int dispatched=0;
+    if (binary_size && binary_size <= 0x40000 && jq_abi_range(binary,binary_size,16))
+        dispatched=spu_workload_dispatch_job(vm_base+(u32)binary,binary_size,owned,size);
+    if (dispatched <= 0) {
+        q->error=(s32)CELL_SPURS_JOB_ERROR_ABORT; q->cause=owned;
+        fprintf(stderr,"[cellSpursJq] job failed queue=0x%08X descriptor=0x%08X dispatch=%d\n",q->ea,owned,dispatched);
+    }
+    const s32 result=dispatched > 0 ? CELL_OK : q->error;
+    jq_abi_release(q); return result;
+}
+s32 cellSpursJobQueuePortSync(u64 port_ea)
+{
+    JqAbiQueue* q=jq_abi_acquire(port_ea,1,1,NULL);
+    if (!q) return (s32)CELL_SPURS_JOB_ERROR_STAT;
+    s32 result=q->error; jq_abi_unlock(); jq_abi_release(q); return result;
+}
+s32 cellSpursJobQueuePortFinalize(u64 port_ea)
+{
+    JqAbiPort* p=NULL; JqAbiQueue* q=jq_abi_acquire(port_ea,1,1,&p);
+    if (!q) return (s32)CELL_SPURS_JOB_ERROR_STAT;
+    p->ea=0; s32 result=q->error; jq_abi_unlock(); jq_abi_release(q); return result;
+}
+s32 cellSpursJobQueueGetError(u64 queue_ea, u64 error_out_ea, u64 cause_out_ea)
+{
+    if (!jq_abi_range(error_out_ea,4,4) || !jq_abi_range(cause_out_ea,4,4))
+        return (s32)CELL_SPURS_JOB_ERROR_INVAL;
+    JqAbiQueue* q=jq_abi_acquire(queue_ea,0,1,NULL);
+    if (!q) return (s32)CELL_SPURS_JOB_ERROR_STAT;
+    vm_write32((u32)error_out_ea,(u32)q->error);
+    vm_write32((u32)cause_out_ea,q->cause);
+    jq_abi_unlock(); jq_abi_release(q); return CELL_OK;
+}
+s32 cellSpursShutdownJobQueue(u64 queue_ea)
+{
+    JqAbiQueue* q=jq_abi_acquire(queue_ea,0,1,NULL);
+    if (!q) return (s32)CELL_SPURS_JOB_ERROR_STAT;
+    q->shutdown=1; jq_abi_unlock(); jq_abi_release(q); return CELL_OK;
+}
+s32 cellSpursJoinJobQueue(u64 queue_ea, u64 exit_code_out_ea)
+{
+    if (!jq_abi_range(exit_code_out_ea,4,4)) return (s32)CELL_SPURS_JOB_ERROR_INVAL;
+    JqAbiQueue* q=jq_abi_acquire(queue_ea,0,1,NULL);
+    if (!q) return (s32)CELL_SPURS_JOB_ERROR_STAT;
+    if (!q->shutdown) { jq_abi_unlock(); jq_abi_release(q); return (s32)CELL_SPURS_JOB_ERROR_BUSY; }
+    vm_write32((u32)exit_code_out_ea,(u32)q->error);
+    for (u32 i=0; i<JQ_ABI_MAX_PORTS; ++i)
+        if (s_abi_ports[i].queue_ea == (u32)queue_ea) s_abi_ports[i].ea=0;
+    q->ea=0; jq_abi_release(q); jq_abi_unlock(); return CELL_OK;
+}
