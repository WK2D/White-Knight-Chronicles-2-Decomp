+static JqAbiAttribute* jq_abi_attr(u32 ea)
+{
+    if (!ea) return NULL;
+    for (u32 i=0; i<JQ_ABI_MAX_ATTRIBUTES; ++i)
+        if (s_abi_attrs[i].ea == ea) return &s_abi_attrs[i];
+    return NULL;
+}
+static JqAbiQueue* jq_abi_queue(u32 ea)
