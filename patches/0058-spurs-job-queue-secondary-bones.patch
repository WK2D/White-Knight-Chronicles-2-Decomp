+    return NULL;
+}
+static JqAbiPort* jq_abi_port(u32 ea)
+{
+    if (!ea) return NULL;
+    for (u32 i=0; i<JQ_ABI_MAX_PORTS; ++i)
+        if (s_abi_ports[i].ea == ea) return &s_abi_ports[i];
+    return NULL;
