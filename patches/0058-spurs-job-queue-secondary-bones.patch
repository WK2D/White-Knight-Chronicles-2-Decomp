+ * Execution is synchronous and serialized per queue; Sync therefore observes
+ * all earlier output writes. No queue is declared complete on a missing image
+ * or failed staging. Different queues can execute on different threads. */
+#define JQ_ABI_MAX_PORTS 64
+#define JQ_ABI_MAX_ATTRIBUTES 32
+
+typedef struct {
+    u32 ea, max_descriptor;
+    u32 halt_on_error;
+} JqAbiAttribute;
+typedef struct {
+    u32 ea, max_descriptor, halt_on_error;
+    u32 shutdown, cause;
+    s32 error;
+    atomic_flag busy;
+} JqAbiQueue;
+typedef struct {
+    u32 ea, queue_ea, buffer_ea, descriptor_size, count, next;
+} JqAbiPort;
+static JqAbiAttribute s_abi_attrs[JQ_ABI_MAX_ATTRIBUTES];
+static JqAbiQueue s_abi_queues[CELL_SPURS_JQ_MAX_QUEUES];
+static JqAbiPort s_abi_ports[JQ_ABI_MAX_PORTS];
+static atomic_flag s_abi_lock = ATOMIC_FLAG_INIT;
+
+static void jq_abi_yield(void)
+{
+#ifdef _WIN32
+    SwitchToThread();
+#else
+    sched_yield();
+#endif
+}
+static void jq_abi_lock(void)
+{
+    while (atomic_flag_test_and_set_explicit(&s_abi_lock, memory_order_acquire))
+        jq_abi_yield();
+}
+static void jq_abi_unlock(void)
+{
+    atomic_flag_clear_explicit(&s_abi_lock, memory_order_release);
+}
+static int jq_abi_range(u64 ea, u64 size, u32 alignment)
+{
+    return ea && ea <= UINT32_MAX && !(ea & (alignment - 1u)) &&
+           size && size <= UINT64_C(0x100000000) - ea;
