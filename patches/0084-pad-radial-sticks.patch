diff --git a/libs/input/pad_stick.h b/libs/input/pad_stick.h
new file mode 100644
--- /dev/null
+++ b/libs/input/pad_stick.h
@@ -0,0 +1,35 @@
+/* Host stick conversion, project-written radial response.
+ * Preserve direction and magnitude before quantizing to PS3's unsigned axes. */
+#ifndef PS3RECOMP_PAD_STICK_H
+#define PS3RECOMP_PAD_STICK_H
+#include <math.h>
+#include <stdint.h>
+static inline uint8_t pad_stick_encode(float axis)
+{
+    if (axis <= -1.0f) return 0;
+    if (axis >= 1.0f) return 255;
+    return (uint8_t)lroundf(128.0f + axis * (axis < 0.0f ? 128.0f : 127.0f));
+}
+static inline void pad_stick_radial(int16_t raw_x, int16_t raw_y, unsigned deadzone,
+                                   uint8_t* out_x, uint8_t* out_y)
+{
+    float x = raw_x / (raw_x < 0 ? 32768.0f : 32767.0f);
+    float y = raw_y / (raw_y < 0 ? 32768.0f : 32767.0f);
+    const float radius = sqrtf(x*x + y*y);
+    const float dz = deadzone / 32767.0f;
+    float scale = 0.0f;
+    /* Small host-noise gate, then a continuous response through the usual
+     * XInput deadzone landmark. PS3 games retain their own walking threshold. */
+    const float noise = 0.03f;
+    if (radius > noise && dz > noise && dz < 1.0f) {
+        const float bounded = radius < 1.0f ? radius : 1.0f;
+        const float magnitude = bounded <= dz
+            ? 0.13f * (bounded-noise)/(dz-noise)
+            : 0.13f + 0.87f * (bounded-dz)/(1.0f-dz);
+        scale = magnitude/radius;
+    }
+    *out_x = pad_stick_encode(x*scale);
+    /* Invert before quantization: never wrap a full-range endpoint at 256. */
+    *out_y = pad_stick_encode(-y*scale);
+}
+#endif
