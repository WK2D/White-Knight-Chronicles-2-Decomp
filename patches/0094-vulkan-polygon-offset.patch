 /* ---- 1. the surface set -------------------------------------------------- */
 
+static void test_polygon_offset(void)
+{
+    printf("-- dynamic fill polygon offset\n");
+    engine_up();
+    draw_triangle();
+    CHECK(stub.offset_calls == 1 && stub.offset_scale == 0 && stub.offset_bias == 0,
+          "never-written polygon offset is zero");
+    const int pipelines = stub.n_pipeline_create;
+    m(0x0A78, 0xC0800000u); /* -4.0 */
+    m(0x0A7C, 0xC2C80000u); /* -100.0 */
+    draw_triangle();
+    CHECK(stub.offset_scale == 0 && stub.offset_bias == 0,
+          "disabled offset ignores stale nonzero factors");
+    m(0x0A68, 1);
+    draw_triangle();
+    CHECK(stub.offset_scale == -4 && stub.offset_bias == -100,
+          "enabled fill offset reaches backend with float sign/units intact");
+    m(0x0A7C, 0x42C80000u); /* +100 */
+    draw_triangle();
+    CHECK(stub.offset_scale == -4 && stub.offset_bias == 100,
+          "factor changes reach the very next draw");
+    m(M_BEGIN_END, RSX_PRIMITIVE_LINES);
+    m(M_DRAW_ARRAYS, 1u << 24);
+    m(M_BEGIN_END, 0);
+    CHECK(stub.offset_scale == 0 && stub.offset_bias == 0,
+          "fill offset cannot leak into a line draw");
+    draw_triangle();
+    CHECK(stub.offset_scale == -4 && stub.offset_bias == 100,
+          "returning to triangles restores requested factors");
+    m(0x0A68, 0);
+    draw_triangle();
+    CHECK(stub.offset_scale == 0 && stub.offset_bias == 0,
+          "disabling offset resets the next draw");
+    CHECK(stub.n_pipeline_create == pipelines,
+          "dynamic offset changes do not compile extra pipeline objects");
+    engine_down();
+    /* The callback is optional for backends which have not implemented it. */
+    rsx_draw_backend previous = g_stub_backend;
+    previous.set_polygon_offset = NULL;
+    memset(&stub, 0, sizeof stub);
+    rsx_draw_engine_set_backend(&previous);
+    CHECK(rsx_draw_engine_init(1280,720) == 0, "old backend still initializes");
+    engine_down();
+}
