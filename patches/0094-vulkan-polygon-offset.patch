diff --git a/libs/video/rsx_vk_depth_bias.h b/libs/video/rsx_vk_depth_bias.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_vk_depth_bias.h
@@ -0,0 +1,29 @@
+/* Vulkan fill-polygon offset. Core 1.0 dynamic state, no optional features.
+ * RSX scale/bias are floats. D32 uses the host float-depth bias rule.
+ * NVIDIA D24 needs half the constant factor (RPCS3 VKDraw.cpp hardware
+ * observation); keep this adjustment specific to fixed D24 on that vendor.
+ * Other formats/vendors require their own hardware parity validation. */
+#ifndef PS3RECOMP_RSX_VK_DEPTH_BIAS_H
+#define PS3RECOMP_RSX_VK_DEPTH_BIAS_H
+#include <vulkan/vulkan.h>
+#include "rsx_primitives.h"
+
+static inline void rsx_vk_depth_bias_pipeline(
+    VkPipelineRasterizationStateCreateInfo* raster, rsx_topology topology)
+{
+    /* Filled triangle topologies include expanded quads/fans/polygons.
+     * Zero dynamic factors disable the offset without creating pipelines. */
+    raster->depthBiasEnable = topology >= RSX_TOPOLOGY_TRIANGLES &&
+                              topology <= RSX_TOPOLOGY_TRIANGLE_STRIP;
+}
+
+static inline void rsx_vk_depth_bias_command(PFN_vkCmdSetDepthBias command,
+    VkCommandBuffer cmd, VkFormat format, uint32_t vendor,
+    float scale, float bias)
+{
+    if (vendor == 0x10DEu && (format == VK_FORMAT_D24_UNORM_S8_UINT ||
+                             format == VK_FORMAT_X8_D24_UNORM_PACK32))
+        bias *= 0.5f;
+    command(cmd, bias, 0.0f, scale);
+}
+#endif
