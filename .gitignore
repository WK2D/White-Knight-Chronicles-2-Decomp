!/vdec.cpp
!/patches/
!/tests/
!/tools/
!/docs/
!/verification/
/patches/*
!/patches/*.patch
/tests/*
!/tests/*.cpp
!/tests/*.c
/tools/*
!/tools/*.py
!/tools/*.ps1
!/tools/*.java
