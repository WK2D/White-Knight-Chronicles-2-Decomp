# Publish an explicit source-only set. Local artifacts remain untracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/LICENSE.ps3recomp
!/CMakeLists.txt
!/project.json
!/decompression-verification.json
!/main.cpp
!/stubs.cpp
!/thread_diagnostics.cpp
!/windows_guids.c
!/lwcond.cpp
!/lfqueue.cpp
!/patches/
!/tests/
!/tools/
!/docs/
!/verification/
/patches/*
!/patches/*.patch
/tests/*
!/tests/*.cpp
!/tests/*.c
/tools/*
!/tools/*.py
!/tools/*.ps1
!/tools/*.java
/docs/*
!/docs/*.md
/verification/*
!/verification/rendering.json
!/verification/gallery.json
!/verification/installation.json
!/verification/screenshots/
/verification/screenshots/*
!/verification/screenshots/*.png
**/__pycache__/
*.pyc
